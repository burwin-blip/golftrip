---
// Hole-by-hole NET scorecard for one match, plus the original card image.
// All numbers come from stats.matchScorecard() — computed from hole_scores.json,
// never hardcoded. Renders nothing if the match has no hole data.
import { matchScorecard, HOLE_STATS_COVERAGE } from '../lib/stats.js';
import { teamById, roundById } from '../lib/data.js';
import images from '../../data/scorecard_images.json';
import TeamLogo from './TeamLogo.astro';

const { match } = Astro.props;
const sc = matchScorecard(match.id);
const img = images[match.id] || null;
const round = roundById[match.roundId];

// Column groups: split at the turn for 18-hole rounds.
const holes = sc ? sc.meta.map((m) => m.hole) : [];
const is18 = holes.length > 9;
const front = sc ? sc.meta.filter((m) => m.hole <= 9) : [];
const back = sc ? sc.meta.filter((m) => m.hole > 9) : [];

const sumCells = (cells, pred) =>
  cells.filter(pred).reduce((s, c) => s + (c.net ?? c.points ?? 0), 0);

// Per-player nine/total tallies for the summary columns.
function tallies(p) {
  const out = sumCells(p.cells, (c) => c.hole <= 9 && !c.empty && !c.conceded);
  const inn = sumCells(p.cells, (c) => c.hole > 9 && !c.empty && !c.conceded);
  return { out, inn, tot: p.total };
}

// Traditional scorecard notation, keyed off the net result vs par (team gross vs
// par for the scramble): birdie = circle, eagle+ = double circle, bogey = square,
// double+ = double square, par = plain. Conceded holes show the concede marker.
const MARK = { eagle: 'scv m-eagle', birdie: 'scv m-birdie', par: 'scv m-par', bogey: 'scv m-bogey', double: 'scv m-double' };
const markClass = (bucket) => MARK[bucket] || 'scv m-par';

const teamShort = (id) => teamById[id]?.name.split(/\s+/).map((w) => w[0]).join('').toUpperCase();
---
{sc && (
  <details class="hsc">
    <summary class="hsc__toggle">
      <span class="hsc__chev" aria-hidden="true">›</span>
      <span>Hole-by-hole {sc.category === 'stableford' ? 'stableford' : sc.isNet ? 'net scorecard' : 'scramble card'}</span>
    </summary>
    <div class="hsc__body">
      <div class="hsc__scroll">
        <table class="hsc__grid tabnums">
          <thead>
            <tr class="hsc__meta">
              <th class="hsc__name">Hole</th>
              {front.map((m) => <th>{m.hole}</th>)}
              {is18 && <th class="hsc__sum">Out</th>}
              {back.map((m) => <th>{m.hole}</th>)}
              {is18 && <th class="hsc__sum">In</th>}
              <th class="hsc__sum hsc__tot">Tot</th>
            </tr>
            <tr class="hsc__si">
              <th class="hsc__name">S.I.</th>
              {front.map((m) => <th>{m.si}</th>)}
              {is18 && <th class="hsc__sum"></th>}
              {back.map((m) => <th>{m.si}</th>)}
              {is18 && <th class="hsc__sum"></th>}
              <th class="hsc__sum"></th>
            </tr>
            <tr class="hsc__par">
              <th class="hsc__name">Par</th>
              {front.map((m) => <th>{m.par}</th>)}
              {is18 && <th class="hsc__sum">{front.reduce((s, m) => s + m.par, 0)}</th>}
              {back.map((m) => <th>{m.par}</th>)}
              {is18 && <th class="hsc__sum">{back.reduce((s, m) => s + m.par, 0)}</th>}
              <th class="hsc__sum hsc__tot">{sc.meta.reduce((s, m) => s + m.par, 0)}</th>
            </tr>
          </thead>
          <tbody>
            {sc.scramble
              ? sc.scramble.teams.map((t) => (
                  <tr class="hsc__player" style={`--accent:${teamById[t.teamId]?.color}`}>
                    <th class="hsc__name">
                      <TeamLogo teamId={t.teamId} size={18} className="hsc__logo" />
                      <span>{teamById[t.teamId]?.name}</span>
                    </th>
                    {front.map((m) => {
                      const c = t.cells.find((x) => x.hole === m.hole);
                      return <td class="scell">{c && !c.empty && <span class={markClass(c.bucket)}>{c.gross}</span>}</td>;
                    })}
                    {is18 && <td class="hsc__sum">{sumCells(t.cells.map((c) => ({ ...c, net: c.gross })), (c) => c.hole <= 9)}</td>}
                    {back.map((m) => {
                      const c = t.cells.find((x) => x.hole === m.hole);
                      return <td class="scell">{c && !c.empty && <span class={markClass(c.bucket)}>{c.gross}</span>}</td>;
                    })}
                    {is18 && <td class="hsc__sum">{sumCells(t.cells.map((c) => ({ ...c, net: c.gross })), (c) => c.hole > 9)}</td>}
                    <td class="hsc__sum hsc__tot">{t.total}</td>
                  </tr>
                ))
              : sc.players.map((p) => {
                  const t = tallies(p);
                  return (
                    <tr class="hsc__player" style={`--accent:${teamById[p.teamId]?.color}`}>
                      <th class="hsc__name">
                        <TeamLogo teamId={p.teamId} size={18} className="hsc__logo" />
                        <span>{p.name}</span>
                        {p.hcp != null && <em class="hsc__hcp">{p.hcp}</em>}
                      </th>
                      {front.map((m) => {
                        const c = p.cells.find((x) => x.hole === m.hole);
                        return <td class="scell">{!c || c.empty ? '' : c.conceded ? <span class="scv conceded">–</span> : <span class={markClass(c.bucket)}>{c.net ?? c.points}</span>}</td>;
                      })}
                      {is18 && <td class="hsc__sum">{t.out}</td>}
                      {back.map((m) => {
                        const c = p.cells.find((x) => x.hole === m.hole);
                        return <td class="scell">{!c || c.empty ? '' : c.conceded ? <span class="scv conceded">–</span> : <span class={markClass(c.bucket)}>{c.net ?? c.points}</span>}</td>;
                      })}
                      {is18 && <td class="hsc__sum">{t.inn}</td>}
                      <td class="hsc__sum hsc__tot">{p.total}{!p.complete && <span class="hsc__thru">·{p.playedThru}</span>}</td>
                    </tr>
                  );
                })}
          </tbody>
          {sc.category === 'matchplay' && (
            <tfoot>
              <tr class="hsc__state">
                <th class="hsc__name">Match</th>
                {front.map((m) => {
                  const s = sc.state.find((x) => x.hole === m.hole);
                  return <td class:list={['sc-state', s?.winner ? `w-${s.winner}` : '']}>{s?.runningLabel === 'AS' ? 'AS' : s?.runningLabel}</td>;
                })}
                {is18 && <td class="hsc__sum"></td>}
                {back.map((m) => {
                  const s = sc.state.find((x) => x.hole === m.hole);
                  return <td class:list={['sc-state', s?.winner ? `w-${s.winner}` : '']}>{s?.runningLabel === 'AS' ? 'AS' : s?.runningLabel}</td>;
                })}
                {is18 && <td class="hsc__sum"></td>}
                <td class="hsc__sum"></td>
              </tr>
            </tfoot>
          )}
        </table>
      </div>

      <div class="hsc__foot">
        <div class="hsc__legend">
          <span class="lg"><span class="scv m-double lg__mk">7</span> Double+</span>
          <span class="lg"><span class="scv m-bogey lg__mk">5</span> Bogey</span>
          <span class="lg"><span class="scv m-par lg__mk">4</span> Par</span>
          <span class="lg"><span class="scv m-birdie lg__mk">3</span> Birdie</span>
          <span class="lg"><span class="scv m-eagle lg__mk">2</span> Eagle+</span>
          {sc.category === 'matchplay' && <span class="hsc__hw">Holes won: {teamShort(sc.sideA.teamId)} {sc.holesWon.A} · {teamShort(sc.sideB.teamId)} {sc.holesWon.B} · halved {sc.holesWon.halved}</span>}
          {sc.category === 'stableford' && <span class="hsc__hw">Team Average Stableford — points shown; match decided on team average.</span>}
        </div>
        <p class="hsc__note">Notation shows each hole's {sc.isNet ? 'net result' : 'team score'} vs par — circles under par, squares over. {sc.isNet ? 'Net scores' : 'Team gross (scramble)'} · {HOLE_STATS_COVERAGE.split('.')[0]}.</p>
      </div>

      {img && (
        <figure class="hsc__card">
          <a href={img.full} target="_blank" rel="noopener" class="hsc__cardlink" aria-label="Open full scorecard image">
            <img src={img.thumb} alt={`Original scorecard — Round ${round.number}, ${match.margin} ${match.halved ? '' : ''}`} loading="lazy" />
            <span class="hsc__zoom">⤢ Full card</span>
          </a>
          <figcaption>
            Original scorecard · Round {round.number} — {round.format}
            {img.shared.length > 0 && <span class="hsc__shared"> · one card covers both singles on this tee sheet</span>}
          </figcaption>
        </figure>
      )}
    </div>
  </details>
)}

<style>
  .hsc { --hsc-head: #22302a; border: 1px solid var(--line); border-radius: var(--r-sm); background: var(--panel); margin-top: .4rem; }
  .hsc__toggle { cursor: pointer; list-style: none; padding: .5rem .8rem; font-size: .76rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--faint); display: flex; align-items: center; gap: .5rem; user-select: none; }
  .hsc__toggle::-webkit-details-marker { display: none; }
  .hsc__toggle:hover { color: var(--muted); }
  .hsc__chev { display: inline-block; transition: transform .2s var(--ease); font-size: 1rem; color: var(--gold); }
  .hsc[open] .hsc__chev { transform: rotate(90deg); }
  .hsc__body { padding: 0 .8rem .9rem; }

  .hsc__scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--r-sm); -webkit-overflow-scrolling: touch; }
  .hsc__grid { border-collapse: collapse; width: 100%; font-size: .78rem; }
  .hsc__grid th, .hsc__grid td { padding: .3rem .12rem; text-align: center; min-width: 2rem; border-right: 1px solid color-mix(in srgb, var(--line) 55%, transparent); }
  .hsc__grid td.scell { padding: .28rem .12rem; }
  .hsc__grid thead th { font-weight: 700; }
  .hsc__meta th { background: var(--hsc-head); color: #fff; font-size: .8rem; }
  .hsc__si th { color: var(--faint); font-size: .68rem; font-weight: 600; background: color-mix(in srgb, var(--line) 22%, transparent); }
  .hsc__par th { color: var(--muted); font-weight: 700; background: color-mix(in srgb, var(--line) 40%, transparent); }
  .hsc__name { position: sticky; left: 0; z-index: 2; text-align: left !important; min-width: 8.2rem !important; padding-left: .5rem !important; padding-right: .5rem !important; background: var(--panel); display: flex; align-items: center; gap: .35rem; white-space: nowrap; }
  thead .hsc__name { background: var(--hsc-head); color: #fff; }
  .hsc__si .hsc__name, .hsc__par .hsc__name { color: inherit; }
  .hsc__meta .hsc__name { background: var(--hsc-head); }
  .hsc__si .hsc__name { background: color-mix(in srgb, var(--line) 22%, var(--panel)); }
  .hsc__par .hsc__name { background: color-mix(in srgb, var(--line) 40%, var(--panel)); }

  .hsc__player th.hsc__name { border-top: 1px solid var(--line); font-weight: 700; color: var(--accent); }
  .hsc__player td { border-top: 1px solid var(--line); color: var(--text); }
  .hsc__logo { border-radius: 50%; flex: none; }
  .hsc__hcp { margin-left: auto; font-style: normal; font-size: .62rem; font-weight: 700; color: var(--faint); background: color-mix(in srgb, var(--accent) 12%, transparent); padding: .05rem .32rem; border-radius: 999px; }
  .hsc__sum { background: color-mix(in srgb, var(--line) 30%, transparent); font-weight: 700; color: var(--muted); }
  .hsc__tot { color: var(--text); }
  .hsc__thru { font-size: .6rem; color: var(--faint); font-weight: 600; }

  /* Traditional scorecard notation. --sq-ink = neutral over-par ink; circles take
     the row's team --accent, eagles are gold, so good scores read at a glance. */
  .scell { --sq-ink: color-mix(in srgb, #9a5b4f 62%, var(--muted)); }
  .scv { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-width: 1.55em; height: 1.55em; padding: 0 .1em; line-height: 1; font-variant-numeric: tabular-nums; color: var(--text); }
  .scv.m-par { color: var(--text); }
  .scv.m-birdie { border: 1.5px solid var(--accent); border-radius: 50%; color: var(--accent); font-weight: 700; }
  .scv.m-eagle { border: 1.5px solid var(--gold-bright); border-radius: 50%; color: var(--gold); font-weight: 800; box-shadow: 0 0 0 1.5px var(--panel), 0 0 0 2.9px var(--gold-bright); }
  .scv.m-bogey { border: 1.5px solid var(--sq-ink); border-radius: 3px; color: var(--sq-ink); font-weight: 600; }
  .scv.m-double { border: 1.5px solid var(--sq-ink); border-radius: 3px; color: var(--sq-ink); font-weight: 700; box-shadow: 0 0 0 1.5px var(--panel), 0 0 0 2.9px var(--sq-ink); }
  .scv.conceded { color: var(--faint); }

  .hsc__state th, .hsc__state td { border-top: 2px solid var(--line); font-size: .66rem; font-weight: 700; color: var(--faint); padding-top: .35rem; padding-bottom: .35rem; }
  .hsc__state .hsc__name { color: var(--muted); background: var(--panel); }
  .sc-state.w-A { color: var(--wp); background: color-mix(in srgb, var(--wp) 10%, transparent); }
  .sc-state.w-B { color: var(--ss); background: color-mix(in srgb, var(--ss) 10%, transparent); }

  .hsc__foot { margin-top: .55rem; }
  /* Legend: draw the same marks in a neutral ink so the shapes read regardless of
     team (on the card itself, birdie/eagle circles take the player's team colour). */
  .hsc__legend { --accent: var(--muted); --sq-ink: color-mix(in srgb, #9a5b4f 62%, var(--muted)); display: flex; flex-wrap: wrap; align-items: center; gap: .45rem .8rem; font-size: .68rem; }
  .lg { display: inline-flex; align-items: center; gap: .35rem; color: var(--muted); font-weight: 600; }
  .lg__mk { font-size: .68rem; }
  .lg .scv.m-birdie { border-color: var(--muted); color: var(--muted); }
  .hsc__hw { color: var(--faint); font-weight: 600; margin-left: auto; }
  .hsc__note { margin-top: .4rem; font-size: .66rem; color: var(--faint); line-height: 1.4; }

  .hsc__card { margin: .8rem 0 0; }
  .hsc__cardlink { position: relative; display: block; border: 1px solid var(--line); border-radius: var(--r-sm); overflow: hidden; background: #fff; box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,.08)); }
  .hsc__cardlink img { display: block; width: 100%; height: auto; }
  .hsc__zoom { position: absolute; right: .5rem; bottom: .5rem; background: color-mix(in srgb, var(--hsc-head) 88%, transparent); color: #fff; font-size: .68rem; font-weight: 700; padding: .28rem .55rem; border-radius: 999px; letter-spacing: .02em; }
  .hsc__card figcaption { margin-top: .4rem; font-size: .68rem; color: var(--faint); }
  .hsc__shared { color: var(--muted); }

  @media (max-width: 560px) {
    .hsc__name { min-width: 6.4rem !important; font-size: .72rem; }
    .hsc__grid { font-size: .74rem; }
  }
</style>
