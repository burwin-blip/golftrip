---
import TeamLogo from './TeamLogo.astro';
import { draftPoolFor } from '../lib/stats.js';
import { dateRange, num, pctText } from '../lib/format.js';

const { t } = Astro.props;
const pool = draftPoolFor(t.id);
const flyer = t.flyer || {};
const acc = t.accommodation || null;

const TABS = [['overview', 'Overview'], ['pool', 'Draft Pool'], ['guide', 'Draft Guide']];
---
<!-- HEADER -->
<section class="section" style="padding-bottom: clamp(1.2rem,3vw,1.6rem)">
  <div class="wrap">
    <a class="back-link" href="/">← The Annual</a>
    <div class="reveal" style="margin-top:.9rem">
      <p class="eyebrow gold">Edition {t.edition} · Upcoming</p>
      <h1 class="display" style="font-size:clamp(2rem,5vw,3.6rem);margin:.4rem 0 .5rem">{t.name}</h1>
      <p class="muted">{dateRange(t.startDate, t.endDate)} · {t.location}</p>
    </div>
  </div>
</section>

<div class="tabs" id="tabs">
  <div class="tabbar-wrap"><div class="wrap"><div class="tabbar" role="tablist">
    {TABS.map(([id, label], i) => (
      <button class:list={["tab", { active: i === 0 }]} role="tab" data-tab={id} id={`tab-${id}`}>{label}</button>
    ))}
  </div></div></div>

  <!-- OVERVIEW -->
  <section class="tabpanel active section" data-panel="overview">
    <div class="wrap">
      <div class="up-grid">
        <div class="up-main">
          <!-- where the scoreboard will go -->
          <div class="tba-bug reveal">
            <div class="tba-side">
              <div class="tba-crest">?</div>
              <div class="tba-team">Team&nbsp;1</div>
              <div class="tba-sub">Captain TBA</div>
              <div class="tba-score">—</div>
            </div>
            <div class="tba-center"><span class="vs">vs</span><span class="tag">Not yet played</span></div>
            <div class="tba-side">
              <div class="tba-crest">?</div>
              <div class="tba-team">Team&nbsp;2</div>
              <div class="tba-sub">Captain TBA</div>
              <div class="tba-score">—</div>
            </div>
          </div>
          <p class="tba-note"><b>Teams to be announced.</b> Captains and the draft are still to come — the pairings and scoreboard will appear here once the trip is played.</p>

          <div class="grid up-facts">
            <div class="tile"><div class="tile__k">When</div><div class="up-fact-v">{dateRange(t.startDate, t.endDate)}</div></div>
            <div class="tile"><div class="tile__k">Where</div><div class="up-fact-v">{t.location}</div></div>
            <div class="tile"><div class="tile__k">Status</div><div class="up-fact-v">Upcoming</div><div class="tile__sub">{pool.length} players in the pool</div></div>
          </div>
          <p class="muted" style="margin-top:1rem;font-size:.95rem">{t.notes}</p>
        </div>

        {flyer.display && (
          <a class="flyer" href={flyer.full} target="_blank" rel="noopener" aria-label={`View the ${t.name} flyer full size`}>
            <img src={flyer.display} width="480" height="680" alt={`${t.name} — ${t.location}, ${dateRange(t.startDate, t.endDate)}`} loading="lazy" decoding="async" />
            <span class="flyer__cue">⤢ Enlarge</span>
          </a>
        )}
      </div>

      {acc && (
        <div class="basecamp-wrap">
          <div class="section-head" style="margin-top:clamp(2rem,5vw,3rem)"><div><p class="eyebrow gold">Basecamp</p><h2>{acc.name}</h2></div></div>
          <div class="card card--pad basecamp">
            <div class="basecamp__main">
              <p class="basecamp__type">{acc.type}</p>
              <div class="basecamp__stats">
                <div><b>★&nbsp;{acc.rating}</b><span>rating</span></div>
                <div><b>{acc.bedrooms}</b><span>bedrooms</span></div>
                <div><b>{acc.beds}</b><span>beds</span></div>
                <div><b>{acc.baths}</b><span>baths</span></div>
              </div>
              <p class="muted" style="font-size:.9rem;max-width:52ch">Sixteen bedrooms under one roof — the whole field, one compound. Home base for the four days in the desert.</p>
              <a class="btn-airbnb" href={acc.url} target="_blank" rel="noopener">View on Airbnb <span aria-hidden="true">↗</span></a>
            </div>
            {acc.photos && acc.photos.length > 0 && (
              <div class="basecamp__gallery">
                {acc.photos.map((src) => (
                  <a class="bc-photo" href={src} target="_blank" rel="noopener"><img src={src} alt={`${acc.name} — the house`} loading="lazy" decoding="async" /></a>
                ))}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- DRAFT POOL -->
  <section class="tabpanel section" data-panel="pool">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">The Field</p><h2>Draft pool</h2></div><span class="faint">{pool.length} eligible</span></div>
      <p class="muted" style="max-width:64ch;margin-bottom:1.4rem;font-size:.95rem">Everyone eligible for the 2027 draft — starting with the {pool.filter((p) => !p.isNew).length} who played St George 2026. Open any player for their scouting report: 2026 record, handicap and analytics. New blokes appear here once they're confirmed.</p>
      <div class="grid pool-grid">
        {pool.map((p) => (
          <a class="card card--pad pool-card" href={`/players/${p.player.slug}`} style={p.teamId ? `--accent:${p.teamId === 'woodpeckers' ? 'var(--wp)' : 'var(--ss)'}` : '--accent:var(--gold-bright)'}>
            <div class="pool-card__head">
              {p.teamId ? <TeamLogo teamId={p.teamId} size={26} /> : <span class="pool-new-dot">★</span>}
              <span class="pool-card__name">{p.player.name}</span>
              {p.isChampion && <span class="pill gold" style="margin-left:auto">♛ Champ</span>}
            </div>
            {p.isNew ? (
              <div class="pool-card__stats"><span class="pill gold">★ Rookie — debuts 2027</span><span class="faint" style="font-size:.8rem">No Annual record yet</span></div>
            ) : (
              <div class="pool-card__stats">
                <span><b class="mono-nums">{p.w}–{p.h}–{p.l}</b> <span class="faint">2026</span></span>
                <span><b class="mono-nums gold">{num(p.pointsEarned)}</b> <span class="faint">pts · {pctText(p.pointPct)}</span></span>
                <span class="faint">Hcp {p.handicap != null ? p.handicap.toFixed(1) : '—'}</span>
              </div>
            )}
            <span class="pool-card__link">Scouting report →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DRAFT GUIDE (placeholder) -->
  <section class="tabpanel section" data-panel="guide">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow gold">Coming soon</p><h2>Draft Guide — TBA</h2></div></div>
      <div class="card card--pad guide-placeholder">
        <div class="guide-placeholder__icon">📋</div>
        <p class="lede" style="margin:0">Full scouting reports and value rankings for the 2027 draft are coming.</p>
        <p class="muted" style="margin-top:.6rem">For now, size up the field from the <a href={`/tournaments/${t.id}#pool`} class="gold">Draft Pool</a> — every profile carries that player's 2026 record, handicap and analytics.</p>
      </div>
    </div>
  </section>
</div>

<noscript><style>.tabpanel{display:block!important}.tabbar{display:none}</style></noscript>

<div class="lightbox" id="up-lightbox" hidden aria-hidden="true"><img id="up-lightbox-img" src="" alt="" /></div>

<style>
  /* tab chrome (shared pattern with the completed view) */
  .tabbar-wrap { position: sticky; top: 64px; z-index: 40; background: color-mix(in srgb, var(--cream) 88%, transparent); backdrop-filter: blur(12px); padding-block: .55rem; }
  .tabbar { display: flex; gap: .25rem; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; background: var(--paper); padding: 5px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line), var(--shadow); }
  .tabbar::-webkit-scrollbar { display: none; }
  .tab { flex: none; background: none; border: 0; padding: .5rem .95rem; border-radius: 999px; font-family: var(--sans); font-size: .82rem; font-weight: 700; color: var(--muted); white-space: nowrap; transition: color .18s var(--ease), background .18s var(--ease); }
  .tab:hover { color: var(--text); background: color-mix(in srgb, var(--green-800) 8%, transparent); }
  .tab.active { color: var(--green-ink); background: var(--green-800); box-shadow: 0 2px 8px -3px rgba(18,43,29,.5); }
  .tabpanel:not(.active) { display: none; }
  .tabpanel { padding-top: clamp(1.6rem,4vw,2.4rem); }

  /* overview */
  .up-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(1.4rem,5vw,3rem); align-items: start; }
  .up-main { min-width: 0; }
  .tba-bug { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; border: 1px dashed var(--line-strong); border-radius: var(--r); overflow: hidden; background: var(--panel); }
  .tba-side { padding: clamp(1rem,3vw,1.6rem); display: flex; flex-direction: column; align-items: center; gap: .45rem; text-align: center; background: var(--ink-2); color: var(--muted); }
  .tba-crest { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; background: var(--panel); border: 1px dashed var(--line-strong); font-family: var(--serif); font-size: 1.3rem; color: var(--faint); }
  .tba-team { font-family: var(--serif); font-weight: 600; font-size: clamp(1.05rem,.9rem+1vw,1.4rem); color: var(--muted); }
  .tba-sub { font-size: .72rem; letter-spacing: .02em; color: var(--faint); }
  .tba-score { font-family: var(--sans); font-weight: 800; font-size: clamp(2rem,1.4rem+3vw,3.2rem); line-height: .9; color: var(--faint); }
  .tba-center { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; padding: .5rem clamp(.6rem,2vw,1.2rem); background: var(--panel); border-inline: 1px dashed var(--line-strong); }
  .tba-center .vs { font-family: var(--serif); font-style: italic; color: var(--gold); font-size: 1rem; }
  .tba-center .tag { font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; color: var(--faint); text-align: center; }
  .tba-note { margin-top: 1rem; font-size: .92rem; color: var(--muted); }
  .tba-note b { color: var(--text); }
  .up-facts { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); margin-top: 1.4rem; }
  .up-fact-v { font-family: var(--serif); font-weight: 600; font-size: 1.2rem; margin-top: .3rem; color: var(--text); }

  .flyer { position: relative; display: block; flex: none; border-radius: var(--r); overflow: hidden; border: 1px solid var(--line-strong); box-shadow: 0 10px 34px -14px rgba(22,34,27,.45); transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
  .flyer img { display: block; width: clamp(220px, 30vw, 320px); height: auto; }
  .flyer:hover { transform: translateY(-3px) rotate(-.4deg); }
  .flyer__cue { position: absolute; top: .5rem; right: .5rem; padding: .3rem .55rem; font-size: .68rem; font-weight: 700; letter-spacing: .03em; color: #fff; background: rgba(20,30,24,.62); border-radius: 999px; opacity: .9; }

  /* draft pool */
  .pool-grid { grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; }
  .pool-card { border-top: 3px solid var(--accent); display: flex; flex-direction: column; gap: .7rem; }
  .pool-card__head { display: flex; align-items: center; gap: .55rem; }
  .pool-card__name { font-family: var(--serif); font-weight: 600; font-size: 1.15rem; color: var(--text); }
  .pool-new-dot { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; background: var(--gold-soft); color: var(--gold); font-size: .8rem; }
  .pool-card__stats { display: flex; flex-direction: column; gap: .3rem; font-size: .88rem; color: var(--muted); }
  .pool-card__link { font-size: .78rem; font-weight: 600; color: var(--gold); margin-top: auto; }

  /* basecamp / accommodation */
  .basecamp { border-top: 3px solid var(--gold-bright); display: grid; gap: 1.4rem; }
  .basecamp__type { font-family: var(--serif); font-size: 1.25rem; color: var(--text); margin-bottom: 1.1rem; }
  .basecamp__stats { display: flex; flex-wrap: wrap; gap: 1.2rem 2.2rem; }
  .basecamp__stats div { display: flex; flex-direction: column; }
  .basecamp__stats b { font-family: var(--serif); font-weight: 600; font-size: clamp(1.5rem,1.2rem+1vw,1.9rem); line-height: 1; color: var(--text); }
  .basecamp__stats span { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); margin-top: .35rem; }
  .basecamp p.muted { margin-top: 1.1rem; }
  .btn-airbnb { align-self: flex-start; display: inline-flex; align-items: center; gap: .5rem; margin-top: 1.2rem; background: var(--wp); color: #fff; font-weight: 700; font-size: .92rem; letter-spacing: .01em; padding: .72rem 1.4rem; border-radius: 999px; box-shadow: 0 8px 20px -10px rgba(46,107,67,.65); transition: transform .2s var(--ease), box-shadow .2s var(--ease); }
  .btn-airbnb:hover { transform: translateY(-2px); box-shadow: 0 12px 26px -10px rgba(46,107,67,.75); }
  .basecamp__gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .6rem; }
  .bc-photo img { border-radius: var(--r-sm); width: 100%; height: 130px; object-fit: cover; border: 1px solid var(--line); }

  /* guide placeholder */
  .guide-placeholder { text-align: center; padding: clamp(2rem,6vw,3.5rem); max-width: 620px; }
  .guide-placeholder__icon { font-size: 2.2rem; margin-bottom: .8rem; }

  /* lightbox */
  .lightbox { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 4vmin; background: rgba(18,24,20,.86); backdrop-filter: blur(4px); cursor: zoom-out; }
  .lightbox[hidden] { display: none; }
  .lightbox img { max-width: 100%; max-height: 92vh; border-radius: 8px; box-shadow: 0 30px 80px -20px #000; }

  @media (max-width: 760px) {
    .up-grid { grid-template-columns: 1fr; }
    .flyer { justify-self: center; }
    .flyer img { width: min(78vw, 340px); }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('tabs');
    if (root) {
      const tabs = [...root.querySelectorAll('.tab')];
      const panels = [...root.querySelectorAll('.tabpanel')];
      const activate = (id, push) => {
        tabs.forEach((t) => t.classList.toggle('active', t.dataset.tab === id));
        panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === id));
        if (push && history.replaceState) history.replaceState(null, '', '#' + id);
      };
      tabs.forEach((t) => t.addEventListener('click', () => activate(t.dataset.tab, true)));
      const hash = location.hash.replace('#', '');
      if (hash && tabs.some((t) => t.dataset.tab === hash)) activate(hash, false);
    }
    const link = document.querySelector('.flyer');
    const box = document.getElementById('up-lightbox');
    const img = document.getElementById('up-lightbox-img');
    if (link && box) {
      link.addEventListener('click', (e) => { e.preventDefault(); img.src = link.getAttribute('href'); box.hidden = false; });
      box.addEventListener('click', () => { box.hidden = true; img.src = ''; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !box.hidden) { box.hidden = true; img.src = ''; } });
    }
  })();
</script>
