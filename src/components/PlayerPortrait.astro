---
// A player's portrait in the house 4:5 frame — the photo when we have one, and
// otherwise a placeholder built from the event's own sunset banner (orange sky,
// navy dune, initials set in the display serif). The placeholder is a designed
// state, not a broken image: drop `public/players/<id>.jpg` in and it becomes a
// photograph on the next build with no other change. See src/lib/portraits.js.
import { playerPortrait, playerInitials, portraitSun } from '../lib/portraits.js';

const { player, loading = 'lazy', sizes = '(max-width: 720px) 46vw, 240px' } = Astro.props;

const src = playerPortrait(player.id);
const initials = playerInitials(player.name);
const sun = portraitSun(player.id);
const uid = `pt-${player.id}`;

// Three horizons, chosen off the id. The mesa is the one St George actually has.
const DUNES = [
  'M0,74 C12,68 20,72 30,69 C42,65 52,71 62,68 C70,66 76,70 80,68 L80,100 L0,100 Z',
  'M0,79 L13,79 L17,70 L33,70 L37,76 L53,76 L57,65 L71,65 L75,73 L80,73 L80,100 L0,100 Z',
  'M0,81 C18,81 26,63 44,63 C60,63 68,74 80,71 L80,100 L0,100 Z',
];
---
{src ? (
  <img
    class="pportrait"
    src={src}
    alt={`${player.name}`}
    width="800"
    height="1000"
    loading={loading}
    decoding="async"
    sizes={sizes}
  />
) : (
  <svg class="pportrait pportrait--placeholder" viewBox="0 0 80 100" role="img" aria-label={`${player.name} — no portrait yet`} preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#DE9660" />
        <stop offset="48%" stop-color="#EFC095" />
        <stop offset="100%" stop-color="#F9E4C6" />
      </linearGradient>
      <radialGradient id={`${uid}-sun`}>
        <stop offset="0%" stop-color="#FFF6E4" stop-opacity="0.9" />
        <stop offset="55%" stop-color="#FFEFD2" stop-opacity="0.42" />
        <stop offset="100%" stop-color="#FFEFD2" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="80" height="100" fill={`url(#${uid}-sky)`} />
    <circle cx={sun.x * 0.8} cy={sun.y} r="17" fill={`url(#${uid}-sun)`} />
    <text class="pportrait__initials" x="40" y="52" text-anchor="middle" dominant-baseline="middle">{initials}</text>
    <path d={DUNES[sun.dune]} fill="#17293F" />
  </svg>
)}

<style>
  /* One frame, both states — so a dropped-in photo lands exactly where the
     placeholder sat and nothing around it moves. */
  .pportrait {
    display: block;
    width: 100%;
    height: auto; /* beats the img's height attribute so aspect-ratio drives the box */
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 28%; /* faces sit high in a portrait frame */
    background: var(--panel-2);
  }
  .pportrait__initials {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 27px;
    letter-spacing: -0.02em;
    fill: #17293F;
    fill-opacity: 0.92;
  }
</style>
