---
// Reusable photo gallery: a responsive grid of square thumbnails that opens a
// swipeable full-size lightbox (prev/next, counter, caption, arrow-keys,
// touch-swipe, Esc/backdrop to close). Used on the tournament Photos tab and on
// player profiles.
//
// Props:
//   photos     — array of { full, thumb, alt }
//   galleryId  — unique id for this instance on the page (e.g. "sg", "pp-tom-brunskill")
//
// Elements ELSEWHERE on the page can open this lightbox at a given photo by
// carrying `data-open-gallery="<galleryId>"` and `data-full="<that photo's full>"`
// (that's how a moment card's thumbnail jumps into the album).
const { photos = [], galleryId } = Astro.props;
---
{photos.length > 0 && (
  <>
    <div class="gallery" id={`${galleryId}-gallery`} data-gallery={galleryId}>
      {photos.map((p, i) => (
        <a class="gphoto" href={p.full} data-full={p.full} data-alt={p.alt} data-idx={i}
           aria-label={`View photo ${i + 1} of ${photos.length} full size`}>
          <img src={p.thumb} alt={p.alt} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>

    <div class="glightbox" data-for={galleryId} hidden aria-hidden="true">
      <button class="glb__btn glb__close" type="button" aria-label="Close">✕</button>
      <button class="glb__btn glb__prev" type="button" aria-label="Previous photo">‹</button>
      <figure class="glb__stage">
        <img class="glb__img" src="" alt="" />
        <figcaption class="glb__cap"><span class="glb__count"></span><span class="glb__alt"></span></figcaption>
      </figure>
      <button class="glb__btn glb__next" type="button" aria-label="Next photo">›</button>
    </div>
  </>
)}

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(clamp(130px, 20vw, 200px), 1fr)); gap: clamp(.4rem, 1vw, .7rem); }
  .gphoto { position: relative; display: block; aspect-ratio: 1; border-radius: var(--r-sm); overflow: hidden; box-shadow: var(--shadow); background: var(--panel-2); transition: transform .18s var(--ease), box-shadow .18s var(--ease); }
  .gphoto img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s var(--ease); }
  .gphoto::after { content: ''; position: absolute; inset: 0; background: radial-gradient(120% 90% at 50% 120%, rgba(12,27,44,.28), transparent 70%); opacity: 0; transition: opacity .2s var(--ease); }
  .gphoto:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .gphoto:hover img { transform: scale(1.05); }
  .gphoto:hover::after { opacity: 1; }

  .glightbox { position: fixed; inset: 0; z-index: 100; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(.2rem, 2vw, 1rem); padding: clamp(.6rem, 3vmin, 2.4rem); background: rgba(9,17,28,.94); backdrop-filter: blur(5px); }
  .glightbox[hidden] { display: none; }
  .glb__stage { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .7rem; min-width: 0; min-height: 0; margin: 0; }
  .glb__stage img { max-width: 100%; max-height: 84vh; border-radius: var(--r-sm); box-shadow: 0 30px 80px -20px #000; object-fit: contain; touch-action: pan-y; }
  .glb__cap { display: flex; gap: .8rem; align-items: baseline; color: var(--navy-text, #E7ECF2); font-size: .82rem; max-width: 90vw; text-align: center; flex-wrap: wrap; justify-content: center; }
  .glb__count { font-weight: 800; letter-spacing: .06em; color: var(--terra-bright, #F5813A); font-variant-numeric: tabular-nums; }
  .glb__alt { color: color-mix(in srgb, #E7ECF2 72%, transparent); }
  .glb__btn { flex: none; width: clamp(38px, 9vw, 52px); height: clamp(38px, 9vw, 52px); border: 0; border-radius: 999px; background: rgba(255,255,255,.1); color: #fff; font-size: 1.6rem; line-height: 1; display: grid; place-items: center; transition: background .15s var(--ease), transform .15s var(--ease); }
  .glb__btn:hover { background: rgba(255,255,255,.2); transform: scale(1.06); }
  .glb__close { position: absolute; top: clamp(.6rem, 3vmin, 1.6rem); right: clamp(.6rem, 3vmin, 1.6rem); width: clamp(36px, 8vw, 46px); height: clamp(36px, 8vw, 46px); font-size: 1.1rem; z-index: 2; }
  @media (max-width: 620px) {
    /* on phones the arrows overlay the image edges to keep the photo big */
    .glightbox { grid-template-columns: 1fr; }
    .glb__prev, .glb__next { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; }
    .glb__prev { left: .5rem; } .glb__next { right: .5rem; }
    .glb__prev:hover, .glb__next:hover { transform: translateY(-50%) scale(1.06); }
  }
</style>

<script is:inline>
  // One guarded pass wires every gallery + lightbox on the page.
  (() => {
    if (window.__pgalWired) return;
    window.__pgalWired = true;
    const wire = () => document.querySelectorAll('.glightbox[data-for]').forEach((box) => {
      const id = box.getAttribute('data-for');
      const grid = document.getElementById(id + '-gallery');
      if (!grid || box.dataset.ready) return;
      box.dataset.ready = '1';
      // move the fixed overlay to <body> so it's never trapped inside a hidden
      // tab panel (lets a photo on another tab, e.g. Overview, open the album)
      document.body.appendChild(box);
      const imgEl = box.querySelector('.glb__img');
      const countEl = box.querySelector('.glb__count');
      const altEl = box.querySelector('.glb__alt');
      const items = [...grid.querySelectorAll('.gphoto')].map((a) => ({
        full: a.getAttribute('data-full'), alt: a.getAttribute('data-alt') || '',
      }));
      let i = 0;
      const show = (n) => {
        i = (n + items.length) % items.length;
        const it = items[i];
        imgEl.src = it.full; imgEl.alt = it.alt;
        countEl.textContent = `${i + 1} / ${items.length}`;
        altEl.textContent = it.alt;
        [i + 1, i - 1].forEach((k) => { new Image().src = items[(k + items.length) % items.length].full; });
      };
      const open = (n) => { show(n); box.hidden = false; box.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; };
      const close = () => { box.hidden = true; box.setAttribute('aria-hidden', 'true'); imgEl.src = ''; document.body.style.overflow = ''; };
      grid.querySelectorAll('.gphoto').forEach((a, idx) =>
        a.addEventListener('click', (e) => { e.preventDefault(); open(idx); }));
      // external openers (e.g. a moment card thumbnail) jump into this album
      document.querySelectorAll(`[data-open-gallery="${id}"][data-full]`).forEach((a) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const url = a.getAttribute('data-full');
          const idx = items.findIndex((it) => it.full === url);
          open(idx >= 0 ? idx : 0);
        }));
      box.querySelector('.glb__next').addEventListener('click', (e) => { e.stopPropagation(); show(i + 1); });
      box.querySelector('.glb__prev').addEventListener('click', (e) => { e.stopPropagation(); show(i - 1); });
      box.querySelector('.glb__close').addEventListener('click', close);
      box.addEventListener('click', (e) => { if (e.target === box || e.target.classList.contains('glb__stage')) close(); });
      document.addEventListener('keydown', (e) => {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(i + 1);
        else if (e.key === 'ArrowLeft') show(i - 1);
      });
      let sx = 0, sy = 0;
      box.addEventListener('touchstart', (e) => { sx = e.changedTouches[0].clientX; sy = e.changedTouches[0].clientY; }, { passive: true });
      box.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) show(i + (dx < 0 ? 1 : -1));
      }, { passive: true });
    });
    wire();
  })();
</script>
