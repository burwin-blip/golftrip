---
// "Course flyover" — a course's official flyover / course-tour video.
//
// YouTube videos and playlists embed, but only when someone taps play: until
// then this is a drawn poster in the site's palette and the page makes NO call
// to YouTube (the site's no-external-calls rule — see CLAUDE.md → Privacy).
// The player uses youtube-nocookie.com. Anything that isn't YouTube renders as
// a styled "watch on <site>" link.
//
// Data: trip-<year>.json → courses[].flyover = { url, title?, by?, note? }
const { flyover, courseName } = Astro.props;

function youtube(u) {
  try {
    const url = new URL(u);
    const host = url.hostname.replace(/^www\.|^m\./, '');
    const list = url.searchParams.get('list');
    let id = null;
    if (host === 'youtu.be') id = url.pathname.slice(1);
    else if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
      id = url.searchParams.get('v') || url.pathname.match(/\/(?:embed|shorts|live)\/([\w-]{6,})/)?.[1] || null;
    } else return null;
    if (id) return { embed: `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1${list ? `&list=${list}` : ''}` };
    if (list) return { embed: `https://www.youtube-nocookie.com/embed/videoseries?list=${list}&autoplay=1&rel=0` };
    return null;
  } catch { return null; }
}

const yt = youtube(flyover.url);
const host = (() => { try { return new URL(flyover.url).hostname.replace(/^www\./, ''); } catch { return flyover.url; } })();
const title = flyover.title || `${courseName} flyover`;
---
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="section-head"><div><p class="eyebrow gold">From above</p><h2>Course flyover</h2></div>{flyover.by && <span class="faint">{flyover.by}</span>}</div>
    {yt ? (
      <div class="fly" data-embed={yt.embed}>
        <button type="button" class="fly__poster" aria-label={`Play: ${title}`}>
          <svg class="fly__art" viewBox="0 0 160 90" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
            <defs>
              <linearGradient id="fly-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#17293F" /><stop offset="62%" stop-color="#4A5F79" /><stop offset="100%" stop-color="#E06A2E" /></linearGradient>
            </defs>
            <rect width="160" height="90" fill="url(#fly-sky)" />
            <circle cx="118" cy="60" r="12" fill="#FCD79A" opacity=".9" />
            <path d="M0,70 L22,52 L38,62 L62,40 L84,58 L104,46 L128,60 L160,48 L160,90 L0,90 Z" fill="#0C1B2C" />
            <path d="M0,82 C40,74 80,86 160,76 L160,90 L0,90 Z" fill="#24603F" opacity=".85" />
          </svg>
          <span class="fly__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
          <span class="fly__cap"><b>{title}</b><span>Tap to play{flyover.note ? ` · ${flyover.note}` : ''}</span></span>
        </button>
      </div>
    ) : (
      <a class="fly-link card" href={flyover.url} target="_blank" rel="noopener">
        <span class="fly-link__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
        <span class="fly-link__text"><b>{title}</b><span>Watch on {host}{flyover.note ? ` · ${flyover.note}` : ''}</span></span>
        <span class="fly-link__go" aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</section>

<style>
  .fly { position: relative; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); background: var(--navy-deep); }
  /* the iframe is created by the script below, so it has no scoped-style attribute */
  .fly :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .fly__poster { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .fly__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fly__play { position: relative; display: grid; place-items: center; width: clamp(64px, 12vw, 88px); aspect-ratio: 1; border-radius: 50%; background: var(--terra); color: #fff; box-shadow: 0 14px 34px -10px rgba(0,0,0,.6); transition: transform .2s var(--ease); }
  .fly__play svg { width: 44%; margin-left: 6%; }
  .fly__poster:hover .fly__play, .fly__poster:focus-visible .fly__play { transform: scale(1.07); }
  .fly__cap { position: absolute; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: .15rem; padding: clamp(.8rem, 3vw, 1.3rem) clamp(1rem, 3vw, 1.6rem); text-align: left; color: #fff; background: linear-gradient(0deg, rgba(12,27,44,.85), transparent); }
  .fly__cap b { font-family: var(--serif); font-weight: 600; font-size: clamp(1.05rem, .95rem + .6vw, 1.35rem); }
  .fly__cap span { font-size: .78rem; opacity: .85; }

  .fly-link { display: flex; align-items: center; gap: 1rem; padding: 1rem clamp(1rem, 3vw, 1.4rem); }
  .fly-link__play { flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--terra); color: #fff; }
  .fly-link__play svg { width: 45%; margin-left: 6%; }
  .fly-link__text { display: flex; flex-direction: column; min-width: 0; }
  .fly-link__text b { font-family: var(--serif); font-weight: 600; font-size: 1.1rem; }
  .fly-link__text span { font-size: .82rem; color: var(--muted); }
  .fly-link__go { margin-left: auto; font-weight: 800; color: var(--faint); }
</style>

<script is:inline>
  // Swap the poster for the real player only on tap — no YouTube request before.
  document.querySelectorAll('.fly[data-embed]').forEach((box) => {
    const btn = box.querySelector('.fly__poster');
    btn?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.embed;
      f.title = btn.getAttribute('aria-label') || 'Course flyover';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(f);
    }, { once: true });
  });
</script>
