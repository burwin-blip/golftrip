  .round-band__meta { display: flex; flex-direction: column; gap: .12rem; margin-right: auto; }
  .round-band__title { font-family: var(--serif); font-size: clamp(1.05rem, .95rem + .6vw, 1.3rem); color: var(--text); }
  .round-band__sub { font-size: .78rem; color: var(--muted); letter-spacing: .01em; }
  .round-band__score { display: flex; flex-direction: column; align-items: flex-end; gap: .1rem; }
  .round-band__tally { display: flex; align-items: center; gap: .4rem; font-size: 1.2rem; }
  .round-band__tally b { font-weight: 700; }
