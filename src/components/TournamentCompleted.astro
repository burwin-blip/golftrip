  .hrec__unit { font-family: var(--sans, inherit); font-size: .85rem; color: var(--faint); }
  .hrec__who { font-size: .8rem; color: var(--muted); }
  .hrec__who a { color: var(--wp); font-weight: 600; }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('tabs');
    if (!root) return;
    const tabs = [...root.querySelectorAll('.tab')];
    const panels = [...root.querySelectorAll('.tabpanel')];
    function activate(id, push) {
      tabs.forEach((t) => t.classList.toggle('active', t.dataset.tab === id));
      panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === id));
      if (push && history.replaceState) history.replaceState(null, '', '#' + id);
    }
    tabs.forEach((t) => t.addEventListener('click', () => activate(t.dataset.tab, true)));

    // Jump links (Overview → Matches): switch to the Matches tab, then scroll to
    // the requested round (or the top of the matches panel).
    function jumpToRound(rnd) {
      activate('matches', true); // un-hides the panel synchronously → layout is ready
      const id = rnd ? 'round-' + rnd : 'matches';
      // behavior:'instant' bypasses the page's global scroll-behavior:smooth (a
      // smooth scroll here gets reset and parks at the top); the sticky-header
      // offset comes from scroll-margin-top on the round blocks. Call it now, then
      // re-assert on a timeout for the odd case where layout settles a frame later.
      // (Do NOT wrap in requestAnimationFrame — a scrollIntoView inside rAF is
      // silently dropped under the smooth scroll-behavior.)
      const go = () => { const el = document.getElementById(id); if (el) el.scrollIntoView({ behavior: 'instant', block: 'start' }); };
      go();
      // On first activation the match logos/content load and grow the layout after
      // the initial jump — re-assert (instantly, so it's invisible when already in
      // place) across the next half-second to absorb that shift.
      [40, 120, 260, 450].forEach((t) => setTimeout(go, t));
    }
    root.querySelectorAll('[data-jump]').forEach((el) => {
      el.addEventListener('click', (e) => { e.preventDefault(); jumpToRound(el.getAttribute('data-round')); });
    });
    // The whole round row is clickable for mouse users; the embedded link stays
    // the keyboard/no-JS control, so skip clicks that land on it (already handled).
    root.querySelectorAll('.round-row').forEach((row) => {
      row.addEventListener('click', (e) => {
        if (e.target.closest('[data-jump]')) return;
        jumpToRound(row.getAttribute('data-round'));
      });
    });

    const hash = location.hash.replace('#', '');
    if (hash && tabs.some((t) => t.dataset.tab === hash)) activate(hash, false);
  })();
</script>
