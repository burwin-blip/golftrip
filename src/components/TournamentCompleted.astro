  .round-band__no { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; flex: none; min-width: 3.1rem; padding: .4rem .5rem; border-radius: var(--r-sm); background: var(--rc); color: #fff; font-family: var(--serif); font-size: 1.7rem; font-weight: 600; font-variant-numeric: tabular-nums; }
