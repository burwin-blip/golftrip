    .round-band__meta { flex-basis: calc(100% - 3.4rem); }
    .round-band__score { align-items: flex-start; flex-basis: 100%; margin-top: .2rem; }
    .round-block { padding: .35rem .35rem .2rem; }
  }

  table.matrix .fmtcell { width: 1.5rem; height: 1.5rem; display: inline-grid; place-items: center; border-radius: 5px; font-size: .72rem; font-weight: 800; }
  .fmtcell.w { background: var(--wp-soft); color: var(--wp-ink); }
  .fmtcell.h { background: var(--gold-soft); color: var(--gold); }
  .fmtcell.l { background: var(--panel-2); color: var(--faint); box-shadow: inset 0 0 0 1px var(--line); }

  /* featured top row — Team Champions + Champion Golfer */
  .cabinet-featured { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  .award-feat { padding: clamp(1.4rem,3vw,1.9rem) clamp(1.3rem,3vw,1.7rem); display: flex; flex-direction: column; gap: .4rem; border-top: 4px solid var(--gold-bright); background: linear-gradient(180deg, var(--gold-soft), var(--panel)); }
  .award-feat__cup { font-size: 2rem; line-height: 1; }
  .award-feat__name { font-family: var(--sans); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); font-weight: 700; margin-top: .3rem; }
  .award-feat__winner { font-family: var(--serif); font-weight: 600; font-size: clamp(1.4rem,1.1rem+1.6vw,2rem); line-height: 1.05; color: var(--text); }
  .award-feat__winner a { color: var(--text); }
  .award-feat__winner a:hover { color: var(--gold); }
  .award-feat__note { font-size: .88rem; font-style: italic; color: var(--muted); margin-top: .2rem; }
  @media (max-width: 640px) { .cabinet-featured { grid-template-columns: 1fr; } }

  .cabinet { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; }
  .award-card { padding: 1.3rem 1.2rem; display: flex; flex-direction: column; gap: .35rem; border-top: 3px solid var(--line-strong); }
  .award-card--gold { border-top-color: var(--gold-bright); background: linear-gradient(180deg, var(--gold-soft), var(--panel)); }
  .award-card__cup { font-size: 1.6rem; line-height: 1; }
  .award-card__name { font-family: var(--serif); font-size: 1.08rem; line-height: 1.2; margin-top: .2rem; }
  .award-card__winner { font-weight: 700; }
  .award-card--gold .award-card__winner { color: var(--gold); }
  .award-card__note { font-size: .85rem; font-style: italic; color: var(--muted); margin-top: .2rem; }

  .mom-round + .mom-round { margin-top: 2rem; }
  .mom-round__label { display: flex; align-items: baseline; gap: .7rem; margin-bottom: .9rem; padding-bottom: .6rem; border-bottom: 1px solid var(--line); }
  .mom-grid { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .mom-item { border-left: 3px solid var(--accent); }
  .mom-cat { display: flex; align-items: center; gap: .5rem; margin-bottom: .4rem; }

  @media (max-width: 640px) { .roster-grid { grid-template-columns: 1fr; } }

  /* Hole-by-hole record cards */
  .hrec { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: .8rem; margin-top: 1.1rem; }
  .hrec__card { border-radius: var(--r-sm); background: var(--panel); padding: .95rem 1.1rem; box-shadow: var(--shadow); }
  .hrec__label { font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); font-weight: 700; }
