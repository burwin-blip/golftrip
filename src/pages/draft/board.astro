---
// THE BIG BOARD — /draft/board. Public but unlisted (noindex like every page;
// not linked from the site). For the TV and the livestream: dark, full-screen,
// theatrical. Polls /api/draft every second; every stage (clock, overtime, the
// reveal) is timed from the server's timestamps, so a refreshed or reconnected
// board lands exactly where things stand — including mid-reveal.
import Base from '../../layouts/Base.astro';
import { draftRoomData } from '../../lib/draft-data.js';
const data = draftRoomData();
---
<Base title="Draft Board" description="The Annual 2027 draft — live." bare>
  <div class="db" id="db" data-phase="setup">
    <div class="db-mock" id="db-mock" hidden aria-hidden="true"><span>MOCK DRAFT</span></div>
    <header class="db-top">
      <div class="db-brand">THE ANNUAL <b>·</b> 2027 DRAFT <span class="db-mocktag" id="db-mocktag" hidden>MOCK</span></div>
      <ol class="db-order" id="db-order" aria-label="Pick order"></ol>
      <span class="db-conn" id="db-conn" title="Connection"></span>
    </header>
    <main class="db-main">
      <section class="db-team" data-side="A"><h2 class="db-team__name" id="db-name-A">Team A</h2><div class="db-roster" id="db-roster-A"></div></section>
      <section class="db-stage" id="db-stage" aria-live="polite"></section>
      <section class="db-team" data-side="B"><h2 class="db-team__name" id="db-name-B">Team B</h2><div class="db-roster" id="db-roster-B"></div></section>
    </main>
    <section class="db-finale" id="db-finale" aria-live="polite"></section>
    <button type="button" class="db-sound" id="db-sound" hidden>🔊 Click to turn on the board’s sound</button>
  </div>
  <script type="application/json" id="db-data" set:html={JSON.stringify(data)} />
</Base>

<style is:global>
  html:has(.db), body:has(.db) { background: #07111D !important; }
  .db { --a: #E06A2E; --b: #4A8FD1; min-height: 100vh; min-height: 100dvh; color: #E7ECF2; background: radial-gradient(120% 80% at 50% 0%, #17293F 0%, #0B1726 55%, #07111D 100%); display: flex; flex-direction: column; overflow: hidden; position: relative; }
  .db-top { display: flex; align-items: center; gap: 1.2rem; padding: 1rem 2vw .6rem; }
  .db-brand { font-weight: 900; letter-spacing: .22em; font-size: clamp(.8rem, .6rem + .5vw, 1.1rem); white-space: nowrap; color: #FCD79A; }
  .db-brand b { color: #E06A2E; }
  .db-mocktag { margin-left: .6rem; padding: .15rem .55rem; border-radius: 99px; background: #E06A2E; color: #fff; letter-spacing: .12em; }
  .db-order { list-style: none; margin: 0; padding: 0; display: flex; gap: .35rem; flex: 1; overflow: hidden; justify-content: center; }
  .db-order li { flex: 0 1 auto; min-width: 0; padding: .3rem .55rem; border-radius: 8px; font-size: clamp(.62rem, .5rem + .35vw, .85rem); font-weight: 800; background: rgba(255,255,255,.06); box-shadow: inset 0 -3px 0 var(--c); color: rgba(231,236,242,.55); white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
  .db-order li.is-done { color: #E7ECF2; background: rgba(255,255,255,.1); }
  .db-order li.is-now { background: var(--c); color: #fff; box-shadow: 0 0 0 2px #fff, 0 0 22px var(--c); animation: db-pulse 1.4s ease-in-out infinite; }
  .db-conn { width: 12px; height: 12px; border-radius: 50%; background: #3FB67B; flex: none; }
  .db-conn.is-bad { background: #E0492E; animation: db-flash .6s steps(2) infinite; }
  .db-main { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 1.15fr) minmax(0, 1fr); gap: 2vw; padding: 1vh 2vw 2vh; min-height: 0; }
  .db-team { display: flex; flex-direction: column; min-height: 0; }
  .db-team__name { font-family: var(--serif); font-size: clamp(1.4rem, 1rem + 1.6vw, 2.6rem); color: #fff; margin-bottom: .8rem; padding-bottom: .4rem; border-bottom: 5px solid var(--c); }
  .db-team[data-side="A"] { --c: var(--a); } .db-team[data-side="B"] { --c: var(--b); }
  .db-roster { display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); gap: .8vw; align-content: start; }
  .db-roster .dc { --dc-c: var(--c); }
  .db-roster .dc__name { font-size: clamp(.7rem, .45rem + .6vw, 1.05rem); }
  .db-roster .dc__meta { font-size: clamp(.55rem, .4rem + .35vw, .72rem); }
  .db-roster .dc.is-slam { animation: db-slam .7s cubic-bezier(.2, 1.6, .4, 1) both; }
  .db-stage { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 1.2vh; min-width: 0; }
  .db-k { font-weight: 900; letter-spacing: .3em; text-transform: uppercase; font-size: clamp(.8rem, .5rem + .9vw, 1.5rem); color: #FCD79A; }
  .db-who { font-family: var(--serif); font-weight: 700; font-size: clamp(1.8rem, 1rem + 2.8vw, 4.2rem); line-height: 1; color: #fff; }
  .db-who span { color: var(--c); }
  .db-clock { font-weight: 900; font-variant-numeric: tabular-nums; font-size: clamp(5rem, 2rem + 11vw, 15rem); line-height: .9; letter-spacing: -.03em; color: #fff; text-shadow: 0 10px 40px rgba(0,0,0,.5); }
  .db-clock.is-low { color: #FCD79A; }
  .db-sub { font-size: clamp(.8rem, .6rem + .5vw, 1.1rem); color: rgba(231,236,242,.7); font-weight: 700; letter-spacing: .08em; }
  .db[data-phase="overtime"] .db-k { color: #FF4B3A; animation: db-flash .8s steps(2) infinite; font-size: clamp(1.4rem, .8rem + 2.4vw, 3.4rem); }
  .db[data-phase="overtime"] .db-clock { color: #FF4B3A; }
  .db[data-phase="overtime"] { background: radial-gradient(120% 80% at 50% 0%, #3A1414 0%, #1A0B0F 60%, #07111D 100%); }
  .db-isin { font-family: var(--serif); font-weight: 800; font-size: clamp(2.4rem, 1.2rem + 5vw, 7rem); line-height: .95; color: #fff; text-transform: uppercase; letter-spacing: -.01em; }
  .db-count { font-weight: 900; font-size: clamp(6rem, 3rem + 12vw, 18rem); line-height: .9; color: var(--c); font-variant-numeric: tabular-nums; animation: db-tick 1s ease-out infinite; }
  .db-reveal { width: min(80%, 360px); animation: db-slam .8s cubic-bezier(.2, 1.6, .4, 1) both; }
  .db-reveal .dc { --dc-c: var(--c); box-shadow: 0 0 0 4px var(--c), 0 30px 80px -20px rgba(0,0,0,.8); }
  .db-reveal .dc__name { font-size: clamp(1.4rem, 1rem + 1.4vw, 2.4rem); }
  .db-reveal .dc__meta { font-size: clamp(.8rem, .6rem + .5vw, 1.1rem); }
  .db-big { font-family: var(--serif); font-weight: 800; font-size: clamp(2.6rem, 1.4rem + 5vw, 7rem); color: #fff; line-height: .95; }
  .db-mock { position: fixed; inset: 0; z-index: 50; pointer-events: none; display: grid; place-items: center; }
  .db-mock[hidden] { display: none; }   /* display:grid would otherwise override [hidden] and show the watermark on the REAL draft */
  .db-mock span { transform: rotate(-24deg); font-weight: 900; font-size: 14vw; letter-spacing: .08em; color: rgba(224,106,46,.09); white-space: nowrap; border: .6vw solid rgba(224,106,46,.09); padding: 0 3vw; }
  /* announcer: "PICK 3 — TEAM PEDLER" */
  .db-ann { display: flex; align-items: baseline; justify-content: center; gap: .5em; flex-wrap: wrap; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; line-height: 1; margin: 0; }
  .db-ann__n { color: #FCD79A; font-size: clamp(1.2rem, .6rem + 1.7vw, 2.6rem); }
  .db-ann__dash { color: rgba(255,255,255,.5); font-size: clamp(1rem, .5rem + 1.4vw, 2.2rem); }
  .db-ann__t { color: var(--c); font-size: clamp(1.2rem, .6rem + 1.7vw, 2.6rem); font-family: var(--serif); letter-spacing: .02em; }
  .db-ann--slam { animation: db-ann .6s ease-out both; }
  .db-ann-sub { margin: 0; font-size: clamp(.75rem, .5rem + .5vw, 1rem); font-weight: 800; letter-spacing: .3em; text-transform: uppercase; color: rgba(231,236,242,.6); }
  @keyframes db-ann { from { transform: translateY(-30px); opacity: 0; letter-spacing: .4em; } to { transform: none; opacity: 1; } }

  /* the finale: the fight poster assembles itself */
  .db-finale { display: none; }
  .db[data-finale="1"] .db-main, .db[data-finale="1"] .db-order { display: none; }
  .db[data-finale="1"] .db-finale { display: flex; flex-direction: column; flex: 1; min-height: 0; padding: 0 2vw 2vh; }
  .fn-intro { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; font-family: var(--serif); font-weight: 800; font-size: clamp(3rem, 2rem + 5vw, 8rem); color: #fff; text-transform: uppercase; animation: fn-intro 1.5s ease-in-out both; z-index: 5; }
  .fn-grid { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) clamp(90px, 9vw, 180px) minmax(0, 1fr); gap: 1.5vw; align-items: start; min-height: 0; }
  .fn-side { --c: var(--a); min-width: 0; }
  .fn-side[data-side="B"] { --c: var(--b); }
  .fn-head { display: flex; align-items: center; gap: 1rem; padding-bottom: .7rem; margin-bottom: 1.2vh; border-bottom: 6px solid var(--c); animation: fn-head .7s ease-out both; }
  .fn-side[data-side="B"] .fn-head { flex-direction: row-reverse; text-align: right; }
  .fn-mono { width: clamp(52px, 4.5vw, 84px); height: clamp(52px, 4.5vw, 84px); border-radius: 50%; display: grid; place-items: center; background: var(--c); color: #fff; font-family: var(--serif); font-weight: 800; font-size: clamp(1.6rem, 1rem + 1.6vw, 2.8rem); box-shadow: 0 0 0 4px rgba(255,255,255,.9), 0 0 40px var(--c); flex: none; }
  .fn-name { margin: 0; font-family: var(--serif); font-weight: 800; color: #fff; font-size: clamp(1.6rem, 1rem + 2vw, 3.2rem); line-height: 1; }
  .fn-cap { margin: .3rem 0 0; font-size: clamp(.7rem, .5rem + .4vw, 1rem); font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: rgba(231,236,242,.7); }
  .fn-cards { display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); gap: .9vw; }
  .fn-card { animation: fn-in-a .55s cubic-bezier(.2, 1.4, .4, 1) both; }
  .fn-side[data-side="B"] .fn-card { animation-name: fn-in-b; }
  .fn-card .dc { --dc-c: var(--c); }
  .fn-card .dc__name { font-size: clamp(.7rem, .45rem + .6vw, 1.1rem); }
  .fn-card .dc__meta { font-size: clamp(.55rem, .4rem + .35vw, .75rem); }
  .fn-card--cap .dc { box-shadow: 0 0 0 3px var(--c), 0 0 30px -4px var(--c); }
  .fn-vs { align-self: center; text-align: center; font-family: var(--serif); font-style: italic; font-weight: 800; font-size: clamp(3rem, 2rem + 5vw, 9rem); color: #FCD79A; text-shadow: 0 0 40px rgba(252,215,154,.5); animation: fn-vs .8s cubic-bezier(.2, 1.6, .4, 1) both; }
  .fn-title { text-align: center; margin: 2vh 0 0; animation: fn-title 1s ease-out both; }
  .fn-title b { display: block; font-weight: 900; letter-spacing: .4em; text-transform: uppercase; font-size: clamp(.9rem, .6rem + 1vw, 1.6rem); color: #FCD79A; }
  .fn-title span { display: block; font-family: var(--serif); font-weight: 800; text-transform: uppercase; color: #fff; font-size: clamp(2rem, 1.2rem + 3vw, 4.6rem); line-height: 1.05; margin-top: .3rem; }
  @keyframes fn-intro { 0% { opacity: 0; transform: scale(.9); } 25%, 70% { opacity: 1; transform: none; } 100% { opacity: 0; transform: scale(1.15); } }
  @keyframes fn-head { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: none; } }
  @keyframes fn-in-a { from { opacity: 0; transform: translateX(-60vw) rotate(-12deg) scale(1.3); } to { opacity: 1; transform: none; } }
  @keyframes fn-in-b { from { opacity: 0; transform: translateX(60vw) rotate(12deg) scale(1.3); } to { opacity: 1; transform: none; } }
  @keyframes fn-vs { from { opacity: 0; transform: scale(3); } to { opacity: 1; transform: none; } }
  @keyframes fn-title { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
  .db-sound { position: fixed; right: 1.2rem; bottom: 1.2rem; z-index: 60; border: 0; border-radius: 999px; padding: .7rem 1.2rem; font: inherit; font-weight: 800; background: #FCD79A; color: #0C1B2C; cursor: pointer; box-shadow: 0 10px 30px -10px #000; }
  .db-sound[hidden] { display: none; }
  @media (max-width: 900px) { .fn-grid { grid-template-columns: 1fr; } .fn-vs { font-size: 3rem; } .fn-side[data-side="B"] .fn-head { flex-direction: row; text-align: left; } }
  @keyframes db-pulse { 50% { box-shadow: 0 0 0 2px #fff, 0 0 38px var(--c); } }
  @keyframes db-flash { 50% { opacity: .35; } }
  @keyframes db-tick { from { transform: scale(1.25); opacity: .6; } to { transform: scale(1); opacity: 1; } }
  @keyframes db-slam { from { transform: scale(2.6) rotate(-6deg); opacity: 0; } 60% { transform: scale(.94) rotate(1deg); opacity: 1; } to { transform: scale(1) rotate(0); } }
  @media (max-width: 900px) { .db-main { grid-template-columns: 1fr; } .db-stage { order: -1; padding: 2vh 0; } .db-roster { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

<script>
  import { phaseAt, rosters, clockText, finaleTimeline } from '../../lib/draft-shared.js';
  import { startPolling, cardHtml, esc, CARD_CSS } from '../../lib/draft-client.js';

  const DATA = JSON.parse(document.getElementById('db-data').textContent);
  const P = Object.fromEntries(DATA.players.map((p) => [p.id, p]));
  document.head.insertAdjacentHTML('beforeend', `<style>${CARD_CSS}</style>`);
  const $ = (id) => document.getElementById(id);
  const root = $('db');
  let doc = null, now = () => Date.now(), lastShown = null, lastRosters = null, slammed = new Set();

  const surname = (id) => (P[id]?.last || id);
  const teamName = (s) => doc?.teams?.[s]?.name || (doc?.captains?.[s] ? `Team ${surname(doc.captains[s])}` : `Team ${s}`);

  // Ryder Cup announcer style: "PICK 3 — TEAM PEDLER"
  const announce = (n, s, slam = false) => `<p class="db-ann${slam ? ' db-ann--slam' : ''}"><span class="db-ann__n">Pick ${n}</span><span class="db-ann__dash">—</span><span class="db-ann__t">${esc(teamName(s))}</span></p>`;

  function render() {
    if (!doc) return;
    const t = now();
    const ph = phaseAt(doc, t);
    root.dataset.phase = ph.phase;
    const finale = ['complete', 'finalised'].includes(ph.phase) && doc.finaleAt;
    root.dataset.finale = finale ? '1' : '0';
    sounds(ph, t);
    const mock = doc.mode === 'mock';
    $('db-mock').hidden = !mock; $('db-mocktag').hidden = !mock;
    // team colours: the finalised ones, else the stage defaults
    for (const s of ['A', 'B']) if (doc.teams?.[s]?.color) root.style.setProperty(s === 'A' ? '--a' : '--b', doc.teams[s].color);

    // never show a pick before its reveal: while "THE PICK IS IN" runs, it's hidden
    const hidden = ph.phase === 'pick-is-in' ? ph.reveal.pickNo : null;
    const visible = { ...doc, picks: doc.picks.filter((p) => p.n !== hidden) };
    const r = rosters(visible);
    const per = { A: 1 + doc.order.filter((x) => x === 'A').length, B: 1 + doc.order.filter((x) => x === 'B').length };
    // redraw the rosters only when they change, so a card's slam plays once
    const rosterSig = JSON.stringify([r, per, ph.phase === 'slam' ? ph.reveal?.playerId : null, doc.teams]);
    const rostersChanged = rosterSig !== lastRosters;
    lastRosters = rosterSig;
    for (const s of ['A', 'B']) {
      if (!rostersChanged) break;
      $(`db-name-${s}`).textContent = teamName(s);
      const cells = [];
      for (let i = 0; i < Math.max(per[s], r[s].length, 1); i++) {
        const id = r[s][i];
        const isCap = id && id === doc.captains[s];
        cells.push(cardHtml(id ? P[id] || { name: id, initials: '?' } : null, { size: 'sm', badge: isCap ? '<span class="dc__cap">C</span>' : '' }).replace('class="dc ', `class="dc ${id && !slammed.has(id) && ph.phase === 'slam' && ph.reveal?.playerId === id ? 'is-slam ' : ''}`));
      }
      // up to 9 a side → 3 across (bigger cards that fill the TV); more → 4 across
      $(`db-roster-${s}`).style.setProperty('--cols', cells.length <= 9 ? 3 : 4);
      $(`db-roster-${s}`).innerHTML = cells.join('');
    }
    if (ph.phase === 'slam' && ph.reveal) setTimeout(() => slammed.add(ph.reveal.playerId), 700);
    else if (ph.phase !== 'slam') for (const p of doc.picks) slammed.add(p.playerId);

    // pick order strip
    $('db-order').innerHTML = doc.order.map((s, i) => {
      const made = visible.picks.find((p) => p.n === i + 1);
      const cls = made ? 'is-done' : ph.pickNo === i + 1 && ['clock', 'overtime', 'waiting', 'paused'].includes(ph.phase) ? 'is-now' : '';
      return `<li class="${cls}" style="--c:var(--${s.toLowerCase()})">${i + 1}${made ? ` · ${esc(surname(made.playerId))}` : ''}</li>`;
    }).join('');

    // centre stage
    const side = ph.side || ph.reveal?.side;
    $('db-stage').style.setProperty('--c', `var(--${(side || 'a').toLowerCase()})`);
    const captain = side ? doc.captains[side] : null;
    let html = '';
    switch (ph.phase) {
      case 'setup': html = `<p class="db-k">Draft night</p><p class="db-big">The Annual<br>2027</p><p class="db-sub">Starting soon</p>`; break;
      case 'waiting':
      case 'clock': {
        const low = ph.remainingMs <= 20_000;
        html = `<p class="db-k">On the clock · pick ${ph.pickNo} of ${ph.total}</p><p class="db-who"><span>${esc(teamName(side))}</span></p>
          <p class="db-clock${low ? ' is-low' : ''}">${clockText(ph.remainingMs)}</p><p class="db-sub">${esc(P[captain]?.name || '')} is picking</p>`; break;
      }
      case 'overtime': html = `<p class="db-k">Overtime</p><p class="db-who"><span>${esc(teamName(side))}</span></p><p class="db-clock">${clockText(ph.overMs, true)}</p><p class="db-sub">${esc(P[captain]?.name || '')} is still picking · pick ${ph.pickNo} of ${ph.total}</p>`; break;
      case 'pick-is-in': html = `${announce(ph.reveal.pickNo, side)}<p class="db-isin">The pick<br>is in</p><p class="db-count" key="${ph.countdown}">${ph.countdown}</p>`; break;
      case 'slam': html = `${announce(ph.reveal.pickNo, side, true)}<p class="db-ann-sub">Pick ${ph.reveal.pickNo} of ${ph.total} · the selection is</p><div class="db-reveal">${cardHtml(P[ph.reveal.playerId] || { name: ph.reveal.playerId, initials: '?' }, { size: 'lg' })}</div>`; break;
      case 'paused': html = `<p class="db-k">Paused</p><p class="db-big">Stand by</p>${ph.pickNo ? `<p class="db-sub">${esc(teamName(ph.side))} on the clock · ${ph.overMs ? clockText(ph.overMs, true) + ' over' : clockText(ph.remainingMs) + ' left'}</p>` : ''}`; break;
      case 'complete': html = `<p class="db-k">The draft is done</p><p class="db-big">${esc(teamName('A'))}<br><span style="font-size:.45em;color:#FCD79A">v</span><br>${esc(teamName('B'))}</p>`; break;
      case 'finalised': html = `<p class="db-k">Final</p><p class="db-big">${esc(teamName('A'))}<br><span style="font-size:.45em;color:#FCD79A">v</span><br>${esc(teamName('B'))}</p><p class="db-sub">See you on the first tee</p>`; break;
    }
    if (finale) renderFinale(t);
    // only rebuild the stage when it changes (keeps the animations from restarting every tick)
    const sig = `${ph.phase}|${ph.pickNo}|${ph.countdown}|${ph.reveal?.pickNo}|${Math.floor((ph.remainingMs ?? ph.overMs ?? 0) / 1000)}|${doc.rev}`;
    if (sig !== lastShown) { $('db-stage').innerHTML = html; lastShown = sig; }
  }

  // ---- the finale: built once per (start, teams, rosters); CSS animation delays
  // relative to "now" do the timing, so a refresh mid-finale lands in step and a
  // finished finale renders straight into its resting state.
  let lastFinale = '';
  function renderFinale(t) {
    const r = rosters(doc);
    const sig = JSON.stringify([doc.finaleAt, r, doc.teams]);
    if (sig === lastFinale) return;
    lastFinale = sig;
    const tl = finaleTimeline(r.A.length, r.B.length);
    const el = t - doc.finaleAt;
    const d = (ms) => `animation-delay:${((ms - el) / 1000).toFixed(2)}s`;
    const mono = (s) => (teamName(s).replace(/^(team|the)\s+/i, '').trim()[0] || '?').toUpperCase();
    const side = (s) => {
      const cols = r[s].length <= 6 ? 3 : r[s].length <= 8 ? 4 : 5;
      return `<div class="fn-side" data-side="${s}">
        <header class="fn-head" style="${d(tl.headers)}"><span class="fn-mono">${esc(mono(s))}</span><div><p class="fn-name">${esc(teamName(s))}</p><p class="fn-cap">Captain ${esc(P[doc.captains[s]]?.name || '')}</p></div></header>
        <div class="fn-cards" style="--cols:${cols}">${r[s].map((id, i) => `<div class="fn-card${i === 0 ? ' fn-card--cap' : ''}" style="${d(tl.cards[s][i])}">${cardHtml(P[id] || { name: id, initials: '?' }, { size: 'sm', badge: i === 0 ? '<span class="dc__cap">C</span>' : '' })}</div>`).join('')}</div></div>`;
    };
    $('db-finale').innerHTML = `${el < 1500 ? `<div class="fn-intro" style="${d(0)}">The draft is done</div>` : ''}
      <div class="fn-grid">${side('A')}<div class="fn-vs" style="${d(tl.vs)}">vs</div>${side('B')}</div>
      <p class="fn-title" style="${d(tl.title)}"><b>The Annual ${esc(DATA.tournamentId.match(/\d{4}/)?.[0] || '')} —</b><span>The teams are set</span></p>`;
    if (doc.sound && el < 2000) scheduleFinaleSound(tl, el);
  }

  // ---- sound (off unless the commissioner turns it on; all synthesised here,
  // no audio files). Browsers only allow sound after a click on the page, so the
  // board shows a one-time "turn on sound" button while sound is on.
  let ac = null;
  const audio = () => (ac ||= new (window.AudioContext || window.webkitAudioContext)());
  function tone(freq, at, dur, { type = 'sine', gain = 0.15, attack = 0.01 } = {}) {
    const a = audio(), o = a.createOscillator(), g = a.createGain(), f = a.createBiquadFilter();
    o.type = type; o.frequency.value = freq; f.type = 'lowpass'; f.frequency.value = 2400;
    g.gain.setValueAtTime(0.0001, at); g.gain.exponentialRampToValueAtTime(gain, at + attack); g.gain.exponentialRampToValueAtTime(0.0001, at + dur);
    o.connect(f).connect(g).connect(a.destination); o.start(at); o.stop(at + dur + 0.05);
  }
  const live = () => doc?.sound && ac && ac.state === 'running';
  const playTick = (last) => { if (!live()) return; const t0 = ac.currentTime; tone(last ? 1320 : 990, t0, 0.07, { type: 'square', gain: 0.06, attack: 0.002 }); };
  const playSting = () => {   // a short brass-ish hit: low root + a major chord
    if (!live()) return; const t0 = ac.currentTime;
    tone(98, t0, 0.9, { type: 'sawtooth', gain: 0.12 });
    [392, 494, 587].forEach((f, i) => tone(f, t0 + 0.04 * i, 0.8, { type: 'sawtooth', gain: 0.07, attack: 0.02 }));
  };
  function scheduleFinaleSound(tl, el) {   // a rising build under the cards, then a fanfare on the title
    if (!live()) return; const t0 = ac.currentTime - el / 1000;
    const notes = [262, 330, 392, 523];
    tl.cards.A.concat(tl.cards.B).sort((a, b) => a - b).forEach((ms, i) => { const at = t0 + ms / 1000; if (at > ac.currentTime) tone(notes[i % 4] / 2, at, 0.25, { type: 'triangle', gain: 0.07 }); });
    const at = t0 + tl.title / 1000;
    if (at > ac.currentTime) {
      [392, 523, 659].forEach((f, i) => tone(f, at + i * 0.14, 0.22, { type: 'sawtooth', gain: 0.08 }));
      [131, 262, 330, 392, 523].forEach((f) => tone(f, at + 0.45, 2.4, { type: 'sawtooth', gain: 0.06, attack: 0.05 }));
    }
  }
  let lastTick = '', stung = new Set();
  function sounds(ph, t) {
    $('db-sound').hidden = !(doc.sound && (!ac || ac.state !== 'running'));
    if (!live()) return;
    if (ph.phase === 'clock' && ph.remainingMs <= 5000 && ph.remainingMs > 0) {
      const sec = Math.ceil(ph.remainingMs / 1000), k = `${ph.pickNo}:${sec}`;
      if (k !== lastTick) { lastTick = k; playTick(sec === 1); }
    }
    if (ph.phase === 'slam' && !stung.has(ph.reveal.lockedAt)) {
      stung.add(ph.reveal.lockedAt);
      if (t - ph.reveal.revealAt < 1500) playSting();
    }
  }
  $('db-sound').addEventListener('click', async () => { try { await audio().resume(); } catch {} lastFinale = ''; render(); });

  const poll = startPolling('/api/draft', {
    every: 1000,
    onData: (body, clock) => { doc = body.draft; now = clock; render(); },
    onStatus: (st) => $('db-conn').classList.toggle('is-bad', st !== 'live'),
  });
  setInterval(render, 200);
</script>
