---
// A course profile. Everything here comes from the course's entry in
// data/trip-<year>.json plus whatever images are sitting in
// public/photos/<year>/courses/<slug>/ — no per-course code.
//
// Fields the owner hasn't verified are left null in the data and simply don't
// render. Nothing on this page is inferred: where a figure exists, the source
// it came from is linked at the bottom.
import Base from '../../layouts/Base.astro';
import CoursePhoto from '../../components/CoursePhoto.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { trips, tournamentById } from '../../lib/data.js';
import { coursePhotos } from '../../lib/course-photos.js';
import { weekday, dayMonth } from '../../lib/format.js';

export function getStaticPaths() {
  return trips.flatMap((trip) => {
    const t = tournamentById[trip.tournamentId];
    return (trip.courses ?? [])
      .filter((c) => c.slug && c.name)
      .map((c) => ({ params: { slug: c.slug }, props: { c, trip, t } }));
  });
}

const { c, t } = Astro.props;
const photos = coursePhotos(t.year, c.slug, c.name);
const hero = photos[0] ?? null;
const rest = photos.slice(1);

const yds = (n) => `${n.toLocaleString('en-US')} yds`;
const host = (u) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
---
<Base
  active={t.id}
  title={c.name}
  description={`${c.name}${c.location ? ` — ${c.location}` : ''}. Course profile for ${t.shortName}.`}
>
  <section class="section">
    <div class="wrap">
      <a class="back-link" href={`/tournaments/${t.id}#trip`}>← {t.shortName} · the trip</a>

      <div class="chead reveal">
        <p class="eyebrow gold">
          {c.round}{c.date && <Fragment> · {`${weekday(c.date)} ${dayMonth(c.date)}`}</Fragment>}
        </p>
        <h1 class="chead__name">{c.name}</h1>
        <div class="chead__meta">
          {c.location && <span>{c.location}</span>}
          {c.format && <span class="pill">{c.format}</span>}
        </div>
      </div>

      <div class="chero">
        <CoursePhoto course={c} photo={hero} loading="eager" ratio="16 / 9" sizes="(max-width: 1160px) 100vw, 1100px" />
      </div>

      <div class="grid tiles cstats">
        {c.par != null && (
          <div class="tile"><div class="tile__k">Par</div><div class="tile__v mono-nums">{c.par}</div></div>
        )}
        {c.yardage != null && (
          <div class="tile"><div class="tile__k">Length</div><div class="tile__v mono-nums">{c.yardage.toLocaleString('en-US')}</div><div class="tile__sub">yards from the back tees</div></div>
        )}
        {c.tee && (c.tee.rating != null || c.tee.slope != null) && (
          <div class="tile tile--gold">
            <div class="tile__k">Rating · Slope</div>
            <div class="tile__v mono-nums">{c.tee.rating ?? '—'}<span class="faint" style="font-size:1rem"> / </span>{c.tee.slope ?? '—'}</div>
            <div class="tile__sub">{c.tee.name} tees{c.tee.yardage != null ? ` · ${yds(c.tee.yardage)}` : ''}</div>
          </div>
        )}
        {c.designer && (
          <div class="tile"><div class="tile__k">Design</div><div class="tile__v cstats__who">{c.designer}</div>{c.opened != null && <div class="tile__sub">Opened {c.opened}</div>}</div>
        )}
      </div>

      {(c.description || c.signature) && (
        <div class="cbody">
          {c.description && (
            <div>
              <div class="section-head"><div><p class="eyebrow">The character</p><h2>What we're walking into</h2></div></div>
              <p class="lede cbody__text">{c.description}</p>
            </div>
          )}
          {c.signature && (
            <aside class="card card--pad csig">
              <p class="eyebrow gold">Signature hole</p>
              <p class="csig__text">{c.signature}</p>
            </aside>
          )}
        </div>
      )}

      <div class="cactions">
        {c.url && <a class="btn btn--terra" href={c.url} target="_blank" rel="noopener">Course website <span aria-hidden="true">↗</span></a>}
        <a class="btn btn--navy" href={`/tournaments/${t.id}#trip`}>Back to the rota <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {rest.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow gold">The album</p><h2>Photos</h2></div><span class="faint">{photos.length} of {c.name}</span></div>
        <PhotoGallery photos={rest} galleryId={`course-${c.slug}`} />
      </div>
    </section>
  )}

  {c.source && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <p class="csource">
          Par, length, rating and slope from <a href={c.source} target="_blank" rel="noopener">{host(c.source)}</a>.
          Ratings are re-issued from time to time — check the pro shop's card before anyone argues about strokes.
        </p>
      </div>
    </section>
  )}
</Base>

<style>
  .chead { margin-top: 1rem; }
  .chead__name { font-size: clamp(2rem, 1.4rem + 3vw, 3.4rem); line-height: 1.02; margin: .35rem 0 .5rem; }
  .chead__meta { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .9rem; color: var(--muted); font-size: .95rem; }

  .chero { margin-top: clamp(1.1rem, 3vw, 1.6rem); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); background: var(--panel-2); }

  /* 140px so the four tiles still pair up two-across on a phone. */
  .cstats { margin-top: clamp(1.1rem, 3vw, 1.6rem); grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  /* a designer credit is words, not a number — it shouldn't wear the stat face */
  .cstats__who { font-family: var(--serif); font-weight: 600; font-size: 1.12rem; line-height: 1.15; margin-top: .4rem; color: var(--text); }

  .cbody { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr); gap: clamp(1.4rem, 4vw, 2.6rem); align-items: start; margin-top: clamp(2rem, 5vw, 3rem); }
  .cbody .section-head { margin-bottom: 1rem; }
  .cbody__text { max-width: 62ch; font-size: clamp(1rem, .95rem + .3vw, 1.12rem); color: var(--text); }
  .csig { border-top: 3px solid var(--gold-bright); background: linear-gradient(180deg, var(--gold-soft), var(--panel)); }
  .csig__text { font-family: var(--serif); font-size: 1.12rem; line-height: 1.35; margin-top: .45rem; }

  .cactions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: clamp(1.6rem, 4vw, 2.4rem); }

  .csource { font-size: .78rem; color: var(--faint); max-width: 70ch; line-height: 1.6; }
  .csource a { color: var(--muted); box-shadow: inset 0 -1px 0 var(--line-strong); }
  .csource a:hover { color: var(--terra-ink); box-shadow: inset 0 -1px 0 var(--terra); }

  @media (max-width: 820px) {
    .cbody { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    /* These names are long — "Desert Willow — Mountain View Course" — so the
       display size comes down rather than stacking into five lines. */
    .chead__name { font-size: clamp(1.7rem, 1.2rem + 2.6vw, 2.3rem); overflow-wrap: break-word; }
    .cstats__who { font-size: 1rem; }
  }
</style>
