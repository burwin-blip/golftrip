---
import Base from '../layouts/Base.astro';
import MatchRow from '../components/MatchRow.astro';
import MatchSummary from '../components/MatchSummary.astro';
import HoleScorecard from '../components/HoleScorecard.astro';
import { matches, players, roundById, getCourse } from '../lib/data.js';
import { normalizeFormat } from '../lib/stats.js';

const all = matches.slice().sort((a, b) => a.number - b.number);
const formatList = [...new Set(all.map((m) => normalizeFormat(m.format)))];
const rounds = [...new Set(all.map((m) => roundById[m.roundId].number))].sort();
const rosterPlayers = players
  .filter((p) => matches.some((m) => m.players.some((mp) => mp.playerId === p.id)))
  .sort((a, b) => a.name.localeCompare(b.name));
---
<Base active="matches" title="All Matches" description="Every match in The Annual, filterable by round, format, team, result and player.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow gold">The Complete Record</p>
      <h1 class="display" style="font-size:clamp(2.1rem,6vw,3.6rem);margin:.3rem 0 .4rem">All matches</h1>
      <p class="lede">Every match ever contested. Filter by session, format, team, result or player.</p>

      <div class="filters card card--pad" role="group" aria-label="Filter matches">
        <label>Round
          <select id="f-round">
            <option value="">All rounds</option>
            {rounds.map((r) => <option value={r}>Round {r}</option>)}
          </select>
        </label>
        <label>Format
          <select id="f-format">
            <option value="">All formats</option>
            {formatList.map((f) => <option value={f}>{f}</option>)}
          </select>
        </label>
        <label>Team
          <select id="f-team">
            <option value="">Both teams</option>
            <option value="woodpeckers">Woodpeckers</option>
            <option value="silver-spoons">Silver Spoons</option>
          </select>
        </label>
        <label>Result
          <select id="f-result">
            <option value="">Any result</option>
            <option value="decisive">Decisive</option>
            <option value="halved">Halved</option>
          </select>
        </label>
        <label>Player
          <select id="f-player">
            <option value="">Any player</option>
            {rosterPlayers.map((p) => <option value={p.id}>{p.name}</option>)}
          </select>
        </label>
        <button id="f-reset" type="button" class="pill">Reset</button>
      </div>

      <p class="filter-count faint" id="count" aria-live="polite"></p>

      <div class="matches" id="match-list">
        {all.map((m) => {
          const rnd = roundById[m.roundId];
          const crs = getCourse(rnd.courseId);
          return (
            <div class="mitem"
              data-round={rnd.number}
              data-format={normalizeFormat(m.format)}
              data-teams={`${m.teamAId} ${m.teamBId}`}
              data-result={m.halved ? 'halved' : 'decisive'}
              data-players={m.players.map((p) => p.playerId).join(' ')}
            >
              <div class="mitem__ctx faint">R{rnd.number} · {rnd.day} · {crs.name}{crs.nine ? ` — ${crs.nine}` : ''} · {m.format}</div>
              <MatchRow match={m} />
              <MatchSummary match={m} />
              <HoleScorecard match={m} />
            </div>
          );
        })}
      </div>
      <p class="no-results muted center" id="empty" hidden>No matches fit those filters. <button type="button" id="f-reset2" class="pill" style="margin-left:.4rem">Reset</button></p>
    </div>
  </section>
</Base>

<style>
  .filters { display:flex; flex-wrap:wrap; gap:.7rem 1rem; align-items:end; margin:1.4rem 0 1rem; }
  .filters label { display:flex; flex-direction:column; gap:.3rem; font-size:.7rem; letter-spacing:.12em; text-transform:uppercase; color:var(--faint); font-weight:600; }
  .filters select { font:inherit; font-size:.9rem; color:var(--text); background:var(--ink-2); border:1px solid var(--line-strong); border-radius:var(--r-sm); padding:.5rem .7rem; min-width:140px; }
  .filters #f-reset { align-self:end; padding:.55rem 1rem; cursor:pointer; }
  .filter-count { font-size:.8rem; margin:.2rem 0 1rem; }
  .mitem__ctx { font-size:.68rem; letter-spacing:.04em; margin:0 0 .3rem .2rem; }
  .mitem + .mitem { margin-top:.55rem; }
</style>

<script is:inline>
  (() => {
    const list = document.getElementById('match-list');
    const items = [...document.querySelectorAll('.mitem')];
    const controls = {
      round: document.getElementById('f-round'),
      format: document.getElementById('f-format'),
      team: document.getElementById('f-team'),
      result: document.getElementById('f-result'),
      player: document.getElementById('f-player'),
    };
    const count = document.getElementById('count');
    const empty = document.getElementById('empty');

    function apply() {
      const f = Object.fromEntries(Object.entries(controls).map(([k, el]) => [k, el.value]));
      let shown = 0;
      for (const it of items) {
        const ok =
          (!f.round || it.dataset.round === f.round) &&
          (!f.format || it.dataset.format === f.format) &&
          (!f.team || it.dataset.teams.includes(f.team)) &&
          (!f.result || it.dataset.result === f.result) &&
          (!f.player || it.dataset.players.split(' ').includes(f.player));
        it.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = `${shown} of ${items.length} matches`;
      empty.hidden = shown !== 0;
    }
    Object.values(controls).forEach((el) => el.addEventListener('change', apply));
    function reset() { Object.values(controls).forEach((el) => (el.value = '')); apply(); }
    document.getElementById('f-reset').addEventListener('click', reset);
    document.getElementById('f-reset2').addEventListener('click', reset);
    apply();
  })();
</script>
