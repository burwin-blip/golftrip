---
// /rsvp/admin#<key> — the organiser's view of every RSVP. UNLINKED BUT PUBLIC BY
// DESIGN: there is no login anywhere on this site. The page itself is an empty
// shell; the data only loads when the key after the # matches RSVP_ADMIN_KEY
// (a Vercel environment variable — never in this public repo). The part after
// the # is never sent to the server or written to logs.
import Base from '../../layouts/Base.astro';
import BrandMark from '../../components/BrandMark.astro';
---
<Base title="RSVP responses" bare>
  <div class="ad wrap">
    <header class="ad-top">
      <a class="ad-brand" href="/"><BrandMark size={26} /><span>The <b>Annual</b></span></a>
      <span class="ad-tag">RSVP admin · 2027</span>
    </header>

    <div id="ad-locked" class="ad-locked" hidden>
      <h1>RSVP responses</h1>
      <p class="muted">Paste your admin key to load the responses.</p>
      <form id="ad-keyform" class="ad-keyform">
        <input id="ad-key" type="password" autocomplete="off" placeholder="Admin key" aria-label="Admin key" />
        <button class="btn btn--terra" type="submit">Load</button>
      </form>
      <p class="ad-err" id="ad-err" role="alert"></p>
    </div>

    <div id="ad-app" hidden>
      <div class="ad-head">
        <div><p class="eyebrow gold">Duel in the Desert 2027</p><h1>RSVP responses</h1></div>
        <div class="ad-actions">
          <span class="faint" id="ad-asof"></span>
          <button class="btn btn--navy" id="ad-refresh" type="button">Refresh</button>
          <button class="btn btn--terra" id="ad-csv" type="button">Export results (CSV)</button>
        </div>
      </div>
      <div class="ad-tiles" id="ad-tiles"></div>

      <section class="ad-sec">
        <h2>Everyone</h2>
        <p class="muted ad-note">Includes everyone who hasn’t replied.</p>
        <div class="table-scroll"><table class="data ad-table" id="ad-table"></table></div>
      </section>

      <section class="ad-sec" id="ad-emails">
        <h2>Backfill emails</h2>
        <p class="muted ad-note">Paste one player per line, e.g. <code>Ed Nelson — ed@example.com</code>. <b>Preview</b> first: only players who already have an RSVP get an email, only on an exact name match (case and spacing aside), and an email a player typed in themselves is never overwritten. Near-misses are listed for you to check, never applied. Nothing is written until you press <b>Apply</b>.</p>
        <textarea id="ad-bf-text" class="ad-bf" rows="8" spellcheck="false" placeholder="Name — email"></textarea>
        <div class="ad-actions" style="margin-top:.6rem">
          <button class="btn btn--navy" id="ad-bf-preview" type="button">Preview</button>
          <button class="btn btn--terra" id="ad-bf-apply" type="button" disabled>Apply</button>
          <span class="faint" id="ad-bf-msg"></span>
        </div>
        <div id="ad-bf-report"></div>
      </section>

      <div class="ad-two">
        <section class="ad-sec">
          <h2>Captain votes</h2>
          <p class="muted ad-note">From YES and MAYBE replies. Everyone can nominate as many captains as they like; each nomination is one vote. “Someone else” write-ins count under the typed name until that person joins via the RSVP, then merge into their tally automatically. Anything unclear is flagged, never guessed. Team names are listed under the captain they were suggested for.</p>
          <div id="ad-captains"></div>
        </section>
        <section class="ad-sec">
          <h2>$250 green fee</h2>
          <p class="muted ad-note">“For one or two rounds, are you okay with a green fee of $250?”</p>
          <div id="ad-q8"></div>
          <h2 style="margin-top:2rem">Longest drive / closest to pin</h2>
          <p class="muted ad-note">“Should we add them for team points? (one course per day)”</p>
          <div id="ad-q9"></div>
        </section>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  .ad-rm { display: block; margin-top: .35rem; padding: .2rem .55rem; border: 0; border-radius: 999px; font-size: .68rem; font-weight: 700; color: var(--faint); background: none; box-shadow: inset 0 0 0 1px var(--line-strong); cursor: pointer; }
  .ad-rm:hover { color: var(--terra-ink); box-shadow: inset 0 0 0 1px var(--terra); }
  .ad-rm.is-armed { color: #fff; background: var(--terra-ink); box-shadow: none; }
  .ad { padding-block: 1rem 4rem; }
  .ad-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: .6rem 1.6rem; }
  .ad-brand { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--serif); font-weight: 600; }
  .ad-brand b { font-weight: 600; color: var(--terra-ink); }
  .ad-tag { font-size: .7rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .ad-locked { max-width: 420px; margin: 12vh auto 0; text-align: center; }
  .ad-locked h1 { font-size: 2rem; margin-bottom: .5rem; }
  .ad-keyform { display: flex; gap: .5rem; margin-top: 1.2rem; }
  .ad-keyform input { flex: 1; min-width: 0; font: inherit; font-size: 16px; padding: .6rem .9rem; border: 0; border-radius: 999px; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  .ad-err { color: var(--terra-ink); font-weight: 600; margin-top: .8rem; min-height: 1.5em; }
  .ad-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.4rem; }
  .ad-head h1 { font-size: clamp(1.8rem, 1.4rem + 2vw, 2.6rem); margin-top: .3rem; }
  .ad-actions { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
  .ad-actions .btn { border: 0; }
  .ad-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: .8rem; }
  .ad-tile { background: var(--panel); border-radius: var(--r); padding: 1rem 1.1rem; box-shadow: var(--shadow); border-top: 3px solid var(--c, var(--line-strong)); }
  .ad-tile b { display: block; font-family: var(--serif); font-size: 2.2rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .ad-tile span { font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .ad-sec { margin-top: 2.6rem; }
  .ad-sec h2 { font-size: 1.4rem; }
  .ad-note { font-size: .85rem; margin: .3rem 0 1rem; }
  .ad-two { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .ad-table td { vertical-align: top; }
  .ad-table .wrapcell { white-space: normal; min-width: 14rem; }
  .ad-table .listcell { line-height: 1.45; }
  .ad-gap { height: .45rem; }
  .ad-st { display: inline-block; padding: .2rem .55rem; border-radius: 99px; font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .ad-st--yes { background: var(--terra); color: #fff; }
  .ad-st--maybe { background: var(--gold-soft); color: var(--gold); }
  .ad-st--no { background: var(--navy-ink); color: var(--navy-text); }
  .ad-st--none { box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--faint); }
  .ad-sub { display: block; font-size: .72rem; color: var(--faint); }
  .ad-bar { display: grid; grid-template-columns: minmax(8rem, 40%) 1fr auto; align-items: center; gap: .7rem; padding: .55rem 0; border-bottom: 1px solid var(--line); }
  .ad-bar__track { height: 10px; border-radius: 99px; background: var(--panel-2); overflow: hidden; }
  .ad-bar__track, .ad-bar__fill { display: block; }
  .ad-bar__fill { height: 100%; background: var(--terra); border-radius: 99px; }
  .ad-bar b { font-variant-numeric: tabular-nums; }
  .ad-cap { background: var(--panel); border-radius: var(--r); box-shadow: var(--shadow); padding: 1rem 1.1rem; margin-bottom: .8rem; }
  .ad-cap__head { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .ad-cap__head h3 { font-size: 1.15rem; }
  .ad-cap__votes { font-weight: 800; color: var(--terra-ink); white-space: nowrap; }
  .ad-cap ul { list-style: none; padding: 0; margin-top: .6rem; display: grid; gap: .35rem; font-size: .9rem; }
  .ad-cap li b { font-family: var(--serif); font-weight: 600; }
  .ad-cap--flag { box-shadow: inset 0 0 0 2px var(--gold-bright), var(--shadow); }
  .ad-tag { display: inline-block; vertical-align: .15em; margin-left: .4rem; font-family: var(--sans); font-size: .62rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); background: var(--panel-2); padding: .15rem .45rem; border-radius: 99px; }
  .ad-flag { margin: .45rem 0 .2rem; padding: .45rem .7rem; border-radius: var(--r-sm); background: var(--gold-soft); color: var(--gold); font-size: .85rem; font-weight: 700; }
  .ad-bf { width: 100%; font: .9rem/1.5 ui-monospace, Menlo, monospace; padding: .7rem .9rem; border: 0; border-radius: var(--r-sm); background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  .ad-rep { margin-top: 1rem; display: grid; gap: .8rem; }
  .ad-rep h3 { font-size: 1rem; margin-bottom: .3rem; }
  .ad-rep ul { margin: 0; padding-left: 1.1rem; font-size: .9rem; line-height: 1.55; }
  .ad-rep__box { background: var(--panel); border-radius: var(--r); box-shadow: var(--shadow); padding: .8rem 1rem; }
  .ad-rep__box--warn { box-shadow: inset 0 0 0 2px var(--gold-bright), var(--shadow); }
  @media (max-width: 760px) { .ad-two { grid-template-columns: 1fr; gap: 0; } }
</style>

<script is:inline>
(() => {
  const $ = (s) => document.querySelector(s);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const key = () => decodeURIComponent(location.hash.replace(/^#/, ''));
  const when = (iso) => iso ? new Date(iso).toLocaleString(undefined, { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) : '';
  const hcp = (n) => n == null ? '' : n < 0 ? '+' + Math.abs(n).toFixed(1) : n.toFixed(1);
  const LABEL = { yes: 'Yes', maybe: 'Maybe', no: 'No' };
  const ORDER = { yes: 0, maybe: 1, no: 2 };
  let data = null;

  async function load() {
    $('#ad-err').textContent = '';
    if (!key()) { $('#ad-locked').hidden = false; $('#ad-app').hidden = true; return; }
    let res, body;
    try { res = await fetch('/api/rsvp-admin', { headers: { 'x-admin-key': key() }, cache: 'no-store' }); body = await res.json(); }
    catch { body = { ok: false, error: 'Couldn’t reach the server.' }; }
    if (!body.ok) { $('#ad-locked').hidden = false; $('#ad-app').hidden = true; $('#ad-err').textContent = body.error; return; }
    data = body;
    $('#ad-locked').hidden = true; $('#ad-app').hidden = false;
    render();
  }

  const bars = (items) => {
    const max = Math.max(1, ...items.map((i) => i.count));
    return items.map((i) => `<div class="ad-bar"><span>${esc(i.label)}</span><span class="ad-bar__track"><span class="ad-bar__fill" style="width:${(i.count / max) * 100}%"></span></span><b>${i.count}</b></div>`).join('');
  };

  function render() {
    const c = data.counts;
    $('#ad-asof').textContent = 'Updated ' + when(data.generatedAt);
    $('#ad-tiles').innerHTML = [
      ['Yes', c.yes, 'var(--terra)'], ['Maybe', c.maybe, 'var(--gold-bright)'], ['No', c.no, 'var(--navy-ink)'],
      ['No reply yet', c.waiting, 'var(--line-strong)'], ['On the list', c.total, 'var(--line-strong)'],
    ].map(([k, v, col]) => `<div class="ad-tile" style="--c:${col}"><b>${v}</b><span>${k}</span></div>`).join('');

    const rows = data.rows.slice().sort((a, b) =>
      (ORDER[a.effectiveStatus] ?? 3) - (ORDER[b.effectiveStatus] ?? 3) || a.name.localeCompare(b.name));
    $('#ad-table').innerHTML = `<thead><tr><th>Player</th><th>RSVP</th><th>Replied</th><th class="num">Handicap</th><th>Date of birth</th><th>Email</th><th>Strongest</th><th>Weakest</th><th>In a sentence</th><th>Captain picks · team names</th><th>$250</th><th>LD / CTP</th></tr></thead><tbody>${rows.map((r) => {
      const st = r.status
        ? `<span class="ad-st ad-st--${r.status}">${LABEL[r.status]}</span>`
        : `<span class="ad-st ad-st--none">No reply</span>`;
      const hist = r.handicapHistory.map((h) => hcp(h.index)).join(' → ');
      const changes = r.statusHistory.length > 1 ? `<span class="ad-sub">${r.statusHistory.map((s) => LABEL[s.status]).join(' → ')}</span>` : '';
      return `<tr>
        <td class="name">${esc(r.name)}${r.created ? '<span class="ad-sub">New via RSVP</span>' : ''}${(r.status || r.created) ? `<button type="button" class="ad-rm" data-rm="${esc(r.id)}" data-name="${esc(r.name)}">Remove</button>` : ''}</td>
        <td>${st}${changes}</td>
        <td>${esc(when(r.submittedAt))}${r.submissions > 1 ? `<span class="ad-sub">${r.submissions} submissions · first ${esc(when(r.firstSubmittedAt))}</span>` : ''}</td>
        <td class="num">${esc(hcp(r.handicapEntering))}${r.handicapHistory.length > 1 ? `<span class="ad-sub">${esc(hist)}</span>` : ''}</td>
        <td>${esc(r.dob || '')}</td>
        <td>${r.email ? `${esc(r.email)}<span class="ad-sub">${esc({ rsvp: 'From the RSVP', update: 'Added later', backfill: 'Backfilled' }[r.emailSource] || '')}${r.emailUpdatedAt ? ' · ' + esc(when(r.emailUpdatedAt)) : ''}</span>` : ''}</td>
        <td class="listcell">${r.strengths.map(esc).join('<br>')}</td>
        <td class="listcell">${r.weaknesses.map(esc).join('<br>')}</td>
        <td class="wrapcell">${esc(r.sentence || '')}</td>
        <td class="listcell">${r.captainVotes.map((v) => `${esc(v.name)}${v.writeIn ? `<span class="ad-sub">${v.id ? `write-in “${esc(v.writeIn)}” → matched` : 'write-in'}${v.flag ? ' · ⚑ check' : ''}</span>` : ''}${v.teamName ? `<span class="ad-sub">“${esc(v.teamName)}”</span>` : ''}`).join('<div class="ad-gap"></div>')}</td>
        <td>${esc(data.greenFee.find((g) => g.key === r.greenFee)?.label || '')}</td>
        <td>${esc(data.longestDrive.find((g) => g.key === r.longestDrive)?.label || '')}</td>
      </tr>`;
    }).join('')}</tbody>`;

    const flagText = (f) => f.kind === 'ambiguous'
      ? `Could be ${f.candidates.map((c) => esc(c.name)).join(' or ')}. Not merged: check who they meant.`
      : `Might be ${f.candidates.map((c) => esc(c.name)).join(' or ')}, or someone new. Not merged: check.`;
    $('#ad-captains').innerHTML = data.captains.length ? data.captains.map((cap) => `
      <div class="ad-cap${cap.flag ? ' ad-cap--flag' : ''}">
        <div class="ad-cap__head"><h3>${esc(cap.name)}${cap.writeIn ? ' <span class="ad-tag">Write-in · not on the site yet</span>' : ''}</h3><span class="ad-cap__votes">${cap.votes} vote${cap.votes === 1 ? '' : 's'}</span></div>
        ${cap.flag ? `<p class="ad-flag">⚑ ${flagText(cap.flag)}</p>` : ''}
        <p class="ad-sub">From ${cap.voters.map(esc).join(', ')}${cap.viaWriteIn ? ` · ${cap.viaWriteIn} of these typed in as “Someone else” and matched` : ''}</p>
        ${cap.teamNames.length ? `<ul>${cap.teamNames.map((t) => `<li><b>${esc(t.name)}</b> <span class="faint">— ${esc(t.by)}</span></li>`).join('')}</ul>` : '<p class="ad-sub" style="margin-top:.5rem">No team names suggested yet.</p>'}
      </div>`).join('') : '<p class="muted">No votes yet.</p>';
    $('#ad-q8').innerHTML = bars(data.greenFee);
    $('#ad-q9').innerHTML = bars(data.longestDrive);
  }

  // "Export results" — every answer for every player (non-replies included) as
  // one CSV, for a spreadsheet. Admin-only: `data` exists only once the key has
  // unlocked the admin API, so nothing here can run on a public page.
  $('#ad-csv').addEventListener('click', () => {
    if (!data) return;
    // Poll answers export as the wording people saw ("Don't care about pricing"),
    // not the stored key; the labels come from the admin API's own tallies.
    const label = (tally, k) => (k == null ? '' : tally.find((x) => x.key === k)?.label ?? k);
    const day = (iso) => (iso ? String(iso).slice(0, 10) : '');
    // lists are joined with "; " so each answer stays in one spreadsheet cell
    const flat = (r) => ({
      ...r,
      status: r.status ?? 'no reply',
      createdViaRsvp: r.created ? 'yes' : '',
      statusHistory: r.statusHistory.map((h) => `${day(h.at)} ${h.status}`).join('; '),
      handicapHistory: r.handicapHistory.map((h) => `${day(h.at)} ${h.index}`).join('; '),
      strengths: r.strengths.join('; '), weaknesses: r.weaknesses.join('; '),
      captains: r.captainVotes.map((v) => v.name + (v.writeIn && !v.id ? ' (write-in)' : v.writeIn ? ` (write-in "${v.writeIn}")` : '') + (v.flag ? ' [check]' : '')).join('; '),
      teams: r.captainVotes.filter((v) => v.teamName).map((v) => `${v.name}: ${v.teamName}`).join('; '),
      greenFee: label(data.greenFee, r.greenFee),
      longestDrive: label(data.longestDrive, r.longestDrive),
    });
    const COLS = [
      ['name', 'Name'], ['id', 'Player id'], ['status', 'RSVP'], ['createdViaRsvp', 'Joined via RSVP'], ['createdAt', 'Joined at'],
      ['firstSubmittedAt', 'First submitted'], ['submittedAt', 'Last submitted'], ['submissions', 'Submissions'], ['statusHistory', 'RSVP history'],
      ['handicapEntering', 'Handicap'], ['handicapHistory', 'Handicap history'], ['dob', 'Date of birth'], ['email', 'Email'],
      ['strengths', 'Strongest parts'], ['weaknesses', 'Weakest parts'], ['sentence', 'One sentence'],
      ['captains', 'Captain picks'], ['teams', 'Team names (by captain)'],
      ['greenFee', 'Q8 $250 green fee'], ['longestDrive', 'Q9 Longest drive / CTP'],
    ];
    const cell = (v) => {
      let s = v == null ? '' : String(v);
      // Typed answers are opened in Excel/Sheets: never let one start a formula.
      // (A plain negative number, e.g. a plus handicap, is left alone.)
      if (/^[=+@\t\r]/.test(s) || (/^-/.test(s) && !/^-\d+(\.\d+)?$/.test(s))) s = `'${s}`;
      return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
    };
    const csv = [COLS.map(([, h]) => cell(h)).join(','), ...data.rows.map(flat).map((r) => COLS.map(([k]) => cell(r[k])).join(','))].join('\r\n');
    const url = URL.createObjectURL(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' })); // BOM: Excel reads it as UTF-8
    const a = document.createElement('a');
    a.href = url;
    a.download = `annual-rsvp-2027-results-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.append(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
  // Remove — clears one player's RSVP, their answers and (if the RSVP created
  // them) the player record itself, then the site rebuilds. For test entries and
  // mistakes. Two taps: the first arms the button, the second (within 5s) deletes.
  document.addEventListener('click', async (e) => {
    const b = e.target.closest('.ad-rm');
    if (!b) return;
    if (!b.dataset.armed) {
      b.dataset.armed = '1';
      b.textContent = `Tap again to remove ${b.dataset.name}`;
      b.classList.add('is-armed');
      setTimeout(() => { if (b.isConnected && b.dataset.armed) { delete b.dataset.armed; b.textContent = 'Remove'; b.classList.remove('is-armed'); } }, 5000);
      return;
    }
    b.disabled = true; b.textContent = 'Removing…';
    try {
      const res = await fetch(`/api/rsvp-admin?player=${encodeURIComponent(b.dataset.rm)}`, { method: 'DELETE', headers: { 'x-admin-key': key() } });
      const body = await res.json().catch(() => ({}));
      if (!res.ok || !body.ok) throw new Error(body.error || `HTTP ${res.status}`);
      await load();
    } catch (err) {
      b.disabled = false; delete b.dataset.armed; b.classList.remove('is-armed');
      b.textContent = `Couldn’t remove: ${err.message}`;
    }
  });
  // ---- Backfill emails (preview → apply) ----
  const parseLines = (text) => text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean).map((l) => {
    const m = l.match(/[^\s<>(),;—–]+@[^\s<>(),;—–]+/);
    if (!m) return { name: l, email: '' };
    const name = l.replace(m[0], '').replace(/[<>()]/g, ' ').replace(/[\s,;:—–-]+$/g, '').replace(/^[\s,;:—–-]+/g, '').trim();
    return { name, email: m[0] };
  });
  let bfEntries = null;
  async function backfill(apply) {
    const entries = apply ? bfEntries : parseLines($('#ad-bf-text').value);
    if (!entries?.length) { $('#ad-bf-msg').textContent = 'Paste the list first.'; return; }
    $('#ad-bf-msg').textContent = apply ? 'Applying…' : 'Checking…';
    let body;
    try {
      const res = await fetch('/api/rsvp-admin', { method: 'POST', headers: { 'content-type': 'application/json', 'x-admin-key': key() }, body: JSON.stringify({ action: 'emails', entries, apply }) });
      body = await res.json();
    } catch { body = { ok: false, error: 'Couldn’t reach the server.' }; }
    if (!body.ok) { $('#ad-bf-msg').textContent = body.error; return; }
    bfEntries = entries;
    const r = body.report, li = (xs, f) => xs.length ? `<ul>${xs.map(f).join('')}</ul>` : '<p class="faint">None.</p>';
    const box = (title, html, warn) => `<div class="ad-rep__box${warn ? ' ad-rep__box--warn' : ''}"><h3>${title}</h3>${html}</div>`;
    $('#ad-bf-report').innerHTML = `<div class="ad-rep">
      ${box(`${apply ? 'Updated' : 'Will update'} (${r.updated.length})`, li(r.updated, (x) => `<li>${esc(x.name)} — ${esc(x.email)}</li>`))}
      ${box(`Already had this email (${r.unchanged.length})`, li(r.unchanged, (x) => `<li>${esc(x.name)}</li>`))}
      ${box(`Conflicts: a different email is already on file, left alone (${r.conflicts.length})`, li(r.conflicts, (x) => `<li>${esc(x.name)}: on file ${esc(x.onFile)}, list says ${esc(x.listed)}</li>`), r.conflicts.length)}
      ${box(`Near-misses: please confirm (${r.nearMisses.length})`, li(r.nearMisses, (x) => `<li>List says “${esc(x.listed)}”, site has ${x.candidates.map((c) => `“${esc(c.name)}”${c.rsvpd ? '' : ' (no RSVP yet)'}`).join(' or ')}. Not applied.</li>`), r.nearMisses.length)}
      ${box(`On the list but no RSVP yet, skipped (${r.noRsvp.length})`, li(r.noRsvp, (x) => `<li>${esc(x.name)}</li>`))}
      ${box(`On the list but not on the site at all (${r.unknown.length})`, li(r.unknown, (x) => `<li>${esc(x.name)}</li>`))}
      ${r.invalid.length ? box(`Lines that couldn’t be read (${r.invalid.length})`, li(r.invalid, (x) => `<li>${esc(x.name)} ${esc(x.email)}</li>`), true) : ''}
      ${box(`RSVP’d players not matched by the list (${r.rsvpdWithoutEntry.length} of ${body.rsvpdCount})`, li(r.rsvpdWithoutEntry, (x) => `<li>${esc(x.name)}${x.hasEmail ? ' (already has an email)' : ''}${x.nearListNames.length ? ` · close to “${x.nearListNames.map(esc).join('”, “')}”` : ''}</li>`), r.rsvpdWithoutEntry.some((x) => !x.hasEmail))}
    </div>`;
    $('#ad-bf-apply').disabled = apply || !r.updated.length;
    $('#ad-bf-msg').textContent = apply ? `Done. ${r.updated.length} email${r.updated.length === 1 ? '' : 's'} added.` : 'Preview only. Nothing written yet.';
    if (apply) await load();
  }
  $('#ad-bf-preview').addEventListener('click', () => backfill(false));
  $('#ad-bf-apply').addEventListener('click', () => backfill(true));
  $('#ad-bf-text').addEventListener('input', () => { $('#ad-bf-apply').disabled = true; bfEntries = null; });

  $('#ad-refresh').addEventListener('click', load);
  $('#ad-keyform').addEventListener('submit', (e) => { e.preventDefault(); location.hash = encodeURIComponent($('#ad-key').value.trim()); });
  window.addEventListener('hashchange', load);
  load();
})();
</script>
