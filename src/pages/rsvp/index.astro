---
// /rsvp — THE PERMANENT RSVP URL. It is printed as a QR code on the invitations,
// so this path must never change, whatever happens to the implementation.
//
// A static page (like every page on the site) that posts to /api/rsvp. The
// player list, the captain list and the handicap pre-fills are baked in at
// build time; anything newer (players created since the last build, the live
// confirmed count, a returning player's public answers) comes from the API.
// Private answers (DOB, Q6–Q9) are only ever pre-filled from THIS device's
// localStorage — never from the server — because anyone can tap anyone's name.
import Base from '../../layouts/Base.astro';
import BrandMark from '../../components/BrandMark.astro';
import PlayerPortrait from '../../components/PlayerPortrait.astro';
import { players, tournamentById } from '../../lib/data.js';
import { draftPoolFor, handicapCheckInList } from '../../lib/stats.js';
import { dateRange } from '../../lib/format.js';
import {
  RSVP_TOURNAMENT_ID as TID, GAME_PARTS, GREEN_FEE_ANSWERS, SIDE_GAME_ANSWERS, LIMITS,
} from '../../lib/rsvp-shared.js';

const t = tournamentById[TID];
const byName = (a, b) => a.name.localeCompare(b.name);
const roster = players.slice().sort(byName);
const latestIndex = Object.fromEntries(handicapCheckInList().map((r) => [r.player.id, r.index]));
// Captain nominees = the current 2027 pool (confirmed + waiting on; a NO is out).
const nominees = draftPoolFor(TID).map((p) => ({ id: p.player.id, name: p.player.name })).sort(byName);

const clientData = {
  tid: TID,
  poolUrl: `/tournaments/${TID}#pool`,
  players: roster.map((p) => ({ id: p.id, name: p.name, hcp: latestIndex[p.id] ?? null })),
  nominees,
  greenFee: GREEN_FEE_ANSWERS,
  sideGame: SIDE_GAME_ANSWERS,
  limits: LIMITS,
};

const STEPS = [
  { id: 'who', label: 'You' },
  { id: 'rsvp', label: 'RSVP' },
  { id: 'game', label: 'Your game' },
  { id: 'event', label: '2027' },
  { id: 'review', label: 'Review' },
];
---
<Base title="RSVP for 2027" description={`RSVP for ${t.name} — ${dateRange(t.startDate, t.endDate)}.`} bare>
  <div class="rv" id="rv" data-step="open">
    <header class="rv-top">
      <a class="rv-brand" href="/" aria-label="The Annual — home"><BrandMark size={28} /><span>The <b>Annual</b></span></a>
      <span class="rv-top__meta" id="rv-stepmeta" aria-live="polite"></span>
    </header>

    <ol class="rv-steps" id="rv-steps" aria-label="Progress" hidden>
      {STEPS.map((s) => <li data-step-dot={s.id}><i></i><span>{s.label}</span></li>)}
    </ol>

    <!-- 0 · OPENING -->
    <section class="rv-screen rv-open is-active" data-screen="open" aria-labelledby="rv-open-h">
      <figure class="rv-open__art">
        <img src="/next-trip-2027.png" width="848" height="1200" alt={`The ${t.name} invitation — ${t.location}, ${dateRange(t.startDate, t.endDate)}`} fetchpriority="high" />
      </figure>
      <div class="rv-open__copy">
        <p class="eyebrow gold">The Annual · Edition {t.edition}</p>
        <h1 class="rv-open__h" id="rv-open-h">RSVP for 2027</h1>
        <p class="rv-open__when">{dateRange(t.startDate, t.endDate)}</p>
        <p class="rv-open__where">{t.location}</p>
        <button type="button" class="rv-btn rv-btn--go rv-open__go" data-go="who">Start my RSVP</button>
        <p class="rv-open__fine">Five short steps, about two minutes. Change your answers any time at this same link.</p>
      </div>
    </section>

    <form id="rv-form" novalidate autocomplete="off">
      <!-- 1 · WHO -->
      <section class="rv-screen" data-screen="who" aria-labelledby="rv-who-h">
        <h2 class="rv-h" id="rv-who-h" tabindex="-1">Who are you?</h2>
        <p class="rv-sub">Tap your card. New to The Annual? Choose “I’m not listed”.</p>
        <div class="rv-faces" id="rv-faces" role="radiogroup" aria-label="Pick yourself">
          {roster.map((p) => (
            <label class="rv-face">
              <input type="radio" name="playerId" value={p.id} />
              <span class="rv-face__frame"><PlayerPortrait player={p} sizes="(max-width: 560px) 30vw, 150px" /></span>
              <span class="rv-face__name">{p.name}</span>
            </label>
          ))}
          <label class="rv-face rv-face--new">
            <input type="radio" name="playerId" value="__new" />
            <span class="rv-face__frame rv-face__frame--new" aria-hidden="true"><span>+</span></span>
            <span class="rv-face__name">I’m not listed</span>
          </label>
        </div>
        <div class="rv-field rv-newname" id="rv-newname" hidden>
          <label for="rv-newName" class="rv-label">Your full name</label>
          <input id="rv-newName" name="newName" type="text" class="rv-input" autocomplete="name" autocapitalize="words" maxlength={LIMITS.name} placeholder="First and last name" />
          <p class="rv-hint">You’ll join the field as a 2027 rookie.</p>
        </div>
        <p class="rv-err" data-err="playerId newName" role="alert"></p>
        <p class="rv-note" id="rv-samename" role="status" hidden></p>
      </section>

      <!-- 2 · RSVP -->
      <section class="rv-screen" data-screen="rsvp" aria-labelledby="rv-rsvp-h">
        <h2 class="rv-h" id="rv-rsvp-h" tabindex="-1"><span data-first></span>, are you in?</h2>
        <p class="rv-sub">{dateRange(t.startDate, t.endDate)} · {t.location}</p>
        <div class="rv-rsvp" role="radiogroup" aria-label="Your RSVP">
          <label class="rv-big rv-big--yes"><input type="radio" name="status" value="yes" /><b>Yes — I’m in</b><span>Put me in the draft pool.</span></label>
          <label class="rv-big rv-big--maybe"><input type="radio" name="status" value="maybe" /><b>Maybe — not sure yet</b><span>Hold a spot. I’ll confirm later.</span></label>
          <label class="rv-big rv-big--no"><input type="radio" name="status" value="no" /><b>No — can’t make it</b><span>Count me out this year.</span></label>
        </div>
        <p class="rv-err" data-err="status" role="alert"></p>
      </section>

      <!-- 3 · YOUR GAME (permanent player profile) -->
      <section class="rv-screen" data-screen="game" aria-labelledby="rv-game-h">
        <h2 class="rv-h" id="rv-game-h" tabindex="-1">Your game</h2>
        <p class="rv-sub">Your strengths, weaknesses and one-liner go on your player profile. Your date of birth stays private.</p>

        <div class="rv-field">
          <label for="rv-dob" class="rv-label">Date of birth <span class="rv-private">Private</span></label>
          <input id="rv-dob" name="dob" type="date" class="rv-input rv-input--date" min="1920-01-01" />
          <p class="rv-err" data-err="dob" role="alert"></p>
        </div>

        <div class="rv-field">
          <label for="rv-hcp" class="rv-label">Current handicap</label>
          <div class="rv-hcprow">
            <input id="rv-hcp" name="handicap" type="text" inputmode="decimal" class="rv-input rv-input--num" placeholder="e.g. 12.4" maxlength="4" />
            <label class="rv-check"><input type="checkbox" name="hcpPlus" /><span>It’s a plus handicap</span></label>
          </div>
          <p class="rv-hint">Your handicap index today. Decimals are fine. No official handicap? Give your best guess.</p>
          <p class="rv-err" data-err="handicap" role="alert"></p>
        </div>

        <fieldset class="rv-field">
          <legend class="rv-label">Strongest parts of your game <span class="rv-label__aside">Pick as many as apply</span></legend>
          <div class="rv-chips">
            {GAME_PARTS.map((g) => <label class="rv-chip"><input type="checkbox" name="strengths" value={g} /><span>{g}</span></label>)}
          </div>
          <p class="rv-err" data-err="strengths" role="alert"></p>
        </fieldset>

        <fieldset class="rv-field">
          <legend class="rv-label">Weakest parts of your game <span class="rv-label__aside">Pick as many as apply</span></legend>
          <div class="rv-chips">
            {GAME_PARTS.map((g) => <label class="rv-chip rv-chip--down"><input type="checkbox" name="weaknesses" value={g} /><span>{g}</span></label>)}
          </div>
          <p class="rv-err" data-err="weaknesses" role="alert"></p>
        </fieldset>

        <div class="rv-field">
          <label for="rv-sentence" class="rv-label">Describe your golf game in a sentence</label>
          <textarea id="rv-sentence" name="sentence" class="rv-input rv-input--area" rows="3" maxlength={LIMITS.sentence} placeholder="Long off the tee, allergic to three-footers…"></textarea>
          <p class="rv-err" data-err="sentence" role="alert"></p>
        </div>
      </section>

      <!-- 4 · 2027 QUESTIONS (event data; private) -->
      <section class="rv-screen" data-screen="event" aria-labelledby="rv-event-h">
        <h2 class="rv-h" id="rv-event-h" tabindex="-1">The 2027 questions</h2>
        <p class="rv-sub">These stay private. Only the organiser sees them.</p>

        <fieldset class="rv-field">
          <legend class="rv-label">Who would you nominate as captains? <span class="rv-label__aside">Pick as many as you like.</span></legend>
          <div class="rv-chips rv-chips--names" id="rv-nominees">
            {nominees.map((n) => <label class="rv-chip"><input type="checkbox" name="captainVoteIds" value={n.id} /><span>{n.name}</span></label>)}
            <button type="button" class="rv-chip rv-chip--add" id="rv-addwritein"><span>+ Someone else</span></button>
          </div>
          <!-- "Someone else": typed names, for blokes not on the site yet (drawn by the script) -->
          <div class="rv-writeins" id="rv-writeins"></div>
          <p class="rv-note" id="rv-writein-note" role="status" hidden></p>
          <p class="rv-err" data-err="captainVoteIds captainWriteIns" role="alert"></p>
        </fieldset>

        <!-- one optional team-name field per captain picked above (drawn by the script) -->
        <div class="rv-teams" id="rv-teams"></div>
        <p class="rv-err" data-err="teamNames" role="alert"></p>

        <fieldset class="rv-field">
          <legend class="rv-label">For one or two rounds, are you okay with a green fee of $250?</legend>
          <div class="rv-chips">
            {Object.entries(GREEN_FEE_ANSWERS).map(([k, v]) => <label class="rv-chip"><input type="radio" name="greenFee" value={k} /><span>{v}</span></label>)}
          </div>
          <p class="rv-err" data-err="greenFee" role="alert"></p>
        </fieldset>

        <fieldset class="rv-field">
          <legend class="rv-label">Should we add longest drive and closest to the pin for team points? <span class="rv-label__aside">(one course per day)</span></legend>
          <div class="rv-chips">
            {Object.entries(SIDE_GAME_ANSWERS).map(([k, v]) => <label class="rv-chip"><input type="radio" name="longestDrive" value={k} /><span>{v}</span></label>)}
          </div>
          <p class="rv-err" data-err="longestDrive" role="alert"></p>
        </fieldset>
      </section>

      <!-- 5 · REVIEW -->
      <section class="rv-screen" data-screen="review" aria-labelledby="rv-review-h">
        <h2 class="rv-h" id="rv-review-h" tabindex="-1">Check and send</h2>
        <p class="rv-sub">Tap Edit to change anything.</p>
        <div class="rv-review" id="rv-review"></div>
        <p class="rv-err rv-err--send" data-err="_form" role="alert"></p>
      </section>
    </form>

    <!-- DONE — never repeats their answers back -->
    <section class="rv-screen rv-done" data-screen="done" aria-live="polite">
      <div class="rv-done__inner" id="rv-done"></div>
    </section>

    <nav class="rv-bar" id="rv-bar" aria-label="Form navigation" hidden>
      <button type="button" class="rv-btn rv-btn--back" id="rv-back">Back</button>
      <button type="button" class="rv-btn rv-btn--go" id="rv-next">Continue</button>
    </nav>
  </div>

  <script type="application/json" id="rv-data" set:html={JSON.stringify(clientData)} />
</Base>

<style is:global>
  /* the flow owns the viewport: no page chrome, the sticky bar sits on the thumb */
  .rv {
    --rv-w: 560px;
    min-height: 100vh; min-height: 100dvh;
    max-width: var(--rv-w); margin-inline: auto;
    padding: 0 var(--gutter) calc(6.5rem + env(safe-area-inset-bottom));
    display: flex; flex-direction: column;
  }
  .rv[data-step="open"], .rv[data-step="done"] { padding-bottom: calc(2.5rem + env(safe-area-inset-bottom)); }

  .rv-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: calc(.9rem + env(safe-area-inset-top)) 0 .9rem; }
  .rv-brand { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--serif); font-weight: 600; font-size: 1.02rem; }
  .rv-brand b { font-weight: 600; color: var(--terra-ink); }
  .rv-top__meta { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); }

  /* progress — five labelled segments; the order is the order you answer in */
  .rv-steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: .35rem; margin-bottom: 1.6rem; }
  .rv-steps li { display: flex; flex-direction: column; gap: .4rem; min-width: 0; }
  .rv-steps i { display: block; height: 4px; border-radius: 99px; background: var(--line-strong); transition: background .3s var(--ease); }
  .rv-steps span { font-size: .64rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rv-steps .is-done i { background: var(--navy-ink); }
  .rv-steps .is-current i { background: var(--terra); }
  .rv-steps .is-current span { color: var(--terra-ink); }
  .rv-steps .is-done span { color: var(--muted); }
  .rv-steps .is-skipped i { background: repeating-linear-gradient(90deg, var(--line-strong) 0 4px, transparent 4px 7px); }
  .rv-steps .is-skipped span { text-decoration: line-through; }

  .rv-screen { display: none; }
  .rv-steps[hidden], .rv-bar[hidden], .rv-newname[hidden] { display: none; }
  .rv-screen.is-active { display: block; animation: rv-in .45s var(--ease) both; }
  @keyframes rv-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .rv-h { font-size: clamp(1.8rem, 1.4rem + 2.2vw, 2.4rem); line-height: 1.02; outline: none; }
  .rv-sub { color: var(--muted); margin: .55rem 0 1.5rem; font-size: .95rem; }

  /* ---- opening: the invitation on the table ---- */
  .rv-open.is-active { display: grid; gap: clamp(1.4rem, 5vw, 2.2rem); justify-items: center; text-align: center; padding-top: .4rem; }
  .rv-open__art { width: min(56vw, 34vh, 330px); transform: rotate(-2.2deg); border-radius: 6px; overflow: hidden; box-shadow: 0 2px 3px rgba(12,27,44,.12), 0 28px 50px -22px rgba(12,27,44,.55); animation: rv-deal .9s var(--ease) both; }
  .rv-open__art img { width: 100%; height: auto; }
  @keyframes rv-deal { from { opacity: 0; transform: translateY(24px) rotate(2deg) scale(.96); } to { opacity: 1; transform: rotate(-2.2deg); } }
  .rv-open__copy { display: flex; flex-direction: column; align-items: center; }
  .rv-open__h { font-size: clamp(2.4rem, 1.8rem + 4vw, 3.6rem); letter-spacing: -.02em; margin: .4rem 0 .5rem; }
  .rv-open__when { font-family: var(--sans); font-weight: 800; font-size: 1.05rem; letter-spacing: .14em; text-transform: uppercase; color: var(--navy-ink); font-variant-numeric: tabular-nums; }
  .rv-open__where { color: var(--muted); font-size: .92rem; margin-top: .2rem; }
  .rv-open__go { margin-top: 1.3rem; min-width: min(100%, 300px); justify-content: center; }
  .rv-open__fine { color: var(--faint); font-size: .8rem; margin-top: .9rem; max-width: 34ch; }

  /* ---- buttons + sticky bar ---- */
  .rv-btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 52px; padding: .8rem 1.4rem; border: 0; border-radius: 999px; font-weight: 800; font-size: 1rem; letter-spacing: .01em; transition: transform .15s var(--ease), filter .15s var(--ease), opacity .15s; }
  .rv-btn:active { transform: scale(.98); }
  .rv-btn--go { background: var(--terra); color: #fff; box-shadow: 0 10px 22px -10px color-mix(in srgb, var(--terra) 85%, transparent); }
  .rv-btn--go:hover { filter: brightness(1.05); }
  .rv-btn--go[disabled] { opacity: .6; cursor: progress; }
  .rv-btn--back { background: transparent; color: var(--muted); box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  .rv-btn--navy { background: var(--navy-ink); color: var(--navy-text); }
  .rv-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; gap: .7rem; justify-content: center; padding: .8rem var(--gutter) calc(.8rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--cream) 90%, transparent); backdrop-filter: blur(12px); border-top: 1px solid var(--line); }
  .rv-bar .rv-btn--back { flex: 0 0 auto; min-width: 96px; }
  .rv-bar .rv-btn--go { flex: 1; max-width: calc(var(--rv-w) - 96px - 2 * var(--gutter)); }

  /* ---- who: the wall of faces, at thumb size ---- */
  .rv-faces { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
  .rv-face { position: relative; display: flex; flex-direction: column; gap: .4rem; cursor: pointer; }
  .rv-face input, .rv-chip input, .rv-big input { position: absolute; opacity: 0; pointer-events: none; }
  .rv-face__frame { position: relative; display: block; border-radius: var(--r-sm); overflow: hidden; box-shadow: var(--shadow); transition: transform .18s var(--ease), box-shadow .18s var(--ease); }
  .rv-face__frame::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 0 var(--terra); transition: box-shadow .18s var(--ease); }
  .rv-face__name { font-size: .8rem; font-weight: 700; line-height: 1.15; color: var(--muted); }
  .rv-face input:checked + .rv-face__frame { transform: translateY(-2px); }
  .rv-face input:checked + .rv-face__frame::after { box-shadow: inset 0 0 0 3px var(--terra); }
  .rv-face input:checked ~ .rv-face__name { color: var(--terra-ink); }
  .rv-face input:focus-visible + .rv-face__frame { outline: 2px solid var(--terra); outline-offset: 3px; }
  .rv-face__frame--new, .rv-face__frame--init { aspect-ratio: 4 / 5; display: grid; place-items: center; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  .rv-face__frame--new span { font-family: var(--serif); font-size: 2.4rem; color: var(--terra); line-height: 1; }
  .rv-face__frame--init { background: linear-gradient(180deg, #EFC095, #F9E4C6); box-shadow: none; }
  .rv-face__frame--init span { font-family: var(--serif); font-weight: 600; font-size: 1.6rem; color: var(--navy-ink); }
  .rv-newname { margin-top: 1.3rem; }
  .rv-teams:empty { display: none; }
  .rv-chip--add { border: 0; padding: 0; background: none; font: inherit; }
  .rv-chip--add span { color: var(--terra-ink); box-shadow: inset 0 0 0 1.5px var(--terra); background: transparent; }
  .rv-writeins { display: grid; gap: .6rem; margin-top: .8rem; }
  .rv-writeins:empty { display: none; }
  .rv-writein { display: flex; gap: .5rem; align-items: center; }
  .rv-writein .rv-input { flex: 1; min-width: 0; }
  .rv-writein__rm { flex: none; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-strong); color: var(--muted); font-size: 1.1rem; line-height: 1; }

  /* ---- fields ---- */
  .rv-field { border: 0; padding: 0; margin: 0 0 1.7rem; min-width: 0; }
  .rv-label { display: block; font-weight: 700; font-size: 1rem; line-height: 1.3; color: var(--text); margin-bottom: .6rem; padding: 0; }
  .rv-label__aside { font-weight: 500; color: var(--muted); }
  .rv-private { display: inline-block; vertical-align: .1em; margin-left: .35rem; font-size: .6rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--navy-ink); background: color-mix(in srgb, var(--navy-ink) 9%, transparent); padding: .18rem .45rem; border-radius: 99px; }
  .rv-input { width: 100%; font: inherit; font-size: 16px; /* 16px stops iOS zooming in */ color: var(--text); background: var(--paper); border: 0; border-radius: var(--r-sm); padding: .85rem 1rem; box-shadow: inset 0 0 0 1.5px var(--line-strong); transition: box-shadow .15s var(--ease); -webkit-appearance: none; appearance: none; }
  .rv-input:focus { outline: none; box-shadow: inset 0 0 0 2px var(--terra); }
  .rv-hcprow { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .rv-check { display: inline-flex; align-items: center; gap: .5rem; font-size: .9rem; color: var(--muted); cursor: pointer; min-height: 44px; }
  .rv-check input { width: 1.25rem; height: 1.25rem; accent-color: var(--terra); }
  .rv-input--num { max-width: 8rem; font-variant-numeric: tabular-nums; font-weight: 700; font-size: 1.15rem; }
  .rv-input--date { max-width: 14rem; min-height: 3.1rem; }
  .rv-input--area { resize: vertical; min-height: 5.5rem; line-height: 1.45; }
  .rv-input[aria-invalid="true"] { box-shadow: inset 0 0 0 2px var(--terra-ink); }
  .rv-hint { font-size: .8rem; color: var(--faint); margin-top: .45rem; }
  .rv-note { margin-top: .8rem; padding: .7rem .9rem; border-radius: var(--r-sm); background: var(--terra-soft); color: var(--terra-ink); font-size: .88rem; font-weight: 600; }
  .rv-note[hidden] { display: none; }
  .rv-err { font-size: .85rem; font-weight: 600; color: var(--terra-ink); margin-top: .5rem; }
  .rv-err:empty { display: none; }
  .rv-err--send { padding: .9rem 1rem; border-radius: var(--r-sm); background: var(--terra-soft); margin-top: 1rem; }

  /* single-select chips */
  .rv-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .rv-chip { position: relative; cursor: pointer; }
  .rv-chip span { display: inline-flex; align-items: center; min-height: 44px; padding: .55rem 1rem; border-radius: 999px; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-strong); font-weight: 600; font-size: .92rem; color: var(--text); transition: background .15s var(--ease), color .15s var(--ease), box-shadow .15s var(--ease); }
  .rv-chip input:checked + span { background: var(--terra); color: #fff; box-shadow: none; }
  .rv-chip--down input:checked + span { background: var(--navy-ink); color: var(--navy-text); }
  .rv-chip input:focus-visible + span { outline: 2px solid var(--terra); outline-offset: 2px; }
  .rv-chip input:disabled + span { opacity: .35; cursor: not-allowed; }

  /* the three RSVP answers — big targets, each with its own voice */
  .rv-rsvp { display: grid; gap: .75rem; }
  .rv-big { position: relative; display: flex; flex-direction: column; gap: .2rem; padding: 1.15rem 1.25rem 1.15rem 3.4rem; border-radius: var(--r); background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-strong); cursor: pointer; transition: box-shadow .15s var(--ease), background .15s var(--ease), transform .15s var(--ease); }
  .rv-big::before { content: ''; position: absolute; left: 1.2rem; top: 1.35rem; width: 1.2rem; height: 1.2rem; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--line-strong); transition: box-shadow .15s var(--ease); }
  .rv-big b { font-family: var(--sans); font-weight: 800; font-size: 1.02rem; letter-spacing: .06em; text-transform: uppercase; }
  .rv-big span { color: var(--muted); font-size: .9rem; }
  .rv-big:has(input:checked) { background: #fff; box-shadow: inset 0 0 0 2.5px var(--rv-c), var(--shadow); }
  .rv-big:has(input:checked)::before { box-shadow: inset 0 0 0 6px var(--rv-c); }
  .rv-big:has(input:focus-visible) { outline: 2px solid var(--terra); outline-offset: 3px; }
  .rv-big--yes { --rv-c: var(--terra); }
  .rv-big--maybe { --rv-c: var(--gold-bright); }
  .rv-big--no { --rv-c: var(--navy-line); }

  /* review */
  .rv-review { display: grid; gap: .9rem; }
  .rv-rev { background: var(--paper); border-radius: var(--r); box-shadow: var(--shadow); padding: 1rem 1.15rem; }
  .rv-rev__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: .5rem; }
  .rv-rev__head h3 { font-size: .72rem; font-family: var(--sans); font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--terra-ink); }
  .rv-rev__edit { background: none; border: 0; padding: .35rem .2rem; font-weight: 700; font-size: .85rem; color: var(--navy-ink); text-decoration: underline; text-underline-offset: 3px; }
  .rv-rev dl { display: grid; grid-template-columns: minmax(0, 42%) 1fr; gap: .45rem .9rem; font-size: .92rem; }
  .rv-rev dt { color: var(--muted); }
  .rv-rev dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .rv-rev__skip { color: var(--muted); font-size: .9rem; }

  /* ---- done ---- */
  .rv-done.is-active { display: flex; flex: 1; align-items: center; }
  .rv-done__inner { width: 100%; text-align: center; display: flex; flex-direction: column; align-items: center; padding-block: 1rem 2rem; }
  .rv-stamp { width: min(46vw, 190px); height: auto; color: var(--terra); margin-bottom: 1.1rem; animation: rv-stamp .6s cubic-bezier(.2, 1.4, .4, 1) .15s both; }
  .rv-stamp--maybe { color: var(--gold-bright); }
  .rv-stamp--no { color: var(--navy-line); }
  @keyframes rv-stamp { from { opacity: 0; transform: scale(1.5) rotate(-18deg); } to { opacity: 1; transform: scale(1) rotate(-8deg); } }
  .rv-done__h { font-family: var(--serif); font-weight: 700; font-size: clamp(3rem, 2rem + 7vw, 4.8rem); line-height: .92; letter-spacing: -.03em; text-transform: uppercase; color: var(--navy-ink); }
  .rv-done__h--yes { color: var(--terra-ink); }
  .rv-done__lede { font-size: 1.08rem; color: var(--muted); margin: .9rem 0 0; max-width: 32ch; }
  .rv-count { display: flex; align-items: baseline; justify-content: center; gap: .55rem; margin: 1.6rem 0 .2rem; padding: .85rem 1.3rem; border-radius: var(--r); background: var(--navy-ink); color: var(--navy-text); }
  .rv-count b { font-family: var(--serif); font-weight: 600; font-size: 2.2rem; line-height: 1; font-variant-numeric: tabular-nums; color: #fff; }
  .rv-count span { font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .rv-done__actions { display: flex; flex-direction: column; gap: .7rem; align-items: stretch; width: min(100%, 320px); margin-top: 1.6rem; }
  .rv-done__fine { font-size: .82rem; color: var(--faint); margin-top: 1.2rem; max-width: 34ch; }

  /* ======================================================================
     WIDER SCREENS. Everything above is the phone layout and must stay exactly
     as it is; every rule below only ever applies from 720px up. The invite
     email sends people to a browser, so desktop is the showcase.
     ====================================================================== */

  /* tablet: a wider column, four faces a row, the short questions paired */
  @media (min-width: 720px) {
    .rv { --rv-w: 720px; }
    .rv-faces { grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .rv-newname { max-width: 30rem; }
    .rv-review { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
    .rv-screen[data-screen="event"].is-active { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
    .rv-screen[data-screen="event"].is-active > :not(fieldset:nth-last-of-type(-n+2)) { grid-column: 1 / -1; }
    /* the paired questions: same-height legends so their answers line up */
    .rv-screen[data-screen="event"] fieldset:nth-last-of-type(-n+2) > .rv-label { min-height: 2.6em; }
  }

  @media (min-width: 900px) {
    .rv[data-step="open"] { --rv-w: 980px; }
    .rv-open.is-active { grid-template-columns: auto 1fr; justify-items: start; text-align: left; align-items: center; gap: 4rem; padding-top: 3vh; }
    .rv-open__copy { align-items: flex-start; }
    .rv-open__art { width: 340px; }
  }

  /* desktop: the site's full content width, laid out for a big screen */
  @media (min-width: 1024px) {
    .rv { --rv-w: var(--maxw); padding-bottom: calc(8rem + env(safe-area-inset-bottom)); }
    .rv[data-step="open"] { --rv-w: 1060px; }
    .rv-top { padding-block: 1.4rem 1.2rem; }
    .rv-brand { font-size: 1.2rem; }
    .rv-top__meta { font-size: .8rem; }

    /* progress: taller bars, readable labels */
    .rv-steps { gap: .7rem; margin-bottom: 2.6rem; }
    .rv-steps i { height: 6px; }
    .rv-steps span { font-size: .78rem; letter-spacing: .1em; }

    .rv-h { font-size: clamp(2.6rem, 1.6rem + 1.8vw, 3.4rem); }
    .rv-sub { font-size: 1.1rem; margin: .7rem 0 2.2rem; max-width: 60ch; }

    /* who: the wall of faces fills the screen */
    .rv-faces { grid-template-columns: repeat(5, 1fr); gap: 1.4rem 1.2rem; }
    .rv-face__name { font-size: .95rem; }
    .rv-face__frame { transition: transform .18s var(--ease), box-shadow .18s var(--ease); }
    .rv-face:hover .rv-face__frame { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
    .rv-face__frame--new span { font-size: 3.2rem; }
    .rv-face__frame--init span { font-size: 2.2rem; }

    /* rsvp: the three answers side by side */
    .rv-rsvp { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
    .rv-big { min-height: 8.5rem; padding: 1.5rem 1.5rem 1.5rem 3.8rem; justify-content: center; }
    .rv-big::before { top: 50%; margin-top: -.6rem; left: 1.4rem; }
    .rv-big:hover { transform: translateY(-2px); }

    /* your game: two columns — dob | handicap, strongest | weakest, sentence across */
    .rv-screen[data-screen="game"].is-active { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 4vw, 3.5rem); }
    .rv-screen[data-screen="game"].is-active > :is(h2, .rv-sub, .rv-field:last-child) { grid-column: 1 / -1; }
    .rv-input--area { max-width: 52rem; }
    .rv-chips { gap: .6rem; }
    .rv-chip span { font-size: .98rem; padding: .6rem 1.15rem; }
    .rv-chip span:hover { box-shadow: inset 0 0 0 1.5px var(--terra); }
    .rv-chip input:checked + span:hover { box-shadow: none; }

    /* 2027: captains spread out as an even grid of name chips */
    .rv-chips--names { display: grid; grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr)); }
    .rv-chips--names .rv-chip span { width: 100%; }
    .rv-writeins { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 52rem; }
    .rv-screen[data-screen="event"].is-active { column-gap: clamp(2rem, 4vw, 3.5rem); }
    .rv-teams { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }

    /* review: airy two-up cards */
    .rv-review { gap: 1.2rem; }
    .rv-rev { padding: 1.4rem 1.6rem; }
    .rv-rev dl { font-size: 1rem; gap: .6rem 1.2rem; }

    /* the sticky bar: buttons sized for a mouse, not stretched across the screen */
    .rv-bar { padding-block: 1rem calc(1rem + env(safe-area-inset-bottom)); }
    .rv-bar .rv-btn--go { max-width: 380px; }
    .rv-bar .rv-btn--back { min-width: 130px; }
  }
  @media (min-width: 1240px) {
    .rv-faces { grid-template-columns: repeat(6, 1fr); }
  }
  @media (max-width: 360px) {
    .rv-faces { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script is:inline>
(() => {
  const DATA = JSON.parse(document.getElementById('rv-data').textContent);
  const $ = (s, el = document) => el.querySelector(s);
  const $$ = (s, el = document) => [...el.querySelectorAll(s)];
  const root = $('#rv'), form = $('#rv-form'), bar = $('#rv-bar');
  const nextBtn = $('#rv-next'), backBtn = $('#rv-back');
  const ORDER = ['open', 'who', 'rsvp', 'game', 'event', 'review', 'done'];
  const FORM_STEPS = ['who', 'rsvp', 'game', 'event', 'review'];
  const LABELS = { who: 'You', rsvp: 'RSVP', game: 'Your game', event: '2027', review: 'Review' };
  const PRIVATE = ['dob', 'captainVoteIds', 'teamNames', 'captainWriteIns', 'greenFee', 'longestDrive'];
  const store = {   // this device only — may be unavailable (private mode), so never required
    get(id) { try { return JSON.parse(localStorage.getItem('annual-rsvp:' + id) || 'null'); } catch { return null; } },
    set(id, v) { try { localStorage.setItem('annual-rsvp:' + id, JSON.stringify(v)); } catch {} },
  };

  let step = 'open';
  let players = DATA.players.slice();
  let prefilledFor = null;

  const val = (name) => {
    const els = form.elements[name];
    if (!els) return '';
    if (els instanceof RadioNodeList) return els.value;
    return els.value.trim();
  };
  // multi-select groups (checkboxes): the ticked values, in page order
  const group = (name) => [...form.querySelectorAll(`input[name="${name}"]`)];
  const vals = (name) => group(name).filter((i) => i.checked).map((i) => i.value);
  const setVals = (name, list) => { const want = new Set(list || []); group(name).forEach((i) => (i.checked = want.has(i.value))); };
  const teamDraft = {};   // typed team names, kept while captains are ticked / unticked (write-ins keyed 'w:<uid>')
  let writeIns = [];      // "Someone else" rows: { uid, name }
  let wuid = 0;
  // Same rule as the server's matchPlayerName, 'match' case only: full name, or a
  // first name only one nominee has. A clean match ticks that player's chip.
  const nk = (s) => String(s || '').normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/['’.]/g, '').replace(/[^a-z]+/g, ' ').trim();
  const nomineeFor = (typed) => {
    const k = nk(typed); if (!k) return null;
    const full = DATA.nominees.filter((n) => nk(n.name) === k);
    if (full.length === 1) return full[0];
    if (!full.length && !k.includes(' ')) { const f = DATA.nominees.filter((n) => nk(n.name).split(' ')[0] === k); if (f.length === 1) return f[0]; }
    return null;
  };
  const namedWriteIns = () => writeIns.filter((w) => w.name.trim());
  const setVal = (name, v) => {
    const els = form.elements[name];
    if (!els || v == null) return;
    if (els instanceof RadioNodeList) { for (const r of els) r.checked = r.value === String(v); }
    else els.value = v;
  };
  const who = () => {
    const id = val('playerId');
    if (id === '__new') { const n = val('newName'); return { id: null, name: n, first: n.split(/\s+/)[0] || 'You' }; }
    const p = players.find((x) => x.id === id);
    return p ? { id: p.id, name: p.name, first: p.name.split(' ')[0] } : null;
  };
  const skipsEvent = () => val('status') === 'no';
  const isPlus = () => form.elements.hcpPlus.checked;
  const hcpOut = () => (isPlus() ? '+' : '') + val('handicap').replace(',', '.');
  const setHcp = (n) => { if (n == null) return; setVal('handicap', Math.abs(n).toFixed(1)); form.elements.hcpPlus.checked = n < 0; };

  // Bring an element into view, reliably: smooth first, then — if that got
  // cancelled (this site's global smooth scroll can drop one mid-layout, and a
  // background tab never runs it) — jump there.
  const reveal = (el) => {
    if (!el) return;
    el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    setTimeout(() => {
      const r = el.getBoundingClientRect();
      const barTop = bar.hidden ? innerHeight : bar.getBoundingClientRect().top;
      if (r.top < 0 || r.bottom > barTop) el.scrollIntoView({ block: 'center', behavior: 'instant' });
    }, 450);
  };

  // ---- errors ----
  const clearErrors = () => { $$('.rv-err').forEach((e) => (e.textContent = '')); $$('[aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid')); };
  const showError = (field, msg) => {
    const box = $$('.rv-err').find((e) => (e.dataset.err || '').split(' ').includes(field)) || $('[data-err="_form"]');
    box.textContent = msg;
    const input = form.elements[field];
    if (input && !(input instanceof RadioNodeList)) { input.setAttribute('aria-invalid', 'true'); }
    reveal(box);
  };
  const stepOfField = (f) => ({ playerId: 'who', newName: 'who', status: 'rsvp', dob: 'game', handicap: 'game', strengths: 'game', weaknesses: 'game', sentence: 'game', captainVoteIds: 'event', captainWriteIns: 'event', teamNames: 'event', greenFee: 'event', longestDrive: 'event' }[f] || 'review');

  // ---- per-step validation (the server re-checks everything) ----
  function validate(s) {
    clearErrors();
    const e = (f, m) => { showError(f, m); return false; };
    if (s === 'who') {
      if (!val('playerId')) return e('playerId', 'Tap your card, or choose “I’m not listed”.');
      if (val('playerId') === '__new') {
        const n = val('newName').replace(/\s+/g, ' ');
        if (n.split(' ').filter(Boolean).length < 2) return e('newName', 'Enter your first and last name.');
        // Already on the list? (A veteran who missed their face, or a rookie who
        // RSVP'd earlier.) Select their card rather than start a second player:
        // the server would attach it to them anyway, but say so, visibly.
        const key = (x) => x.toLowerCase().normalize('NFKD').replace(/[^a-z]/g, '');
        const match = players.find((p) => key(p.name) === key(n));
        if (match) {
          setVal('playerId', match.id);
          $('#rv-newname').hidden = true;
          const note = $('#rv-samename');
          note.textContent = `You’re already on the list as ${match.name}. We’ve selected your card. Tap Continue.`;
          note.hidden = false;
          const tile = form.querySelector(`input[name="playerId"][value="${CSS.escape(match.id)}"]`)?.closest('.rv-face');
          reveal(tile || note);
          return false;
        }
      }
    }
    if (s === 'rsvp' && !val('status')) return e('status', 'Choose Yes, Maybe or No.');
    if (s === 'game') {
      const dob = val('dob');
      if (!dob) return e('dob', 'Enter your date of birth.');
      if (dob > form.elements.dob.max || dob < '1920-01-01') return e('dob', 'That date of birth doesn’t look right.');
      const h = val('handicap').replace(',', '.');
      if (!h) return e('handicap', 'Enter your current handicap.');
      if (!/^\d{1,2}(\.\d+)?$/.test(h)) return e('handicap', 'Use a number like 12.4.');
      const n = parseFloat(h);
      if (n > DATA.limits.hcpMax || (isPlus() && n > -DATA.limits.hcpMin)) return e('handicap', 'That handicap looks out of range.');
      if (!vals('strengths').length) return e('strengths', 'Pick at least one strongest part.');
      if (!vals('weaknesses').length) return e('weaknesses', 'Pick at least one weakest part.');
    }
    if (s === 'event') {
      if (!vals('captainVoteIds').length && !namedWriteIns().length) return e('captainVoteIds', 'Pick at least one captain, or add someone else.');
      if (namedWriteIns().some((w) => !/\p{L}/u.test(w.name))) return e('captainWriteIns', 'Type a name for each “Someone else”, or remove the empty one.');
      if (!val('greenFee')) return e('greenFee', 'Answer the green-fee question.');
      if (!val('longestDrive')) return e('longestDrive', 'Answer the longest-drive question.');
    }
    return true;
  }

  // ---- navigation ----
  function show(s, { push = true } = {}) {
    step = s;
    root.dataset.step = s;
    $$('.rv-screen').forEach((el) => el.classList.toggle('is-active', el.dataset.screen === s));
    const inForm = FORM_STEPS.includes(s);
    $('#rv-steps').hidden = !inForm;
    bar.hidden = !inForm;
    const visible = FORM_STEPS.filter((x) => !(x === 'event' && skipsEvent()));
    const idx = visible.indexOf(s);
    $('#rv-stepmeta').textContent = inForm ? `Step ${idx + 1} of ${visible.length}` : s === 'open' ? 'RSVP · 2027' : '';
    $$('[data-step-dot]').forEach((li) => {
      const id = li.dataset.stepDot;
      const skipped = id === 'event' && skipsEvent();
      li.className = skipped ? 'is-skipped' : id === s ? 'is-current' : visible.indexOf(id) < idx ? 'is-done' : '';
    });
    nextBtn.textContent = s === 'review' ? 'Send my RSVP' : 'Continue';
    if (s === 'review') renderReview();
    const f = who();
    $$('[data-first]').forEach((el) => (el.textContent = f ? f.first : 'You'));
    if (push) history.pushState({ rv: s }, '', s === 'open' ? location.pathname : '#' + s);
    window.scrollTo({ top: 0 });
    const h = $(`[data-screen="${s}"] .rv-h`);
    if (h) h.focus({ preventScroll: true });
  }
  const neighbour = (dir) => {
    let i = ORDER.indexOf(step) + dir;
    if (ORDER[i] === 'event' && skipsEvent()) i += dir;
    return ORDER[i];
  };

  nextBtn.addEventListener('click', async () => {
    if (step === 'review') return submit();
    if (!validate(step)) return;
    if (step === 'who') await prefill();
    show(neighbour(1));
  });
  backBtn.addEventListener('click', () => { clearErrors(); show(neighbour(-1) || 'open'); });
  $$('[data-go]').forEach((b) => b.addEventListener('click', () => show(b.dataset.go)));
  window.addEventListener('popstate', (e) => {
    const s = e.state?.rv || 'open';
    if (s === 'done') return;                       // never re-open a sent form via Back
    show(ORDER.includes(s) ? s : 'open', { push: false });
  });
  history.replaceState({ rv: 'open' }, '', location.pathname);

  // "I'm not listed" reveals the name field
  form.addEventListener('change', (e) => {
    if (e.target.name === 'playerId') {
      const isNew = e.target.value === '__new';
      $('#rv-newname').hidden = !isNew;
      if (isNew) {
        // On a phone this tile sits at the bottom of the wall, so the name box it
        // reveals lands below the fold (and under the sticky bar). Focus it inside
        // this same tap (iOS only raises the keyboard then) and scroll it to the
        // middle of the screen, so the tap visibly does something.
        const box = $('#rv-newName');
        box.focus({ preventScroll: true });
        reveal(box);
      }
      $('#rv-samename').hidden = true;
      clearErrors();
    }
    // a part of your game can't be both strongest and weakest
    if (e.target.name === 'strengths' || e.target.name === 'weaknesses') syncParts();
    if (e.target.name === 'captainVoteIds') { syncCaptains(); clearErrors(); }
    // a write-in that is clearly someone on the list: tick them instead
    if (e.target.dataset.writein) {
      const w = writeIns.find((x) => String(x.uid) === e.target.dataset.writein);
      const n = w && nomineeFor(w.name);
      if (n) {
        setVals('captainVoteIds', [...new Set([...vals('captainVoteIds'), n.id])]);
        if (teamDraft['w:' + w.uid] && !teamDraft[n.id]) teamDraft[n.id] = teamDraft['w:' + w.uid];
        writeIns = writeIns.filter((x) => x !== w);
        const note = $('#rv-writein-note');
        note.textContent = `${n.name} is on the list — we’ve ticked him instead.`;
        note.hidden = false;
        drawWriteIns(); syncCaptains();
      }
    }
  });
  form.addEventListener('input', (e) => {
    if (e.target.dataset.captain) teamDraft[e.target.dataset.captain] = e.target.value;
    if (e.target.dataset.writein) {
      const w = writeIns.find((x) => String(x.uid) === e.target.dataset.writein);
      if (w) { w.name = e.target.value; syncCaptains(); }
    }
  });
  // "Someone else": a new name box each tap, each removable
  $('#rv-addwritein').addEventListener('click', () => {
    if (writeIns.length >= DATA.limits.maxWriteIns) return;
    const w = { uid: ++wuid, name: '' };
    writeIns.push(w);
    $('#rv-writein-note').hidden = true;
    drawWriteIns();
    const box = form.querySelector(`[data-writein="${w.uid}"]`);
    box.focus({ preventScroll: true }); reveal(box);
    clearErrors();
  });
  $('#rv-writeins').addEventListener('click', (e) => {
    const b = e.target.closest('[data-rm-writein]');
    if (!b) return;
    writeIns = writeIns.filter((x) => String(x.uid) !== b.dataset.rmWritein);
    delete teamDraft['w:' + b.dataset.rmWritein];
    drawWriteIns(); syncCaptains();
  });
  function drawWriteIns() {
    $('#rv-writeins').innerHTML = writeIns.map((w) => `<div class="rv-writein">
        <input type="text" class="rv-input" data-writein="${w.uid}" value="${esc(w.name)}" maxlength="${DATA.limits.name}" autocapitalize="words" autocomplete="off" placeholder="Their name, e.g. Harry Smith" aria-label="Someone else’s name" />
        <button type="button" class="rv-writein__rm" data-rm-writein="${w.uid}" aria-label="Remove this name">✕</button>
      </div>`).join('');
    $('#rv-addwritein span').textContent = writeIns.length ? '+ Add another name' : '+ Someone else';
  }

  // a part of your game can't be both a strength and a weakness: whatever is
  // ticked on one side is greyed out on the other
  function syncParts() {
    const s = new Set(vals('strengths')), w = new Set(vals('weaknesses'));
    group('strengths').forEach((i) => (i.disabled = w.has(i.value)));
    group('weaknesses').forEach((i) => (i.disabled = s.has(i.value)));
  }
  // as many captains as they like; every nominee — ticked or written in — gets
  // their own optional team-name field
  function syncCaptains() {
    const field = (key, name) => `<div class="rv-field"><label class="rv-label" for="rv-team-${esc(key.replace(':', '-'))}">What would ${esc(name.trim().split(/\s+/)[0])}’s team name be? <span class="rv-label__aside">Optional</span></label>
        <input id="rv-team-${esc(key.replace(':', '-'))}" data-captain="${esc(key)}" type="text" class="rv-input" maxlength="${DATA.limits.teamName}" value="${esc(teamDraft[key] || '')}" /></div>`;
    $('#rv-teams').innerHTML = [
      ...vals('captainVoteIds').map((id) => field(id, DATA.nominees.find((x) => x.id === id)?.name || id)),
      ...namedWriteIns().map((w) => field('w:' + w.uid, w.name)),
    ].join('');
  }
  const teamNamesOut = () => Object.fromEntries(vals('captainVoteIds').map((id) => [id, (teamDraft[id] || '').trim()]).filter(([, v]) => v));
  const writeInsOut = () => namedWriteIns().map((w) => {
    const t = (teamDraft['w:' + w.uid] || '').trim();
    return t ? { name: w.name.trim(), teamName: t } : { name: w.name.trim() };
  });



  // ---- pre-fill: public answers from the server, private ones from this device ----
  async function prefill() {
    const id = val('playerId');
    if (id === '__new' || id === prefilledFor) return;
    prefilledFor = id;
    const p = players.find((x) => x.id === id);
    ['status', 'dob', 'handicap', 'strengths', 'weaknesses', 'sentence', 'captainVoteIds', 'greenFee', 'longestDrive'].forEach((k) => {
      const inputs = group(k);
      if (inputs.length && (inputs[0].type === 'radio' || inputs[0].type === 'checkbox')) inputs.forEach((r) => { r.checked = false; r.disabled = false; });
      else if (form.elements[k]) form.elements[k].value = '';
    });
    for (const k in teamDraft) delete teamDraft[k];
    writeIns = []; drawWriteIns(); $('#rv-writein-note').hidden = true;
    form.elements.hcpPlus.checked = false;
    if (p?.hcp != null) setHcp(p.hcp);
    nextBtn.disabled = true;
    try {
      const r = await fetch('/api/rsvp?player=' + encodeURIComponent(id), { cache: 'no-store' });
      if (r.ok) {
        const { player } = await r.json();
        if (player) {
          setVal('status', player.status);
          if (player.handicap != null) setHcp(player.handicap);
          setVals('strengths', player.strengths);
          setVals('weaknesses', player.weaknesses);
          setVal('sentence', player.sentence);
        }
      }
    } catch {}
    finally { nextBtn.disabled = false; }
    const mine = store.get(id);
    if (mine) {
      setVal('dob', mine.dob); setVal('greenFee', mine.greenFee); setVal('longestDrive', mine.longestDrive);
      // saved by the first version of the form: one captain + one team name
      const caps = mine.captainVoteIds || (mine.captainVoteId ? [mine.captainVoteId] : []);
      const names = mine.teamNames || (mine.captainVoteId && mine.teamName ? { [mine.captainVoteId]: mine.teamName } : {});
      setVals('captainVoteIds', caps.filter((c) => DATA.nominees.some((n) => n.id === c)));
      Object.assign(teamDraft, names);
      for (const w of mine.captainWriteIns || []) {
        const uid = ++wuid;
        writeIns.push({ uid, name: w.name });
        if (w.teamName) teamDraft['w:' + uid] = w.teamName;
      }
      drawWriteIns();
    }
    syncParts(); syncCaptains();
  }

  // ---- review ----
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const STATUS = { yes: 'Yes — I’m in', maybe: 'Maybe — not sure yet', no: 'No — can’t make it' };
  const fmtDob = (d) => d ? new Date(d + 'T00:00:00').toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' }) : '—';
  function renderReview() {
    const f = who();
    const nameOf = (id) => DATA.nominees.find((n) => n.id === id)?.name || id;
    const caps = vals('captainVoteIds'), teams = teamNamesOut();
    const block = (title, target, rows) => `
      <section class="rv-rev"><div class="rv-rev__head"><h3>${title}</h3><button type="button" class="rv-rev__edit" data-edit="${target}">Edit</button></div>
      <dl>${rows.map(([k, v]) => `<dt>${k}</dt><dd>${esc(v) || '—'}</dd>`).join('')}</dl></section>`;
    let html = block('You', 'who', [['Name', f?.name + (val('playerId') === '__new' ? ' (new)' : '')]]);
    html += block('RSVP', 'rsvp', [['2027', STATUS[val('status')]]]);
    html += block('Your game', 'game', [
      ['Date of birth', fmtDob(val('dob'))], ['Handicap', hcpOut()],
      ['Strongest', vals('strengths').join(', ')], ['Weakest', vals('weaknesses').join(', ')], ['In a sentence', val('sentence')],
    ]);
    html += skipsEvent()
      ? `<section class="rv-rev"><div class="rv-rev__head"><h3>2027 questions</h3></div><p class="rv-rev__skip">Skipped, because you can’t make it.</p></section>`
      : block('2027 questions', 'event', [
          ...(() => {
            const picks = [
              ...caps.map((id) => nameOf(id) + (teams[id] ? ` — “${teams[id]}”` : '')),
              ...writeInsOut().map((w) => `${w.name} (someone else)` + (w.teamName ? ` — “${w.teamName}”` : '')),
            ];
            return picks.map((p, i) => [picks.length > 1 ? `Captain pick ${i + 1}` : 'Captain pick', p]);
          })(),
          ['$250 green fee', DATA.greenFee[val('greenFee')]], ['Longest drive / closest to pin', DATA.sideGame[val('longestDrive')]],
        ]);
    $('#rv-review').innerHTML = html;
    $$('[data-edit]').forEach((b) => b.addEventListener('click', () => show(b.dataset.edit)));
  }

  // ---- submit ----
  async function submit() {
    clearErrors();
    // re-run every visible step's checks before sending
    for (const s of FORM_STEPS.slice(0, 4)) {
      if (s === 'event' && skipsEvent()) continue;
      if (!validate(s)) { show(s); validate(s); return; }
    }
    const body = {
      status: val('status'), dob: val('dob'), handicap: hcpOut(),
      strengths: vals('strengths'), weaknesses: vals('weaknesses'), sentence: val('sentence'),
    };
    if (val('playerId') === '__new') body.newName = val('newName'); else body.playerId = val('playerId');
    if (!skipsEvent()) Object.assign(body, { captainVoteIds: vals('captainVoteIds'), teamNames: teamNamesOut(), captainWriteIns: writeInsOut(), greenFee: val('greenFee'), longestDrive: val('longestDrive') });

    nextBtn.disabled = true; nextBtn.textContent = 'Sending…';
    let res, data;
    try {
      res = await fetch('/api/rsvp', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      data = await res.json();
    } catch {
      data = { ok: false, error: 'Couldn’t reach the server. Check your signal and tap Send again.' };
    }
    nextBtn.disabled = false; nextBtn.textContent = 'Send my RSVP';
    if (!data?.ok) {
      const field = data?.field;
      if (field && stepOfField(field) !== 'review') { show(stepOfField(field)); showError(field, data.error); }
      else showError('_form', data?.error || 'That didn’t send. Tap Send again.');
      return;
    }
    const priv = {};
    PRIVATE.forEach((k) => (priv[k] = body[k] ?? null));
    store.set(data.playerId, priv);
    // remembered on this device so the homepage can say "You're in"
    try { localStorage.setItem('annual-rsvp:last', JSON.stringify({ status: data.status, at: Date.now() })); } catch {}
    renderDone(data);
    show('done', { push: false });
    history.replaceState({ rv: 'done' }, '', location.pathname + '#done');
  }

  // ---- done: never shows their answers back ----
  const stamp = (kind, word) => `
    <svg class="rv-stamp rv-stamp--${kind}" viewBox="0 0 200 200" aria-hidden="true">
      <defs><path id="rv-ring" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0" /></defs>
      <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="5" />
      <circle cx="100" cy="100" r="54" fill="none" stroke="currentColor" stroke-width="2.5" />
      <text style="font-family:var(--sans)" font-weight="800" font-size="12.5" fill="currentColor"><textPath href="#rv-ring" textLength="446" lengthAdjust="spacing">THE ANNUAL · DUEL IN THE DESERT · 2027 ·</textPath></text>
      <text x="100" y="${word.length > 6 ? 108 : 110}" text-anchor="middle" style="font-family:var(--serif)" font-weight="700" font-size="${word.length > 6 ? 17 : 24}" fill="currentColor">${word}</text>
    </svg>`;
  function renderDone(d) {
    const first = d.name.split(' ')[0];
    const count = `<p class="rv-count"><b>${d.confirmedCount}</b><span>player${d.confirmedCount === 1 ? '' : 's'} confirmed</span></p>`;
    const again = `<p class="rv-done__fine">Plans change? Come back to this link any time. Your answers update; they don’t double up.</p>`;
    let html;
    if (d.status === 'yes') {
      html = `${stamp('yes', 'IN')}
        <h2 class="rv-done__h rv-done__h--yes">You’re in.</h2>
        <p class="rv-done__lede">See you in the desert, ${esc(first)}.</p>${count}
        <div class="rv-done__actions"><a class="rv-btn rv-btn--go" href="${DATA.poolUrl}">See the 2027 page</a></div>
        <p class="rv-done__fine">You’ll show up in the Draft Pool within a couple of minutes.</p>${again}`;
    } else if (d.status === 'maybe') {
      html = `${stamp('maybe', 'MAYBE')}
        <h2 class="rv-done__h">Pencilled in.</h2>
        <p class="rv-done__lede">We’ll hold a spot, ${esc(first)}. Come back to this link and switch to yes once you know.</p>${count}
        <div class="rv-done__actions"><a class="rv-btn rv-btn--navy" href="${DATA.poolUrl}">See who’s going</a></div>${again}`;
    } else {
      html = `${stamp('no', 'NEXT YEAR')}
        <h2 class="rv-done__h">Next time, then.</h2>
        <p class="rv-done__lede">Sorry you can’t make the desert, ${esc(first)}. If that changes, come back to this link and switch to yes.</p>
        <div class="rv-done__actions"><a class="rv-btn rv-btn--navy" href="/">Back to The Annual</a></div>`;
    }
    $('#rv-done').innerHTML = html;
  }

  // ---- players added since the last build (so a brand-new name finds themselves again) ----
  const initials = (n) => n.split(' ').map((w) => w[0]).join('').slice(0, 2).toUpperCase();
  fetch('/api/rsvp', { cache: 'no-store' }).then((r) => r.ok ? r.json() : null).then((d) => {
    if (!d?.createdPlayers) return;
    const newTile = $('.rv-face--new');
    for (const p of d.createdPlayers) {
      if (players.some((x) => x.id === p.id)) continue;
      players.push({ id: p.id, name: p.name, hcp: null });
      const label = document.createElement('label');
      label.className = 'rv-face';
      label.innerHTML = `<input type="radio" name="playerId" value="${esc(p.id)}" /><span class="rv-face__frame rv-face__frame--init" aria-hidden="true"><span>${esc(initials(p.name))}</span></span><span class="rv-face__name">${esc(p.name)}</span>`;
      newTile.before(label);
    }
  }).catch(() => {});

  // date of birth: at least 12 years ago
  const max = new Date(); max.setFullYear(max.getFullYear() - 12);
  form.elements.dob.max = max.toISOString().slice(0, 10);
  // Enter in a text field moves on rather than submitting the form
  form.addEventListener('submit', (e) => { e.preventDefault(); nextBtn.click(); });
})();
</script>
