---
import Base from '../../layouts/Base.astro';
import TournamentCompleted from '../../components/TournamentCompleted.astro';
import TournamentUpcoming from '../../components/TournamentUpcoming.astro';
import { tournaments } from '../../lib/data.js';

export function getStaticPaths() {
  return tournaments.map((t) => ({ params: { id: t.id }, props: { t } }));
}
const { t } = Astro.props;
const upcoming = t.status === 'upcoming';
const desc = upcoming
  ? `Upcoming — ${t.name}, ${t.location} (${t.startDate}). Draft pool and guide.`
  : `Full scoreboard, stats and analytics — ${t.name}. Final: ${t.finalScore}.`;
---
<Base active={t.id} title={t.name} description={desc}>
  {upcoming ? <TournamentUpcoming t={t} /> : <TournamentCompleted t={t} />}
</Base>
