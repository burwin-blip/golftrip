---
import Base from '../layouts/Base.astro';
import Scorebug from '../components/Scorebug.astro';
import TeamLogo from '../components/TeamLogo.astro';
import { latestTournament, tournamentStandings, upcomingTournaments } from '../lib/stats.js';
import { teamById, playerById, matchesForTournament } from '../lib/data.js';
import { fullName, dateRange, num } from '../lib/format.js';

const t = latestTournament();
const nextEvent = upcomingTournaments()[0] || null;
const city = t.location.split(',')[0].trim(); // "St George, Utah" -> "St George"
const champMatch = matchesForTournament(t.id).find((m) => /championship/i.test(m.format));
const st = tournamentStandings(t.id);
const teams = t.teams; // [woodpeckers, silver-spoons]
const ptsOf = (id) => st.teams.find((x) => x.team.id === id).points;
const champTeam = teamById[st.winnerTeamId];
const champPlayer = playerById[t.championPlayerId];
const bright = { woodpeckers: 'var(--wp-bright)', 'silver-spoons': 'var(--ss-bright)' };

// App-style section tiles — every section findable in one glance.
const tiles = [
  { href: '/matches', k: 'Scorecards', d: 'Every match, hole by hole', icon: 'flag' },
  { href: `/tournaments/${t.id}#stats`, k: 'Stats', d: 'Leaderboards & analytics', icon: 'chart' },
  { href: '/records', k: 'Records', d: 'Honour boards & marks to beat', icon: 'trophy' },
];
// Crafted line-icons (stroke follows currentColor).
const ICONS = {
  flag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 21V4"/><path d="M6 4.5c3-1.6 5 1.2 8 0 2-.8 3.5-.3 4 .2v8c-.9-.6-2.4-1-4-.2-3 1.2-5-1.6-8 0"/></svg>',
  chart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><rect x="6" y="11" width="3" height="6" rx="1"/><rect x="11" y="7" width="3" height="10" rx="1"/><rect x="16" y="13" width="3" height="4" rx="1"/></svg>',
  trophy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3"/><path d="M10 15v2.5M14 15v2.5M8 20h8M9 20l.5-2.5h5L15 20"/></svg>',
};

// Next trip — details pulled from the 2027 flyer / upcoming tournament.
const next = {
  destination: 'Palm Springs, California',
  dates: 'March 25–28, 2027',
  flyer: '/next-trip-2027.jpg',
  flyerFull: '/next-trip-2027.png',
  href: nextEvent ? `/tournaments/${nextEvent.id}` : null,
};
---
<Base active="home" title={null} description="The official home of the annual boys' golf trip.">

  <!-- 1 · HERO — the banner poster (title + tagline are in the art) + scoreboard -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__banner reveal" data-d="0">
        <h1 class="hero__mark">
          <img class="hero__img" src="/hero-banner.jpg" width="1586" height="858"
               alt="The Annual — the official home of the annual boys' golf trip"
               fetchpriority="high" decoding="async" />
        </h1>
        <p class="hero__results">{t.year} Results · {city}</p>
      </div>

      <div class="hero__board reveal" data-d="1">
        <Scorebug
          aId={teams[0].id} bId={teams[1].id}
          aScore={ptsOf(teams[0].id)} bScore={ptsOf(teams[1].id)}
          winnerId={st.winnerTeamId}
          aMeta={`Captain · ${fullName(teams[0].captainId)}`}
          bMeta={`Captain · ${fullName(teams[1].captainId)}`}
          tag={`Final · ${t.pointsAvailable} pts`}
          big={true}
        />
        <div class="hero-underbug">
          <a class="btn btn--navy" href={`/tournaments/${t.id}`}>{t.name} <span aria-hidden="true">→</span></a>
          <span class="faint">{dateRange(t.startDate, t.endDate)} · {t.location}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · SECTION TILES -->
  <section class="section" style="padding-top:clamp(1.4rem,4vw,2.2rem)">
    <div class="wrap">
      <div class="tiles-grid">
        {tiles.map((tl) => (
          <a class="ntile" href={tl.href}>
            <span class="ntile__ic" set:html={ICONS[tl.icon]} />
            <span class="ntile__k">{tl.k}</span>
            <span class="ntile__d">{tl.d}</span>
            <span class="ntile__go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · AWARDS -->
  <section class="section home-sec">
    <div class="wrap">
      <div class="home-head">
        <p class="eyebrow gold home-tag">Awards · {t.year}</p>
        <h2>The silverware</h2>
      </div>
      <div class="grid champ-grid">
        <a class="card card--pad champ" href={`/tournaments/${t.id}#awards`} style={`--accent:${champTeam.color};--accent-bright:${bright[champTeam.id]}`}>
          <p class="eyebrow">Team Champions · {t.year}</p>
          <div class="champ__title"><TeamLogo teamId={champTeam.id} size={44} /><span>{champTeam.name}</span></div>
          <p class="muted">Won the inaugural edition, {t.finalScore}. Captained by {fullName(champTeam.captainId)}.</p>
        </a>
        <a class="card card--pad champ champ--gold" href={`/players/${champPlayer.slug}`}>
          <p class="eyebrow gold">Champion Golfer · {t.year}</p>
          <div class="champ__title gold">{champPlayer.name}</div>
          <p class="muted">Took the Individual Championship {champMatch.margin} in the Sunday singles finale at Falcon Ridge.</p>
        </a>
      </div>
      <p class="faint home-morelink"><a href={`/tournaments/${t.id}#awards`}>See all {t.year} awards, including the dishonours →</a></p>
    </div>
  </section>

  <!-- 4 · NEXT TRIP -->
  <section class="section band">
    <div class="wrap">
      <div class="home-head">
        <p class="eyebrow gold home-tag" style="margin-bottom:0">Next trip · 2027</p>
      </div>
      <div class="next-grid">
        <div class="next-copy">
          <p class="eyebrow">The desert calls</p>
          <p class="next-dest">{next.destination}</p>
          <p class="next-dates mono-nums">{next.dates}</p>
          <p class="muted" style="margin-top:.9rem">The second edition heads for the desert — four days of golf under the San Jacinto mountains, a fresh draft, and a new trophy on the line.</p>
          <div class="chips" style="margin-top:1.1rem">
            {next.href && <a class="btn btn--terra" href={next.href}>View the 2027 event <span aria-hidden="true">→</span></a>}
            <span class="pill">To be contested</span>
          </div>
        </div>
        <a class="flyer" href={next.flyerFull} target="_blank" rel="noopener" aria-label="View the 2027 trip flyer full size">
          <img src={next.flyer} width="480" height="680" alt={`The 2027 trip — ${next.destination}, ${next.dates}`} loading="lazy" decoding="async" />
          <span class="flyer__cue">⤢ Enlarge</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<div class="lightbox" id="lightbox" hidden aria-hidden="true">
  <img id="lightbox-img" src="" alt="" />
</div>

<style>
  /* ---- HERO — the sunset banner poster ---- */
  .hero { padding-top: clamp(1.2rem, 3vw, 2rem); }
  .hero__banner { position: relative; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  .hero__mark { margin: 0; line-height: 0; }
  .hero__img { width: 100%; height: auto; display: block; }
  /* auto-updating results line sits where the banner's baked strip was —
     terracotta on the flat navy dune (a dark, uncluttered area → strong contrast) */
  .hero__results { position: absolute; left: clamp(1rem, 3.6vw, 2.5rem); bottom: clamp(.6rem, 2.4vw, 1.4rem); z-index: 1;
    font-family: var(--sans); font-weight: 800; font-size: clamp(.6rem, .48rem + 1vw, 1.02rem);
    letter-spacing: .16em; text-transform: uppercase; color: var(--terra-bright); text-shadow: 0 1px 12px rgba(12,27,44,.7); }

  .hero__board { position: relative; z-index: 2; margin-top: clamp(1rem, 2.4vw, 1.6rem); }
  .hero-underbug { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem 1rem; margin-top: 1rem; font-size: .85rem; }

  /* ---- app-style tiles ---- */
  .tiles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.7rem, 1.6vw, 1rem); }
  .ntile { display: flex; flex-direction: column; gap: .3rem; padding: clamp(1.1rem,3vw,1.5rem); background: var(--panel); border-radius: var(--r); box-shadow: var(--shadow); position: relative; overflow: hidden; transition: transform .2s var(--ease), box-shadow .2s var(--ease); }
  .ntile::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--terra); transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease); }
  .ntile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .ntile:hover::after { transform: scaleX(1); }
  .ntile__ic { color: var(--navy-ink); }
  .ntile__ic :global(svg) { width: 28px; height: 28px; display: block; }
  .ntile__k { font-family: var(--serif); font-weight: 600; font-size: 1.28rem; margin-top: .5rem; }
  .ntile__d { font-size: .82rem; color: var(--muted); }
  .ntile__go { position: absolute; top: clamp(1.1rem,3vw,1.5rem); right: clamp(1.1rem,3vw,1.5rem); color: var(--faint); font-weight: 800; transition: color .2s var(--ease), transform .2s var(--ease); }
  .ntile:hover .ntile__go { color: var(--terra); transform: translateX(3px); }

  /* ---- awards ---- */
  .home-sec { }
  .home-tag { margin-bottom: 1rem; }
  .home-head { margin-bottom: 1.4rem; }
  .home-head h2 { font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2.1rem); margin-top: .1rem; }
  .champ-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .champ__title { display: flex; align-items: center; gap: .6rem; font-family: var(--serif); font-weight: 600; font-size: clamp(1.4rem, 1rem + 2vw, 2rem); margin: .5rem 0 .6rem; }
  .champ { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent), var(--shadow); }
  .champ--gold { background: linear-gradient(180deg, var(--gold-soft), var(--panel)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--gold-bright) 30%, transparent), var(--shadow); }
  .home-morelink { margin-top: 1.1rem; font-size: .85rem; }
  .home-morelink a { box-shadow: inset 0 -1px 0 var(--line-strong); }
  .home-morelink a:hover { color: var(--terra-ink); box-shadow: inset 0 -1px 0 var(--terra); }

  /* ---- next-trip band — clubhouse green finale ---- */
  .band { background: var(--green-900); color: var(--green-ink); border-radius: var(--r-lg); margin: 0 var(--gutter) clamp(1rem,3vw,2rem); position: relative; overflow: hidden; }
  .band .wrap { padding-inline: clamp(1.4rem, 4vw, 3rem); }
  .band .eyebrow { color: var(--gold-line); }
  .band .home-tag { color: var(--gold-line); }
  .band .muted { color: color-mix(in srgb, var(--green-ink) 82%, transparent); }
  .band .pill { background: color-mix(in srgb, var(--green-ink) 14%, transparent); color: var(--green-ink); box-shadow: none; }
  .next-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(1.4rem, 5vw, 3rem); align-items: center; }
  .next-dest { font-family: var(--serif); font-weight: 600; font-size: clamp(1.8rem, 1.2rem + 3vw, 3rem); line-height: 1.02; letter-spacing: -.01em; margin-top: .4rem; color: var(--green-ink); }
  .next-dates { font-weight: 700; font-size: clamp(1.05rem, .9rem + .8vw, 1.4rem); color: var(--gold-line); margin-top: .3rem; }
  .flyer { position: relative; display: block; flex: none; border-radius: var(--r); overflow: hidden; box-shadow: 0 20px 50px -18px rgba(0,0,0,.55); transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
  .flyer img { display: block; width: clamp(220px, 34vw, 320px); height: auto; }
  .flyer:hover { transform: translateY(-3px) rotate(-.5deg); box-shadow: 0 28px 60px -18px rgba(0,0,0,.6); }
  .flyer__cue { position: absolute; top: .5rem; right: .5rem; padding: .3rem .6rem; font-size: .68rem; font-weight: 700; letter-spacing: .03em; color: #fff; background: rgba(12,24,18,.7); border-radius: 999px; backdrop-filter: blur(2px); }

  .lightbox { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 4vmin; background: rgba(12,20,16,.9); backdrop-filter: blur(4px); cursor: zoom-out; }
  .lightbox[hidden] { display: none; }
  .lightbox img { max-width: 100%; max-height: 92vh; border-radius: var(--r-sm); box-shadow: 0 30px 80px -20px #000; }

  @media (max-width: 620px) {
    .tiles-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .hero__board { margin-inline: 0; }
    .champ-grid { grid-template-columns: 1fr; }
    .next-grid { grid-template-columns: 1fr; }
    .flyer { justify-self: center; }
    .flyer img { width: min(78vw, 320px); }
  }
</style>

<script is:inline>
  (() => {
    const link = document.querySelector('.flyer');
    const box = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    if (!link || !box) return;
    const open = (e) => {
      e.preventDefault();
      img.src = link.getAttribute('href');
      img.alt = link.querySelector('img')?.alt || '';
      box.hidden = false; box.setAttribute('aria-hidden', 'false');
    };
    const close = () => { box.hidden = true; box.setAttribute('aria-hidden', 'true'); img.src = ''; };
    link.addEventListener('click', open);
    box.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !box.hidden) close(); });
  })();
</script>
