---
import Base from '../../layouts/Base.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import TeamLogo from '../../components/TeamLogo.astro';
import { playersComparison, allRookies, powerRankings, careerStats } from '../../lib/stats.js';
import { num, pctText } from '../../lib/format.js';
import { tournamentById, teamById } from '../../lib/data.js';

const rows = playersComparison();
const rookies = allRookies();
const prRows = powerRankings().rows;
const prFor = (id) => prRows.find((r) => r.player.id === id) || null;

// Each card carries one number that is settled and one that moves: a career
// figure, then the live power ranking. Raw career points deliberately aren't
// used — the points available change with every edition's format mix, so the
// total isn't comparable across years the way a win rate is.
// A player with no GHIN check-in has no rank (or no ranking row at all), which
// reads as "—" rather than a number that would be a guess.
const powerStat = (id) => {
  const rank = prFor(id)?.rank ?? null;
  return { k: 'Power', v: rank == null ? '—' : `#${rank}`, tone: 'live' };
};

// The wall: everyone who has played, ordered by career points (same order the
// table opens in), then the rookies confirmed for the next Annual.
const veteranCards = rows.map((r) => {
  const c = careerStats(r.player.id);
  const title = c.appearances.find((a) => a.isChampion);
  return {
    player: r.player,
    teamId: r.teamId,
    teamName: teamById[r.teamId]?.name ?? null,
    handicap: r.handicap,
    isChampion: Boolean(title),
    championYear: title?.tournament.year ?? null,
    stats: [
      { k: 'Win rate', v: pctText(r.matchPct) },
      powerStat(r.player.id),
    ],
  };
});

// A rookie has no career number yet, so their handicap index stands in for it.
const rookieCards = rookies.map((p) => {
  const pr = prFor(p.id);
  const year = tournamentById[(p.confirmedFor || [])[0]]?.year ?? null;
  return {
    player: p,
    isRookie: true,
    rookieYear: year,
    stats: [
      { k: 'Index', v: pr?.hasData ? String(pr.index) : '—' },
      powerStat(p.id),
    ],
  };
});

const wall = [...veteranCards, ...rookieCards];
const rookieYear = rookieCards[0]?.rookieYear ?? null;
---
<Base active="players" title="Players" description="Every player in The Annual — the full field, with career points, win % and the full scouting report behind each face.">
  <section class="section" style="padding-bottom:clamp(1.6rem,4vw,2.4rem)">
    <div class="wrap">
      <p class="eyebrow gold">The Field</p>
      <h1 class="display" style="font-size:clamp(2.1rem,6vw,3.6rem);margin:.3rem 0 .4rem">Players</h1>
      <p class="lede">Everyone who has teed it up{rookieYear ? `, plus the rookies confirmed for ${rookieYear}` : ''}. Pick a face for the full scouting report — career record, format splits, head-to-heads and honours.</p>
      <div class="chips" style="margin-top:1rem">
        <a class="btn btn--navy" href="/power-rankings">Power Rankings <span aria-hidden="true">→</span></a>
      </div>

      <div class="wall" style="margin-top:clamp(1.4rem,4vw,2rem)">
        {wall.map((c, i) => <PlayerCard {...c} loading={i < 6 ? 'eager' : 'lazy'} />)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow gold">Side by side</p><h2>Career comparison</h2></div>
        <span class="faint">Tap a column to sort</span>
      </div>
      <div class="table-scroll">
        <table class="data sortable" id="ptable">
          <thead>
            <tr>
              <th data-k="name" data-type="txt">Player</th>
              <th>Team</th>
              <th class="num" data-k="played" data-type="n">P</th>
              <th data-k="record" data-type="rec">W–H–L</th>
              <th class="num sort-active" data-k="pointsEarned" data-type="n" data-dir="desc">Pts</th>
              <th class="num" data-k="pointPct" data-type="n">Pt %</th>
              <th class="num" data-k="matchPct" data-type="n">Win %</th>
              <th class="num" data-k="handicap" data-type="n">Hcp</th>
              <th class="num" data-k="draft" data-type="n">Draft</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr
                data-name={r.player.name}
                data-played={r.played}
                data-record={r.w * 100 + r.h}
                data-pointsearned={r.pointsEarned}
                data-pointpct={r.pointPct}
                data-matchpct={r.matchPct}
                data-handicap={r.handicap}
                data-draft={r.draftPick ?? 99}
              >
                <td class="name"><a href={`/players/${r.player.slug}`}>{r.player.name}</a></td>
                <td><TeamLogo teamId={r.teamId} size={20} /></td>
                <td class="num tabnums">{r.played}</td>
                <td class="num tabnums">{r.w}–{r.h}–{r.l}</td>
                <td class="num tabnums gold">{num(r.pointsEarned)}</td>
                <td class="num tabnums">{pctText(r.pointPct)}</td>
                <td class="num tabnums">{pctText(r.matchPct)}</td>
                <td class="num tabnums">{r.handicap.toFixed(1)}</td>
                <td class="num tabnums">{r.isCaptain ? 'C' : `#${r.draftPick}`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="faint" style="font-size:.78rem;margin-top:.7rem">Pts = tournament points earned (Scramble &amp; Shamble worth 1; Best Ball, Stableford &amp; Singles worth 2). Pt % = points ÷ available. Win % = wins + ½ halves ÷ matches. “C” = team captain (undrafted). Rookies are absent from this table until they play.</p>
    </div>
  </section>
</Base>

<style>
  /* The wall of faces. Two up on a phone — the portrait stays the hero at every
     width; the tiles just get narrower. */
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: clamp(0.7rem, 2vw, 1.15rem);
  }
  @media (max-width: 720px) {
    .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  table.sortable thead th[data-k] { cursor: pointer; user-select: none; white-space: nowrap; }
  table.sortable thead th[data-k]:hover { color: var(--text); }
  table.sortable thead th.sort-active { color: var(--text); }
  table.sortable thead th.sort-active::after { content: attr(data-arrow); margin-left: .3rem; color: var(--gold); }
</style>

<script is:inline>
  (() => {
    const table = document.getElementById('ptable');
    if (!table) return;
    const tbody = table.querySelector('tbody');
    const heads = [...table.querySelectorAll('th[data-k]')];
    function sortBy(th) {
      const k = th.dataset.k, type = th.dataset.type;
      let dir = th.dataset.dir === 'desc' ? 'asc' : 'desc';
      heads.forEach((h) => { h.classList.remove('sort-active'); h.removeAttribute('data-arrow'); delete h.dataset.dir; });
      th.classList.add('sort-active'); th.dataset.dir = dir; th.setAttribute('data-arrow', dir === 'desc' ? '▾' : '▴');
      const rows = [...tbody.querySelectorAll('tr')];
      const val = (tr) => {
        if (k === 'name') return tr.dataset.name.toLowerCase();
        return parseFloat(tr.dataset[k.toLowerCase()]);
      };
      rows.sort((a, b) => {
        const av = val(a), bv = val(b);
        let c = type === 'txt' ? String(av).localeCompare(String(bv)) : av - bv;
        return dir === 'desc' ? -c : c;
      });
      rows.forEach((r) => tbody.appendChild(r));
    }
    heads.forEach((th) => th.addEventListener('click', () => sortBy(th)));
    const init = table.querySelector('th.sort-active');
    if (init) { delete init.dataset.dir; sortBy(init); }
  })();
</script>
