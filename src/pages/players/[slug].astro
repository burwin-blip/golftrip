---
import Base from '../../layouts/Base.astro';
import TeamLogo from '../../components/TeamLogo.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import PlayerPortrait from '../../components/PlayerPortrait.astro';
import { players, teamById, playerById, roundById, getCourse, tournamentById, moments } from '../../lib/data.js';
import {
  careerStats, formatRecords, opponentRecords,
  handicapAnalysis, draftValue, scorecardIndex, ANALYTICS_CAVEAT,
  playerHoleStats, HOLE_STATS_COVERAGE, powerRankings, photosForPlayer,
} from '../../lib/stats.js';
import { fullName, num, pctText } from '../../lib/format.js';

export function getStaticPaths() {
  return players.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const c = careerStats(p.id);
const bright = { woodpeckers: 'var(--wp-bright)', 'silver-spoons': 'var(--ss-bright)' };
const myPhotos = photosForPlayer(p.id);

// A "rookie" is confirmed for an upcoming event but has no completed record yet.
const isProspect = c.appearances.length === 0;
const confirmedFor = p.confirmedFor || [];
const rookieTid = confirmedFor[0] || null;
const rookieYear = rookieTid ? tournamentById[rookieTid]?.year : null;

// This player's live power-ranking row (works for veterans and rookies alike).
const prRow = powerRankings().rows.find((r) => r.player.id === p.id) || null;

// Subtle handicap line: system (+ GHIN number when known) + home club when known.
const homeClub = prRow?.homeClub ?? null;
const hcLabel = (p.system === 'ga' || p.ghin || homeClub)
  ? ((p.system === 'ga' ? 'GA handicap' : (p.ghin ? `GHIN #${p.ghin}` : 'GHIN')) + (homeClub ? ` · ${homeClub}` : ''))
  : null;

let app, team, accentBright, fr, opps, t, history, cur, myScores, myMoments, hs;
if (!isProspect) {
  app = c.appearances[c.appearances.length - 1];
  team = teamById[app.teamId];
  accentBright = bright[team.id];
  fr = formatRecords(p.id);
  opps = opponentRecords(p.id);
  t = tournamentById[app.tournament.id];
  history = c.appearances.map((ap) => {
    const ha = handicapAnalysis(ap.tournament.id).rows.find((r) => r.playerId === p.id);
    const dv = draftValue(ap.tournament.id).find((r) => r.playerId === p.id);
    const si = scorecardIndex(ap.tournament.id).byId[p.id];
    return { ap, ha, dv, si };
  });
  cur = history[history.length - 1];
  myScores = (t.scores || []).filter((s) => s.playerId === p.id)
    .sort((a, b) => roundById[a.roundId].number - roundById[b.roundId].number);
  myMoments = moments.filter((m) => (m.subjectPlayerIds || []).includes(p.id));
  hs = playerHoleStats(p.id);
}
const signed = (x) => (x <= 0 ? String(x) : `+${x}`);

// Team history for the card header — every side this player has worn, oldest
// first. One line per appearance, so it grows on its own as editions are added.
const teamHistory = isProspect
  ? []
  : c.appearances.map((ap) => ({
      teamId: ap.teamId,
      name: teamById[ap.teamId].name,
      year: ap.tournament.year,
      captain: ap.draftPick == null,
    }));

const FMT_SHORT = { 'Scramble': 'Scramble', 'Best Ball Match Play (NET)': 'Best Ball', '9-hole Shamble': 'Shamble',
  'Team Average Stableford': 'Stableford', 'Singles Match Play': 'Singles', 'Individual Championship / Singles': 'Championship' };
---
<Base active="players" title={p.name} description={isProspect ? `${p.name} — draft prospect for the upcoming season.` : `Scouting report for ${p.name} — career record, format splits, partners, head-to-heads, handicap and draft value.`}>

  {isProspect && (<Fragment>
    <section class="section" style="--accent:var(--navy-ink);--accent-bright:var(--gold-bright)">
      <div class="wrap">
        <a class="back-link" href="/players">← All players</a>

        <div class="tcard reveal">
          <div class="tcard__bar">
            <span class="tcard__seal" aria-hidden="true">A</span>
            <span class="tcard__barteam">The Annual</span>
            {rookieYear && <span class="tcard__barmeta">Confirmed for {rookieYear}</span>}
          </div>

          <div class="tcard__photo">
            <PlayerPortrait player={p} loading="eager" sizes="(max-width: 780px) 42vw, 264px" />
            <span class="tcard__flag">★ Rookie</span>
          </div>

          <div class="tcard__id">
            <h1 class="tcard__name">{p.name}</h1>
            {p.nickname && <p class="tcard__nick">“{p.nickname}”</p>}
            <p class="tcard__history tcard__history--none">
              No editions played{rookieYear ? ` — first tee shot comes in ${rookieYear}` : ''}
            </p>
            <div class="chips" style="margin-top:.75rem">
              {prRow?.hasData && <span class="pill">Index {prRow.index}</span>}
              {prRow?.hasData && prRow.rank && <a class="pill gold" href="/power-rankings" style="text-decoration:none">Power #{prRow.rank}</a>}
            </div>
            {hcLabel && <p class="ghin-line">{hcLabel}</p>}
            {p.notes && <p class="muted" style="margin-top:.8rem;font-size:.9rem;max-width:52ch">{p.notes}</p>}
          </div>

          <div class="tcard__stats tcard__stats--rookie">
            <div class="tcard__stat">
              <span class="tcard__stat-k">Status</span>
              <span class="tcard__stat-v tcard__stat-v--text">First Annual awaits</span>
              <span class="tcard__stat-sub">The scouting numbers fill in after {fullName(p.id).split(' ')[0]}’s debut.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {prRow?.hasData && (
      <section class="section" style="padding-top:0">
        <div class="wrap">
          <div class="rookie-pr card card--pad">
            <div>
              <p class="eyebrow gold">Form guide</p>
              <p class="rookie-pr__verdict">{prRow.verdict}</p>
              <p class="muted" style="font-size:.85rem;margin-top:.3rem">Handicap index {prRow.index}{prRow.rounds != null ? ` · ${prRow.rounds} rounds posted` : ''}. Follow the full board on the <a href="/power-rankings" class="gold">Power Rankings</a>.</p>
            </div>
            <a class="pr-badge" href="/power-rankings"><span class="pr-badge__k">Power</span><span class="pr-badge__v">#{prRow.rank}</span></a>
          </div>
        </div>
      </section>
    )}

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="norecord card card--pad">
          <span class="norecord__ic" aria-hidden="true">🏌️</span>
          <div>
            <h2 style="font-size:1.3rem;margin-bottom:.3rem">No tournament record yet</h2>
            <p class="muted" style="max-width:60ch">Career totals, format splits, head-to-heads and honours will appear here once {fullName(p.id).split(' ')[0]} plays their first Annual{rookieYear ? ` in ${rookieYear}` : ''}. Until then, this profile carries their handicap, GHIN and live form.</p>
          </div>
        </div>
      </div>
    </section>
  </Fragment>)}

  {!isProspect && (<Fragment>

  <!-- CARD HEADER — portrait, identity and the headline numbers in one block -->
  <section class="section" style={`padding-bottom:clamp(1.2rem,3vw,1.8rem);--accent:${team.color};--accent-bright:${accentBright}`}>
    <div class="wrap">
      <a class="back-link" href="/players">← All players</a>

      <div class="tcard reveal">
        <div class="tcard__bar">
          <TeamLogo teamId={team.id} size={22} chip={true} />
          <span class="tcard__barteam">{team.name}</span>
          <span class="tcard__barmeta">Hcp {app.handicapIndex.toFixed(1)}</span>
        </div>

        <div class="tcard__photo">
          <i class="tcard__ratio" aria-hidden="true"></i>
          <PlayerPortrait player={p} loading="eager" sizes="(max-width: 780px) 42vw, 320px" />
          {app.isChampion && (
            <span class="tcard__crown" title={`Champion Golfer ${t.year}`}>
              <span class="crown" aria-hidden="true">♛</span>
              <span class="sr-only">Champion Golfer {t.year}</span>
            </span>
          )}
        </div>

        <div class="tcard__id">
          <h1 class="tcard__name">{p.name}</h1>
          {p.nickname && <p class="tcard__nick">“{p.nickname}”</p>}
          <ul class="tcard__history">
            {teamHistory.map((h) => (
              <li>
                <TeamLogo teamId={h.teamId} size={15} />
                <span>{h.name}</span>
                <span class="faint tabnums">{h.year}</span>
                {h.captain && <span class="tcard__cap">Captain</span>}
              </li>
            ))}
          </ul>
          <div class="chips" style="margin-top:.75rem">
            {app.isChampion && <span class="pill gold">♛ Champion Golfer {t.year}</span>}
            {app.wonTeamTitle && <span class="pill gold">Team Champion {t.year}</span>}
            {cur.ha && <span class="pill">{cur.ha.tier} handicap</span>}
            {app.draftPick && <span class="pill">Draft #{app.draftPick}</span>}
            {cur.dv?.label && <span class:list={["pill", { gold: cur.dv.label !== 'Draft Miss' }]}>{cur.dv.label}</span>}
            {prRow?.hasData && prRow.rank && <a class="pill" href="/power-rankings" style="text-decoration:none">Power #{prRow.rank}</a>}
          </div>
          {hcLabel && <p class="ghin-line">{hcLabel}</p>}
        </div>

        <div class="tcard__stats">
          <div class="tcard__stat">
            <span class="tcard__stat-k">Career record</span>
            <span class="tcard__stat-v tcard__stat-v--rec"><b>{c.w}</b><i>–</i><b>{c.h}</b><i>–</i><b>{c.l}</b></span>
            <span class="tcard__stat-sub">won · halved · lost, over {c.played} matches</span>
            <div class="form" style="margin-top:.5rem">
              {c.log.map((e) => <b class={e.outcome === 'win' ? 'w' : e.outcome === 'loss' ? 'l' : 'h'} title={`Match ${e.match.number}: ${e.outcome}`}>{e.outcome === 'win' ? 'W' : e.outcome === 'loss' ? 'L' : 'H'}</b>)}
            </div>
          </div>
          <div class="tcard__stat is-lead">
            <span class="tcard__stat-k">Points earned</span>
            <span class="tcard__stat-v">{num(c.pointsEarned)}<i> / {num(c.pointsAvailable)}</i></span>
            <span class="tcard__stat-sub">{pctText(c.pointPct)} of available</span>
          </div>
          <div class="tcard__stat">
            <span class="tcard__stat-k">Win rate</span>
            <span class="tcard__stat-v">{pctText(c.matchPct)}</span>
            <span class="tcard__stat-sub">wins + ½ halves ÷ matches</span>
          </div>
          <div class="tcard__stat">
            <span class="tcard__stat-k">Titles</span>
            <span class="tcard__stat-v">{c.teamTitles + c.individualTitles}</span>
            <span class="tcard__stat-sub">{c.individualTitles} individual · {c.teamTitles} team</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCOUTING: format record + handicap/draft -->
  <section class="section" style="padding-top:0">
    <div class="wrap two-col">
      <div>
        <div class="section-head"><div><p class="eyebrow">Splits</p><h2>Format record</h2></div></div>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th>Format</th><th class="num">P</th><th class="num">W–H–L</th><th class="num">Pts</th><th class="num">Pt %</th></tr></thead>
            <tbody>
              {fr.map((f) => (
                <tr><td class="name">{FMT_SHORT[f.format] || f.format}</td><td class="num tabnums">{f.played}</td><td class="num tabnums">{f.w}–{f.h}–{f.l}</td><td class="num tabnums">{num(f.earned)}</td><td class="num tabnums">{pctText(f.pointPct)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div>
        <div class="section-head"><div><p class="eyebrow">Draft &amp; Handicap</p><h2>Value &amp; history</h2></div></div>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th>Year</th><th class="num">Hcp</th><th class="num">Pick</th><th class="num">Over/Under</th><th class="num">Composite</th><th>Value</th></tr></thead>
            <tbody>
              {history.map((h) => (
                <tr>
                  <td class="name">{h.ap.tournament.year}</td>
                  <td class="num tabnums">{h.ap.handicapIndex.toFixed(1)}</td>
                  <td class="num tabnums">{h.ap.draftPick ? `#${h.ap.draftPick}` : 'C'}</td>
                  <td class="num tabnums" style={h.ha && `color:${h.ha.overPoints >= 0 ? 'var(--wp)' : '#b4453a'};font-weight:600`}>{h.ha ? `${h.ha.overPoints > 0 ? '+' : ''}${num(Math.round(h.ha.overPoints * 10) / 10)}` : '—'}</td>
                  <td class="num tabnums">{h.dv ? num(h.dv.composite) : '—'}</td>
                  <td>{h.dv?.label ? <span class:list={["pill", { gold: h.dv.label !== 'Draft Miss' }]}>{h.dv.label}</span> : (h.ap.draftPick ? <span class="faint">—</span> : <span class="pill">Captain</span>)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="caveat">⚠ {ANALYTICS_CAVEAT}</p>
      </div>
    </div>
  </section>

  <!-- HEAD TO HEAD -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Rivalries</p><h2>Head-to-head</h2></div><span class="faint">vs everyone faced</span></div>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th>Opponent</th><th class="num">Meetings</th><th class="num">W–H–L</th><th class="num">Points</th></tr></thead>
          <tbody>
            {opps.map((o) => (
              <tr>
                <td class="name"><a href={`/players/${o.opponent.slug}`}>{o.opponent.name}</a></td>
                <td class="num tabnums">{o.played}</td>
                <td class="num tabnums">{o.aWins}–{o.halved}–{o.bWins}</td>
                <td class="num tabnums">{num(o.aPoints)}–{num(o.bPoints)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SCORES -->
  {myScores.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">Cards</p><h2>Recorded scores</h2></div><span class="faint">{t.shortName}</span></div>
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th>Round</th><th>Course</th><th class="num">Net</th><th class="num">Stbl</th><th>Note</th></tr></thead>
            <tbody>
              {myScores.map((s) => {
                const rnd = roundById[s.roundId];
                return (
                  <tr>
                    <td class="name">R{rnd.number} · {rnd.holes}h</td>
                    <td>{getCourse(rnd.courseId).name}</td>
                    <td class="num tabnums">{s.net ?? '—'}</td>
                    <td class="num tabnums">{s.stableford ?? '—'}</td>
                    <td class="faint" style="white-space:normal;font-size:.8rem">{s.note || ''}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- HOLE-BY-HOLE (NET) -->
  {hs && hs.hasHoleData && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">Hole by hole</p><h2>Net scoring</h2></div><span class="faint">{hs.holesPlayed} holes recorded</span></div>
        <div class="holebar" style={`--accent:${accentBright}`}>
          <div class="holebar__cell hb-eagle"><span class="holebar__n">{hs.eagle}</span><span class="holebar__l">Eagles+</span></div>
          <div class="holebar__cell hb-birdie"><span class="holebar__n">{hs.birdie}</span><span class="holebar__l">Birdies</span></div>
          <div class="holebar__cell"><span class="holebar__n">{hs.par}</span><span class="holebar__l">Pars</span></div>
          <div class="holebar__cell"><span class="holebar__n">{hs.bogey}</span><span class="holebar__l">Bogeys</span></div>
          <div class="holebar__cell"><span class="holebar__n">{hs.double}</span><span class="holebar__l">Doubles+</span></div>
        </div>
        <div class="holemeta">
          {hs.avgVsPar != null && <span><strong>{signed(Number(hs.avgVsPar.toFixed(2)))}</strong> net per hole <span class="faint">({hs.holesScored} scored)</span></span>}
          {hs.bestRound && <span><strong>{hs.bestRound.total}</strong> best net round <span class="faint">({signed(hs.bestRound.vsPar)}, R{hs.bestRound.round})</span></span>}
          {hs.longestBirdieStreak > 1 && <span><strong>{hs.longestBirdieStreak}</strong> in a row at birdie+ </span>}
          <span><strong>{hs.stablefordPoints}</strong> net Stableford pts</span>
        </div>
        <p class="faint" style="font-size:.72rem;margin-top:.7rem;line-height:1.5;max-width:70ch">{HOLE_STATS_COVERAGE}</p>
      </div>
    </section>
  )}

  <!-- AWARDS + MOMENTS -->
  <section class="section" style="padding-top:0">
    <div class="wrap two-col">
      <div>
        <div class="section-head"><div><p class="eyebrow">Recognition</p><h2>Honours</h2></div></div>
        {c.wonAwards.length ? (
          <ul class="hairline-list">
            {c.wonAwards.map((a) => (
              <li>
                <span style="font-size:1.2rem">{/champion|shot of/i.test(a.name) ? '🏆' : '🎖'}</span>
                <div style="flex:1"><div class="name">{a.name}</div>{a.notes && <div class="faint" style="font-size:.8rem">{a.notes}</div>}</div>
                <a class="pill gold" href={`/tournaments/${t.id}#awards`}>Cabinet</a>
              </li>
            ))}
          </ul>
        ) : <p class="muted">No individual awards on record — yet.</p>}
      </div>
      <div>
        <div class="section-head"><div><p class="eyebrow">Signature</p><h2>Moments</h2></div></div>
        {myMoments.length ? (
          <ul class="hairline-list">
            {myMoments.map((m) => (
              <li><div style="flex:1"><div class="name">{m.title}</div><div class="faint" style="font-size:.82rem">{m.description}</div></div></li>
            ))}
          </ul>
        ) : <p class="muted">No signature moments recorded — yet.</p>}
      </div>
    </div>
  </section>

  {myPhotos.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">The Album</p><h2>Photos</h2></div><span class="faint">{myPhotos.length} from {t.shortName}</span></div>
        <PhotoGallery photos={myPhotos} galleryId={`pp-${p.slug}`} />
      </div>
    </section>
  )}

  <!-- MATCH LOG -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">The Record</p><h2>Every match</h2></div></div>
      <div class="table-scroll">
        <table class="data">
          <thead><tr><th>#</th><th>Format</th><th>Partners</th><th>Opponents</th><th class="num">Result</th><th class="num">Pts</th></tr></thead>
          <tbody>
            {c.log.map((e) => (
              <tr>
                <td class="rank">{e.match.number}</td>
                <td>{roundById[e.match.roundId].format}</td>
                <td>{e.partners.length ? e.partners.map((id, idx) => <Fragment>{idx > 0 && ', '}<a href={`/players/${playerById[id].slug}`}>{fullName(id)}</a></Fragment>) : <span class="faint">Singles</span>}</td>
                <td>{e.opponents.map((id, idx) => <Fragment>{idx > 0 && ', '}<a href={`/players/${playerById[id].slug}`}>{fullName(id)}</a></Fragment>)}</td>
                <td class="num">
                  <span class="result-dot" style={`background:${e.outcome === 'win' ? 'var(--wp)' : e.outcome === 'halve' ? 'var(--gold-bright)' : 'var(--faint)'}`}></span>
                  <span class="tabnums" style="margin-left:.4rem">{e.outcome === 'halve' ? 'Halved' : e.match.margin}</span>
                </td>
                <td class="num tabnums">{num(e.pointsEarned)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  </Fragment>)}
</Base>

<style>
  /* ---- the trading card ---------------------------------------------------
     Same object as the tile on the Players wall, at reading size: team bar
     across the top, portrait on the left, identity and the headline numbers
     beside it. Everything else on the profile hangs below. */
  .tcard {
    display: grid;
    grid-template-columns: clamp(240px, 27vw, 320px) minmax(0, 1fr);
    grid-template-areas: "bar bar" "photo id" "photo stats";
    grid-template-rows: auto auto 1fr;
    margin-top: 1rem;
    background: var(--panel);
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .tcard__bar {
    grid-area: bar;
    display: flex; align-items: center; gap: .5rem;
    padding: .5rem clamp(.8rem, 2vw, 1.2rem);
    background: var(--accent); color: #fff;
  }
  .tcard__barteam { font-family: var(--serif); font-size: 1.02rem; font-weight: 600; }
  .tcard__barmeta {
    font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; font-weight: 700;
    margin-left: auto; font-variant-numeric: tabular-nums; opacity: .92;
  }
  .tcard__seal {
    width: 22px; height: 22px; flex: none; display: grid; place-items: center;
    border-radius: 50%; background: #fff; color: var(--navy-ink);
    font-family: var(--serif); font-size: .74rem; font-weight: 600; line-height: 1;
  }

  /* The in-flow spacer holds the cell open to 4:5 when the identity column is
     short; when that column is taller the cell stretches past it. Either way the
     portrait is absolutely filling the cell, so the photo edge always meets the
     card edge — an aspect-ratio on the cell itself would defeat the stretch. */
  .tcard__photo { grid-area: photo; position: relative; background: var(--panel-2); }
  .tcard__ratio { display: block; width: 100%; aspect-ratio: 4 / 5; }
  .tcard__photo :global(.pportrait) {
    position: absolute; inset: 0;
    width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover;
  }
  .tcard__crown {
    position: absolute; top: .6rem; right: .6rem;
    width: 1.9rem; height: 1.9rem; display: grid; place-items: center;
    border-radius: 50%; background: rgba(251,247,238,.94);
    box-shadow: 0 2px 8px -3px rgba(18,43,29,.5); font-size: 1rem; line-height: 1;
  }
  .tcard__flag {
    position: absolute; top: .6rem; left: .6rem;
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .22rem .6rem; border-radius: 999px;
